 if(NS==='ign'){c.strokeStyle='#ffe04a';c.lineWidth=5;c.globalAlpha=0.55+0.45*Math.sin(simT*6);c.beginPath();c.arc(256,750,40,0,7);c.stroke();c.globalAlpha=1;}hit(p,140,705,232,80,()=>SYS.ign=!SYS.ign);
