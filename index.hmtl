const CB='#3fb6ff',CA='#ffae1a',CG='#3dff7a',CW='#e8eef3',CR='#ff2d2d';let NS=null;
function hit(p,x,y,w,h,act){p.btns.push({x,y,w,h,act});}
function pb(c,p,id,x,y,w,h,label,top,bot,act){c.textAlign='center';c.textBaseline='alphabetic';c.fillStyle='#fff';c.font='bold 14px Arial';c.fillText(label,x+w/2,y-7);
 const g=c.createLinearGradient(0,y,0,y+h);g.addColorStop(0,'#2a3139');g.addColorStop(1,'#151a1f');c.fillStyle=g;rr(c,x,y,w,h,7);c.fill();c.strokeStyle='#07090b';c.lineWidth=3;c.stroke();
 c.strokeStyle='#3a434d';c.lineWidth=1;c.beginPath();c.moveTo(x+6,y+h/2);c.lineTo(x+w-6,y+h/2);c.stroke();c.font='bold 16px Arial';
 if(top){c.fillStyle=top[1];c.shadowColor=top[1];c.shadowBlur=12;c.fillText(top[0],x+w/2,y+h*0.36);}if(bot){c.fillStyle=bot[1];c.shadowColor=bot[1];c.shadowBlur=12;c.fillText(bot[0],x+w/2,y+h*0.84);}c.shadowBlur=0;
 if(NS===id){c.strokeStyle='#ffe04a';c.lineWidth=5;c.globalAlpha=0.55+0.45*Math.sin(simT*6);rr(c,x-4,y-4,w+8,h+8,9);c.stroke();c.globalAlpha=1;}hit(p,x,y-20,w,h+20,act);}
function section(c,x,y,w,h,t){c.strokeStyle='rgba(255,255,255,.55)';c.lineWidth=2;rr(c,x,y,w,h,6);c.stroke();c.fillStyle='#4f5b66';const tw=c.measureText(t).width;c.font='bold 13px Arial';c.fillRect(x+w/2-40,y-8,80,16);c.fillStyle='#fff';c.textAlign='center';c.fillText(t,x+w/2,y+5);}
function onoff(v){return v?['ON',CB]:['OFF',CW];}
function drawOver(c,p){NS=nextStep()[0];c.fillStyle='#4f5b66';c.fillRect(0,0,1024,740);c.fillStyle='rgba(0,0,0,.12)';for(let i=0;i<30;i++)c.fillRect(0,i*25,1024,1);
 section(c,15,20,170,165,'ELEC');pb(c,p,'bat',45,60,110,90,'BAT 1+2',null,onoff(SYS.bat),()=>SYS.bat=!SYS.bat);
