 c.strokeStyle='rgba(255,255,255,.5)';c.lineWidth=3;c.beginPath();c.arc(120,120,118,0,7);c.stroke();c.fillStyle='#fff';c.font='bold 18px sans-serif';c.textAlign='center';c.fillText('N',120,22);}

