  c.strokeStyle=e.fire?'#ff3030':e.state==='run'?'#3dff7a':e.state==='start'?'#ffb020':'#555';c.beginPath();c.arc(x,y,r,0.75*Math.PI,0.75*Math.PI+1.5*Math.PI*clamp(e.n1/104,0,1));c.stroke();
