 const hb=(x,lbl,ok)=>{c.strokeStyle=ok?'#3dff7a':'#ffae1a';c.lineWidth=2;c.strokeRect(x-40,36,80,46);c.fillStyle=ok?'#3dff7a':'#ffae1a';c.font='bold 14px sans-serif';c.fillText(lbl,x,54);c.fillText(ok?'5000':'0',x,74);};
