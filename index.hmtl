}

/* ================= COCKPIT ================= */
class CPanel{constructor(cw,ch,pw,ph,draw,rate,em){this.cv=document.createElement('canvas');this.cv.width=cw;this.cv.height=ch;this.c=this.cv.getContext('2d');this.W=cw;this.H=ch;this.pw=pw;this.ph=ph;this.em=em===undefined?0.6:em;
 this.tex=new THREE.CanvasTexture(this.cv);this.tex.encoding=THREE.sRGBEncoding;this.tex.anisotropy=maxAniso;
 this.mesh=new THREE.Mesh(new THREE.PlaneGeometry(pw,ph),new THREE.MeshStandardMaterial({map:this.tex,emissiveMap:this.tex,emissive:0xffffff,emissiveIntensity:this.em,roughness:0.75,metalness:0}));this.mesh.receiveShadow=true;this.mesh.userData.panel=this;this.draw=draw;this.btns=[];this.rate=rate;this.t=0;}
 render(){this.btns=[];this.draw(this.c,this);this.tex.needsUpdate=true;}
 click(u,v){const x=u*this.W,y=(1-v)*this.H;for(let i=this.btns.length-1;i>=0;i--){const b=this.btns[i];if(x>=b.x&&x<=b.x+b.w&&y>=b.y&&y<=b.y+b.h){initAudio();b.act(x,y,b);beep(1800,0.03,0.025);this.render();return true;}}return false;}}
const LOOKS={};
function frameGeo(w,h,holes,depth){const s=new THREE.Shape();s.moveTo(0,0);s.lineTo(w,0);s.lineTo(w,h);s.lineTo(0,h);s.lineTo(0,0);
 for(const [x,y,hw,hh,r] of holes){const p=new THREE.Path();p.moveTo(x+r,y);p.lineTo(x+hw-r,y);p.quadraticCurveTo(x+hw,y,x+hw,y+r);p.lineTo(x+hw,y+hh-r);p.quadraticCurveTo(x+hw,y+hh,x+hw-r,y+hh);p.lineTo(x+r,y+hh);p.quadraticCurveTo(x,y+hh,x,y+hh-r);p.lineTo(x,y+r);p.quadraticCurveTo(x,y,x+r,y);s.holes.push(p);}
 return new THREE.ExtrudeGeometry(s,{depth,bevelEnabled:true,bevelThickness:0.012,bevelSize:0.012,bevelSegments:2,curveSegments:8});}
function rbox(w,h,d,r){r=Math.min(r,w/2-0.001,h/2-0.001,d/2-0.001);const b=r*0.9,W=w-2*b,H=h-2*b,x=-W/2,y=-H/2,q=Math.max(0.0005,r-b);const s=new THREE.Shape();
 s.moveTo(x+q,y);s.lineTo(x+W-q,y);s.quadraticCurveTo(x+W,y,x+W,y+q);s.lineTo(x+W,y+H-q);s.quadraticCurveTo(x+W,y+H,x+W-q,y+H);s.lineTo(x+q,y+H);s.quadraticCurveTo(x,y+H,x,y+H-q);s.lineTo(x,y+q);s.quadraticCurveTo(x,y,x+q,y);
 const dd=Math.max(0.001,d-2*r);const g=new THREE.ExtrudeGeometry(s,{depth:dd,bevelEnabled:true,bevelThickness:r,bevelSize:b,bevelSegments:3,curveSegments:3});g.translate(0,0,-dd/2);g.computeVertexNormals();return g;}
function noiseMat(base,rough,scale,lines){const c=document.createElement('canvas');c.width=c.height=256;const x=c.getContext('2d');const c0=new THREE.Color(base);
 const d=x.createImageData(256,256);for(let i=0;i<256*256;i++){const v=0.93+Math.random()*0.1;d.data[i*4]=c0.r*255*v;d.data[i*4+1]=c0.g*255*v;d.data[i*4+2]=c0.b*255*v;d.data[i*4+3]=255;}x.putImageData(d,0,0);
 if(lines){x.strokeStyle='rgba(0,0,0,.25)';x.lineWidth=2;x.strokeRect(1,1,254,254);x.fillStyle='rgba(0,0,0,.3)';for(const [a,b] of [[10,10],[246,10],[10,246],[246,246]]){x.beginPath();x.arc(a,b,3,0,7);x.fill();}}
 const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(scale,scale);t.anisotropy=8;return new THREE.MeshStandardMaterial({map:t,roughness:rough,metalness:0.05});}
