 const gs=P.gearPos>0.99?['#3dff7a','▼']:P.gearPos<0.01?['#556','UP']:['#ff3b3b','UNLK'];c.font='bold 16px sans-serif';[[W*0.5,250],[W*0.3,280],[W*0.7,280]].forEach(([x,y])=>{c.strokeStyle=gs[0];c.strokeRect(x-26,y-16,52,26);c.fillStyle=gs[0];c.fillText(gs[1],x,y+3);});
