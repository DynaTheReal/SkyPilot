let mapImg;
function buildMapImg(){mapImg=document.createElement('canvas');mapImg.width=mapImg.height=320;const c=mapImg.getContext('2d'),d=c.createImageData(320,320);
 for(let y=0;y<320;y++)for(let x=0;x<320;x++){const wx=-HALF+x/320*2*HALF,wz=-HALF+y/320*2*HALF,h=groundH(wx,wz);let r,g,b;
  if(h<0.5){r=20;g=60;b=110;}else if(inCity(wx,wz)&&h>3){r=120;g=120;b=125;}else if(h>1800){r=230;g=230;b=235;}else if(h>900){r=120;g=110;b=95;}else{const f=forestAt(wx,wz);r=lerp(80,30,f);g=lerp(120,80,f);b=lerp(60,40,f);}
  const i=(y*320+x)*4;d.data[i]=r;d.data[i+1]=g;d.data[i+2]=b;d.data[i+3]=255;}c.putImageData(d,0,0);
 c.strokeStyle='#fff';c.lineWidth=3;for(const a of AIRPORTS){const s=320/(2*HALF);const p1=new V3(a.x,0,a.z).addScaledVector(a.dir,-a.len/2),p2=new V3(a.x,0,a.z).addScaledVector(a.dir,a.len/2);
  c.beginPath();c.moveTo((p1.x+HALF)*s,(p1.z+HALF)*s);c.lineTo((p2.x+HALF)*s,(p2.z+HALF)*s);c.stroke();c.fillStyle='#fff';c.font='bold 11px sans-serif';c.fillText(a.code,(a.x+HALF)*s+8,(a.z+HALF)*s-6);}}
