 c.fillStyle=SYS.ap?'#5be393':'#667';c.textAlign='center';c.fillText(SYS.ap?(SYS.appr?'AP1  LOC  G/S':'AP1 ALT '+Math.round(SYS.apAlt*FT/100)*100+' HDG '+String(Math.round(SYS.apHdg)).padStart(3,'0')):'AP OFF',150,12);
 c.textAlign='right';c.fillStyle=P.auth===0?'#ff4b4b':P.auth<1||unreliable>0?'#ffb020':'#5be393';c.fillText(P.auth===0?'NO CTL':P.auth<1?'ALTN LAW':unreliable>0?'ALTN LAW':'NORM LAW',284,12);
