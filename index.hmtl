<!DOCTYPE html>
<html lang="de"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>SkyPilot A380</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
html,body{margin:0;height:100%;overflow:hidden;background:#000;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:#e8eef5;touch-action:none}
#c{position:fixed;inset:0;width:100%;height:100%;display:block}
.glass{background:rgba(10,16,26,.72);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.13);border-radius:12px}
.btn{background:rgba(20,30,46,.82);color:#e8eef5;border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:6px 7px;font-size:11px;font-weight:700;min-width:38px;cursor:pointer;font-family:inherit}
.btn:active{transform:scale(.95)}.btn.on{background:#1d6e38;border-color:#5be393}
#top{position:fixed;top:6px;left:50%;transform:translateX(-50%);display:flex;gap:4px;z-index:20}
#hud{position:fixed;left:6px;top:6px;width:min(26vw,175px);z-index:10;border-radius:8px;pointer-events:none}
#mini{position:fixed;right:6px;top:6px;width:min(15vw,96px);z-index:10;border-radius:50%;pointer-events:none}
#warn{position:fixed;top:40px;left:50%;transform:translateX(-50%);display:flex;flex-wrap:wrap;gap:3px;justify-content:center;max-width:50vw;z-index:15}
.w{padding:2px 6px;border-radius:5px;font-weight:800;font-size:10px;letter-spacing:.4px}
.w.r{background:#c8141c;color:#fff;animation:bl .5s infinite alternate}.w.a{background:#e09000;color:#000}.w.i{background:#1d6fb8;color:#fff}
@keyframes bl{to{opacity:.5}}
#joy{position:fixed;left:12px;bottom:12px;width:124px;height:124px;border-radius:50%;z-index:12;touch-action:none}
#knob{position:absolute;left:50%;top:50%;width:48px;height:48px;margin:-24px 0 0 -24px;border-radius:50%;background:rgba(255,255,255,.3);border:2px solid rgba(255,255,255,.65);pointer-events:none}
#thr{position:fixed;right:12px;bottom:12px;width:54px;height:150px;z-index:12;overflow:hidden;touch-action:none}
#thrFill{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(#ff9d2088,#2fbf5f88);pointer-events:none}
#thrLbl{position:absolute;top:4px;width:100%;text-align:center;font-size:10px;font-weight:800;pointer-events:none}
#quick{position:fixed;bottom:8px;left:146px;right:76px;display:flex;flex-wrap:wrap;gap:3px;justify-content:center;z-index:12}
#look{position:fixed;right:74px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;z-index:12}
#look .btn{min-width:64px}
#info{position:fixed;bottom:52px;left:50%;transform:translateX(-50%);max-width:62vw;text-align:center;font-size:12.5px;font-weight:700;padding:6px 12px;z-index:11;transition:opacity .4s;pointer-events:none}
.hidden{display:none!important}
#menu{position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:radial-gradient(circle at 30% 20%,rgba(24,58,102,.85),rgba(6,11,20,.92) 70%)}
#menu h1{margin:0;font-size:30px;letter-spacing:2px}#menu h1 span{color:#58b6ff}
#menu .btn{font-size:16px;padding:12px 22px;min-width:260px}
#menu small{opacity:.65;font-size:12px;max-width:520px;text-align:center;line-height:1.4}
#result{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:35;padding:18px;width:min(420px,92vw);text-align:center}
#result h3{margin:0 0 6px;font-size:22px}#result p{margin:4px 0;font-size:13.5px;opacity:.9}
#smoke{position:fixed;inset:0;pointer-events:none;z-index:5;background:radial-gradient(circle at 50% 40%,rgba(90,90,90,.55),rgba(40,40,40,.95));opacity:0}
#flash{position:fixed;inset:0;pointer-events:none;z-index:6;background:#fff;opacity:0}
#load{position:fixed;inset:0;z-index:60;background:#060b14;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700}
</style></head><body>
<div id="load">✈ Lade Welt & A380 …</div>
<canvas id="c"></canvas>
<div id="smoke"></div><div id="flash"></div>
<canvas id="hud" width="580" height="580"></canvas>
<canvas id="mini" width="240" height="240"></canvas>
<div id="top"><button class="btn" id="bMenu">☰</button><button class="btn" id="bCam">🎥 <span id="camName">Cockpit</span></button><button class="btn" id="bSound">🔊</button></div>
<div id="warn"></div>
<div id="info" class="glass" style="opacity:0"></div>
<div id="joy" class="glass"><div id="knob"></div></div>
<div id="thr" class="glass"><div id="thrFill"></div><div id="thrLbl">IDLE</div></div>
<div id="look">
 <button class="btn" data-look="front">👁 Vorne</button><button class="btn" data-look="panel">Instrumente</button><button class="btn" data-look="over">Overhead</button>
 <button class="btn" data-look="ped">Pedestal</button><button class="btn" data-look="efb">📋 Tablet</button>
</div>
<div id="quick">
 <button class="btn" data-q="gear">GEAR ⬇</button><button class="btn" data-q="flapDn">FLAP−</button><button class="btn" data-q="flapUp">FLAP+</button>
 <button class="btn" data-q="brk">BREMSE</button><button class="btn" data-q="rev">REV</button><button class="btn" data-q="splr">SPLR</button>
 <button class="btn" data-q="rudL">◀RUD</button><button class="btn" data-q="rudR">RUD▶</button><button class="btn" data-q="trimUp">TRIM▲</button><button class="btn" data-q="trimDn">TRIM▼</button>
</div>
<div id="result" class="glass hidden"></div>
<div id="menu" class="hidden">
 <h1>SKY<span>PILOT</span> A380</h1>
 <button class="btn" data-start="cold">✈ Einsteigen – Cold &amp; Dark</button>
 <button class="btn" data-start="ready">🛫 Startbereit auf der Bahn</button>
 <button class="btn" data-start="app">🛬 Landeanflug</button>
 <button class="btn" data-start="gold">🌅 Start im Sonnenuntergang</button>
 <button class="btn hidden" id="resumeBtn">▶ Weiterfliegen</button>
 <small>Ausfälle, Szenarien, Wetter &amp; Admin findest du im Cockpit auf dem <b>Tablet</b> links neben dir (Knopf „📋 Tablet“). Schalter direkt im Cockpit antippen. Joystick links (ziehen = Nase hoch), Schubhebel rechts. Tastatur: W/S Nase, A/D rollen, Q/E Seitenruder, Shift/Strg Schub, G Fahrwerk, F/V Klappen, C Kamera.</small>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
'use strict';
const $=id=>document.getElementById(id);
const V3=THREE.Vector3,QT=THREE.Quaternion;
const clamp=(v,a,b)=>v<a?a:v>b?b:v,lerp=(a,b,t)=>a+(b-a)*t;
function smooth(e0,e1,x){let t=clamp((x-e0)/(e1-e0),0,1);return t*t*(3-2*t);}
const DEG=Math.PI/180,KT=1.94384,FT=3.28084;
const col=h=>new THREE.Color(h).convertSRGBToLinear();
const MOBILE=matchMedia('(pointer:coarse)').matches;
function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function rr(c,x,y,w,h,r){c.beginPath();c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath();}

/* ================= TERRAIN DATA ================= */
function hash2(x,z){let h=Math.sin(x*127.1+z*311.7)*43758.5453123;return h-Math.floor(h);}
function vnoise(x,z){const xi=Math.floor(x),zi=Math.floor(z),xf=x-xi,zf=z-zi,u=xf*xf*(3-2*xf),v=zf*zf*(3-2*zf);
 const a=hash2(xi,zi),b=hash2(xi+1,zi),c=hash2(xi,zi+1),d=hash2(xi+1,zi+1);return a+(b-a)*u+(c-a)*v+(a-b-c+d)*u*v;}
function fbm(x,z,o){let s=0,a=0.5,f=1,n=0;for(let i=0;i<o;i++){s+=a*vnoise(x*f,z*f);n+=a;f*=2.03;a*=0.5;}return s/n;}
const HALF=20000,NG=320,CELL=2*HALF/NG;
const AIRPORTS=[
 {name:'SkyPort International',code:'SKP',x:0,z:0,elev:12,hdg:0,len:3800,wid:60,big:true},
 {name:'Bergfeld',code:'BRG',x:-7000,z:9000,elev:450,hdg:90,len:3000,wid:45}
];
AIRPORTS.forEach(a=>{const h=a.hdg*DEG;a.dir=new V3(Math.sin(h),0,-Math.cos(h));a.perp=new V3(Math.cos(h),0,Math.sin(h));
 const n1=Math.round(a.hdg/10)||36;a.n1=String(n1).padStart(2,'0');a.n2=String((n1+17)%36+1).padStart(2,'0');});
function apLocal(a,x,z){const dx=x-a.x,dz=z-a.z;return [dx*a.dir.x+dz*a.dir.z,dx*a.perp.x+dz*a.perp.z];}
function riverZ(x){return -5200+1500*Math.sin(x/3200+0.5)+500*Math.sin(x/1100);}
function coastX(z){return 11500+1500*Math.sin(z/5000)+400*Math.sin(z/1300);}
const CITY={x0:2500,x1:8200,z0:-9500,z1:-1800,cx:5300,cz:-5600};
function inCity(x,z){return x>CITY.x0&&x<CITY.x1&&z>CITY.z0&&z<CITY.z1;}
function mountainF(x,z){return clamp(smooth(-3500,-13000,x)+0.8*smooth(-9000,-18000,z)*smooth(4000,-6000,x),0,1);}
function rawH(x,z){
 let h=25+fbm(x/6000+3.1,z/6000+7.7,5)*220-40;
 h+=Math.max(0,fbm(x/2200+1.3,z/2200+9.1,4)-0.5)*600;
 const m=mountainF(x,z);
 if(m>0){const r=1-Math.abs(fbm(x/3500+5,z/3500+2,6)*2-1);h+=m*(r*r*2600+fbm(x/1200,z/1200,4)*500);}
 const cx=coastX(z);h=lerp(h,-45,smooth(cx-2500,cx+600,x));
 const d=Math.abs(z-riverZ(x));if(x<cx+500)h=lerp(h,-7,smooth(480,170,d));
 const e=Math.max(Math.abs(x),Math.abs(z));h=lerp(h,-60,smooth(17500,19800,e));
 for(const a of AIRPORTS){const l=apLocal(a,x,z);const ext=Math.abs(l[0])-a.len/2;if(ext>0&&ext<15000){const w=500+ext*0.08;const cap=a.elev+ext*Math.tan(2.3*DEG);h=lerp(h,Math.min(h,cap),smooth(w+700,w,Math.abs(l[1])));}}
 for(const a of AIRPORTS){const l=apLocal(a,x,z);const da=Math.max(0,Math.abs(l[0])-(a.len/2+500)),dc=Math.max(0,Math.abs(l[1])-(a.wid/2+650));h=lerp(h,a.elev,smooth(1300,0,Math.hypot(da,dc)));}
 return h;
}
const N1G=NG+1;const HG=new Float32Array(N1G*N1G);
for(let iz=0;iz<=NG;iz++)for(let ix=0;ix<=NG;ix++)HG[iz*N1G+ix]=rawH(-HALF+ix*CELL,-HALF+iz*CELL);
function groundH(x,z){const gx=(x+HALF)/CELL,gz=(z+HALF)/CELL;if(gx<0||gz<0||gx>=NG||gz>=NG)return -60;
 const ix=gx|0,iz=gz|0,fx=gx-ix,fz=gz-iz;
 const h00=HG[iz*N1G+ix],h10=HG[iz*N1G+ix+1],h01=HG[(iz+1)*N1G+ix],h11=HG[(iz+1)*N1G+ix+1];
 if(fx+fz<=1)return h00+(h10-h00)*fx+(h01-h00)*fz;return h11+(h01-h11)*(1-fx)+(h10-h11)*(1-fz);}
function slopeAt(x,z){const a=groundH(x+15,z)-groundH(x-15,z),b=groundH(x,z+15)-groundH(x,z-15);return Math.hypot(a,b)/30;}
function forestF(x,z,h){if(h<8||h>1500||inCity(x,z))return 0;for(const a of AIRPORTS)if(Math.hypot(x-a.x,z-a.z)<a.len/2+1500)return 0;
 return smooth(0.55,0.62,fbm(x/1700+40,z/1700+70,4));}
const FG=new Float32Array(N1G*N1G);
for(let iz=0;iz<=NG;iz++)for(let ix=0;ix<=NG;ix++){const i=iz*N1G+ix;FG[i]=forestF(-HALF+ix*CELL,-HALF+iz*CELL,HG[i]);}
function forestAt(x,z){const gx=(x+HALF)/CELL,gz=(z+HALF)/CELL;if(gx<0||gz<0||gx>=NG||gz>=NG)return 0;const ix=gx|0,iz=gz|0,fx=gx-ix,fz=gz-iz;
 return lerp(lerp(FG[iz*N1G+ix],FG[iz*N1G+ix+1],fx),lerp(FG[(iz+1)*N1G+ix],FG[(iz+1)*N1G+ix+1],fx),fz);}

/* ================= RENDERER ================= */
const canvas=$('c');
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,powerPreference:'high-performance'});
renderer.setPixelRatio(Math.min(devicePixelRatio,MOBILE?1.5:2));
renderer.outputEncoding=THREE.sRGBEncoding;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=0.95;
renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(70,1,0.1,90000);
function resize(){renderer.setSize(innerWidth,innerHeight,false);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();}
addEventListener('resize',resize);resize();
const maxAniso=renderer.capabilities.getMaxAnisotropy();

/* ================= SKY / LIGHT ================= */
const skyU={sunDir:{value:new V3(0.45,0.62,0.35).normalize()},top:{value:col(0x2a6fd6)},hor:{value:col(0xc4dcf2)},gnd:{value:col(0xc4dcf2)},sunC:{value:new THREE.Color(1,0.93,0.8)}};
const skyFrag=`uniform vec3 sunDir,top,hor,gnd,sunC;varying vec3 vP;void main(){vec3 d=normalize(vP);float h=d.y;
vec3 c=mix(hor,top,pow(clamp(h,0.0,1.0),0.55));c=mix(c,gnd,smoothstep(0.0,-0.05,h));
float s=max(dot(d,sunDir),0.0);c+=sunC*(pow(s,1200.0)*14.0+pow(s,60.0)*0.35+pow(s,5.0)*0.18*(1.0-clamp(h*2.0,0.0,1.0)));
gl_FragColor=vec4(c,1.0);
#include <tonemapping_fragment>
#include <encodings_fragment>
}`;
const skyMat=new THREE.ShaderMaterial({uniforms:skyU,side:THREE.BackSide,depthWrite:false,vertexShader:'varying vec3 vP;void main(){vP=position;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',fragmentShader:skyFrag});
const sky=new THREE.Mesh(new THREE.SphereGeometry(60000,32,16),skyMat);sky.renderOrder=-10;scene.add(sky);
const envU={sunDir:skyU.sunDir,top:{value:new THREE.Color()},hor:{value:new THREE.Color()},gnd:{value:new THREE.Color(0.05,0.06,0.035)},sunC:{value:new THREE.Color()}};
const envMat=new THREE.ShaderMaterial({uniforms:envU,side:THREE.BackSide,depthWrite:false,vertexShader:'varying vec3 vP;void main(){vP=position;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',fragmentShader:skyFrag});
const envScene=new THREE.Scene();envScene.add(new THREE.Mesh(new THREE.SphereGeometry(100,48,24),envMat));
const pmrem=new THREE.PMREMGenerator(renderer);let envRT=null;
function updateEnvMap(){if(envRT)envRT.dispose();envRT=pmrem.fromScene(envScene,0.02,1,1000);scene.environment=envRT.texture;}
scene.fog=new THREE.Fog(0xc4dcf2,6000,40000);
const hemi=new THREE.HemisphereLight(0xcfe6ff,0x6b6a50,0.55);scene.add(hemi);
const sun=new THREE.DirectionalLight(0xfff1dc,2.6);sun.castShadow=true;sun.shadow.mapSize.set(MOBILE?1024:2048,MOBILE?1024:2048);
const sc_=sun.shadow.camera;sc_.left=-70;sc_.right=70;sc_.top=70;sc_.bottom=-70;sc_.near=10;sc_.far=900;sun.shadow.bias=-0.0006;sun.shadow.normalBias=0.04;
scene.add(sun);scene.add(sun.target);
let baseHemi=0.55;

/* ================= TERRAIN COLOR MAP ================= */
function detailTex(){const c=document.createElement('canvas');c.width=c.height=256;const x=c.getContext('2d');const d=x.createImageData(256,256);
 for(let j=0;j<256;j++)for(let i=0;i<256;i++){const v=(vnoise(i/8,j/8)*0.5+vnoise(i/3,j/3)*0.3+Math.random()*0.2);const k=(j*256+i)*4;const g=120+v*135;d.data[k]=g;d.data[k+1]=g;d.data[k+2]=g;d.data[k+3]=255;}
 x.putImageData(d,0,0);const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.anisotropy=maxAniso;return t;}
function buildColorMap(T){
 const c=document.createElement('canvas');c.width=c.height=T;const x=c.getContext('2d');const img=x.createImageData(T,T),d=img.data;const s=2*HALF/T;
 const PAL=[[168,156,98],[92,118,56],[108,132,60],[124,106,78],[150,146,80],[96,116,60],[136,130,84],[84,108,50],[100,124,58]];
 for(let py=0;py<T;py++){const wz=-HALF+(py+0.5)*s;for(let px=0;px<T;px++){const wx=-HALF+(px+0.5)*s;const k=(py*T+px)*4;
  const h=groundH(wx,wz);let r,g,b;
  if(h<0.4){const t=clamp(-h/22,0,1);r=lerp(150,14,t);g=lerp(176,52,t);b=lerp(150,80,t);}
  else{const sx=groundH(wx+s,wz)-h,sz=groundH(wx,wz+s)-h,sl=Math.hypot(sx,sz)/s;
   const n1=vnoise(wx/160,wz/160),n2=vnoise(wx/41,wz/41);
   r=80+n1*20;g=106+n1*20;b=46+n1*10;
   const f=forestAt(wx,wz)+(n2-0.5)*0.35;if(f>0.45){const t=smooth(0.45,0.6,f);const dv=0.75+0.5*hash2(Math.floor(wx/9),Math.floor(wz/9));r=lerp(r,34*dv,t);g=lerp(g,58*dv,t);b=lerp(b,30*dv,t);}
   const rock=clamp(smooth(0.38,0.75,sl)+smooth(1100,1700,h)*0.75,0,1);if(rock>0){const rv=0.8+0.4*n2;r=lerp(r,118*rv,rock);g=lerp(g,110*rv,rock);b=lerp(b,98*rv,rock);}
   const sn=smooth(1800,2100,h+n1*300)*(1-smooth(0.8,1.2,sl));if(sn>0){r=lerp(r,238,sn);g=lerp(g,242,sn);b=lerp(b,248,sn);}
   if(h<2.6&&sl<0.2){const t=smooth(2.6,0.6,h);r=lerp(r,206,t);g=lerp(g,192,t);b=lerp(b,150,t);}
   if(inCity(wx,wz)&&h>2){const gx=((wx-CITY.x0)%140+140)%140,gz=((wz-CITY.z0)%120+120)%120;
    if(gx<13||gz<13){r=72;g=72;b=74;}else{const bh=hash2(Math.floor((wx-CITY.x0)/140),Math.floor((wz-CITY.z0)/120));const v=105+bh*60;r=v;g=v*0.97;b=v*0.94;if(bh<0.15){r=70;g=100;b=55;}}}
   for(const a of AIRPORTS){const l=apLocal(a,wx,wz);if(Math.abs(l[0])<a.len/2+420&&Math.abs(l[1])<620){const gs=0.85+0.15*Math.sin(l[0]*0.05);r=96*gs;g=126*gs;b=60*gs;}}
  }
  d[k]=r;d[k+1]=g;d[k+2]=b;d[k+3]=255;}}
 x.putImageData(img,0,0);
 const P_=(wx,wz)=>[(wx+HALF)/s,(wz+HALF)/s];
 const road=(pts,w,col2)=>{x.lineCap='round';x.lineJoin='round';x.strokeStyle='#4a4b4e';x.lineWidth=w/s+1.2;x.beginPath();pts.forEach((p,i)=>{const q=P_(p[0],p[1]);i?x.lineTo(q[0],q[1]):x.moveTo(q[0],q[1]);});x.stroke();
  x.strokeStyle=col2||'#5c5d60';x.lineWidth=w/s;x.stroke();};
 const river=[];for(let wx=-16000;wx<10000;wx+=300)river.push([wx,riverZ(wx)+330]);road(river,9);
 const coast=[];for(let wz=-15000;wz<=15000;wz+=300)coast.push([coastX(wz)-900,wz]);road(coast,9);
 road([[-18000,2600],[-12000,2900],[-8000,3100],[-3000,3700],[0,3900],[4000,3600],[8000,3000],[11000,1800]],18,'#64656a');
 road([[700,600],[700,-1900],[2600,-3500],[CITY.cx,CITY.cz]],12);road([[-8000,3100],[-7700,6000],[-7000,8350]],9);road([[CITY.cx,CITY.cz],[CITY.cx+3000,-8000],[10500,-9000]],9);
 const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;t.anisotropy=maxAniso;return t;}

/* ================= SCENE BUILD ================= */
let waterMat,cityMat,cloudMat,clouds,lightPts=[],papis=[],BUILD=[];
function buildTerrain(){
 const g=new THREE.PlaneGeometry(2*HALF,2*HALF,NG,NG);g.rotateX(-Math.PI/2);const pos=g.attributes.position;const fm=new Float32Array(pos.count);
 for(let i=0;i<pos.count;i++){pos.setY(i,HG[i]);const ix=i%N1G,iz=(i/N1G)|0,x=-HALF+ix*CELL,z=-HALF+iz*CELL,h=HG[i];
  let m=smooth(3,10,h)*(1-smooth(330,430,h))*(1-smooth(0.15,0.3,slopeAt(x,z)));if(inCity(x,z))m=0;
  for(const a of AIRPORTS){const l=apLocal(a,x,z);if(Math.abs(l[0])<a.len/2+700&&Math.abs(l[1])<900)m=0;}
  fm[i]=m;}
 g.setAttribute('fmask',new THREE.BufferAttribute(fm,1));g.computeVertexNormals();
 const dt=detailTex();const mat=new THREE.MeshLambertMaterial({map:buildColorMap(MOBILE?2048:3072)});const W2=renderer.capabilities.isWebGL2;
 const GL=`float h12(vec2 p){vec3 p3=fract(vec3(p.xyx)*0.1031);p3+=dot(p3,p3.yzx+33.33);return fract((p3.x+p3.y)*p3.z);}
vec3 fpal(float h){if(h<0.14)return vec3(0.36,0.29,0.10);if(h<0.28)return vec3(0.085,0.16,0.035);if(h<0.42)return vec3(0.13,0.2,0.045);if(h<0.52)return vec3(0.18,0.125,0.065);if(h<0.58)return vec3(0.40,0.36,0.06);if(h<0.74)return vec3(0.105,0.18,0.045);if(h<0.88)return vec3(0.25,0.21,0.09);return vec3(0.075,0.13,0.035);}
vec3 terrDetail(vec3 base){vec2 p=vWP.xz;float dist=length(cameraPosition-vWP);
 float lum=dot(base,vec3(0.3,0.59,0.11));float fm=vFM*smoothstep(0.03,0.06,lum);
 if(fm>0.01){vec2 rg=floor(p/2600.0);float ang=h12(rg)*3.1416;float ca=cos(ang),sa=sin(ang);vec2 q=vec2(ca*p.x-sa*p.y,sa*p.x+ca*p.y);
  vec2 cs=vec2(250.0,185.0)*(0.75+0.6*h12(rg+7.0));vec2 c=floor(q/cs);vec2 f=fract(q/cs);float hh=h12(c);
  if(h12(c+3.1)>0.55){vec2 cs2=cs*vec2(0.5,1.0);c=floor(q/cs2);f=fract(q/cs2);hh=h12(c+11.0);cs=cs2;}
  vec3 fc=fpal(hh)*(0.86+0.28*h12(c+2.0));float rd=(h12(c+5.0)>0.5?q.x:q.y)*2.2;float rows=sin(rd)*0.5+0.5;
  ${W2?'float fw=fwidth(rd);rows=mix(rows,0.5,clamp(fw*0.7,0.0,1.0));':'rows=mix(rows,0.5,clamp(dist/600.0,0.0,1.0));'}
  fc*=0.9+0.16*rows;vec2 e=min(f,1.0-f)*cs;float ed=min(e.x,e.y);float hedge=(1.0-smoothstep(2.0,5.5,ed))*(h12(c+9.0)>0.35?0.85:0.25);
  fc=mix(fc,vec3(0.02,0.04,0.015),hedge);float track=(1.0-smoothstep(0.6,1.4,abs(e.x-18.0)))*step(0.6,h12(c+13.0))*(1.0-smoothstep(200.0,900.0,dist));fc=mix(fc,fc*0.7,track);
  base=mix(base,fc,fm);}
 float d1=texture2D(detail,p/7.0).r,d2=texture2D(detail,p/41.0).r,d3=texture2D(detail,p/290.0).r;float nearF=1.0-smoothstep(250.0,3500.0,dist);
 base*=mix(1.0,0.62+0.76*d1,nearF*0.75)*(0.8+0.4*d2)*(0.84+0.32*d3);return base;}
`;
 mat.onBeforeCompile=sh=>{sh.uniforms.detail={value:dt};
  sh.vertexShader='attribute float fmask;varying float vFM;varying vec3 vWP;\n'+sh.vertexShader.replace('#include <begin_vertex>','#include <begin_vertex>\n vFM=fmask; vWP=(modelMatrix*vec4(transformed,1.0)).xyz;');
  sh.fragmentShader='uniform sampler2D detail;varying float vFM;varying vec3 vWP;\n'+GL+sh.fragmentShader.replace('#include <map_fragment>','#include <map_fragment>\n diffuseColor.rgb=terrDetail(diffuseColor.rgb);');};
 const m=new THREE.Mesh(g,mat);m.receiveShadow=true;scene.add(m);
}
function buildWater(){
 waterMat=new THREE.ShaderMaterial({transparent:true,fog:true,uniforms:THREE.UniformsUtils.merge([THREE.UniformsLib.fog,{time:{value:0},sunDir:{value:skyU.sunDir.value},deep:{value:col(0x0b3550)},skyCol:{value:col(0xa9c9e8)},sunCol:{value:new THREE.Color(1,0.9,0.75)}}]),
  vertexShader:`varying vec3 vW;
#include <fog_pars_vertex>
void main(){vec4 w=modelMatrix*vec4(position,1.0);vW=w.xyz;vec4 mvPosition=viewMatrix*w;gl_Position=projectionMatrix*mvPosition;
#include <fog_vertex>
}`,
  fragmentShader:`uniform float time;uniform vec3 sunDir,deep,skyCol,sunCol;varying vec3 vW;
#include <fog_pars_fragment>
vec2 wv(vec2 p,vec2 d,float f,float s){float ph=dot(p,d)*f+time*s;return d*cos(ph)*f;}
void main(){vec2 p=vW.xz;float dist=length(cameraPosition-vW);float fade=clamp(1.0-dist/9000.0,0.12,1.0);vec2 g=vec2(0.0);
g+=wv(p,normalize(vec2(1.0,0.3)),0.045,1.2)*0.9;g+=wv(p,normalize(vec2(-0.4,1.0)),0.09,1.8)*0.55;g+=wv(p,normalize(vec2(0.7,-0.6)),0.2,2.6)*0.3;
g+=wv(p,normalize(vec2(-0.9,-0.2)),0.45,3.8)*0.15*fade;g+=wv(p,normalize(vec2(0.2,0.95)),1.1,5.5)*0.07*fade;g+=wv(p,normalize(vec2(0.8,0.6)),2.3,8.0)*0.035*fade;
vec3 n=normalize(vec3(-g.x*fade,1.0,-g.y*fade));vec3 v=normalize(cameraPosition-vW);float fr=0.02+0.98*pow(1.0-max(dot(n,v),0.0),5.0);
vec3 r=reflect(-v,n);float sp=pow(max(dot(r,sunDir),0.0),260.0)*5.0+pow(max(dot(r,sunDir),0.0),30.0)*0.15;
vec3 c=mix(deep,skyCol,fr)+sunCol*sp;gl_FragColor=vec4(c,0.93);
#include <tonemapping_fragment>
#include <encodings_fragment>
#include <fog_fragment>
}`});
 const w=new THREE.Mesh(new THREE.PlaneGeometry(240000,240000),waterMat);w.rotation.x=-Math.PI/2;scene.add(w);
}
function runwayTex(a){const c=document.createElement('canvas');c.width=256;c.height=4096;const x=c.getContext('2d');
 x.fillStyle='#3a3d41';x.fillRect(0,0,256,4096);for(let i=0;i<14000;i++){x.fillStyle=Math.random()<.5?'#323538':'#46494d';x.fillRect(Math.random()*256,Math.random()*4096,2,3);}
 for(let i=0;i<40;i++){x.fillStyle='rgba(20,20,20,.25)';x.fillRect(100+Math.random()*56,Math.random()*4096,8+Math.random()*6,60+Math.random()*300);}
 const sx=256/a.wid,sy=4096/a.len;x.setTransform(sx,0,0,sy,0,0);const W=a.wid,L=a.len;x.fillStyle='#f0f0f0';
 x.fillRect(1,0,0.9,L);x.fillRect(W-1.9,0,0.9,L);for(let y=120;y<L-120;y+=50)x.fillRect(W/2-0.45,y,0.9,30);
 for(const [e,s] of [[L,1],[0,-1]]){const inw=-s;const y0=e+inw*6;const nk=W>=45?8:6;
  for(let k=0;k<nk;k++){const xx=3+k*((W/2-6)/nk);x.fillRect(xx,Math.min(y0,y0+inw*30),1.8,30);x.fillRect(W-xx-1.8,Math.min(y0,y0+inw*30),1.8,30);}
  for(let dd=150;dd<=900;dd+=150){if(dd===300)continue;const yy=e+inw*dd;const n=dd<=300?3:dd<=600?2:1;for(let k=0;k<n;k++){x.fillRect(W/2-6-k*2.6,Math.min(yy,yy+inw*22.5),1.8,22.5);x.fillRect(W/2+4.2+k*2.6,Math.min(yy,yy+inw*22.5),1.8,22.5);}}
  const ya=e+inw*300;x.fillRect(W/2-10,Math.min(ya,ya+inw*45),5,45);x.fillRect(W/2+5,Math.min(ya,ya+inw*45),5,45);
  x.save();x.translate(W/2,e+inw*55);if(s<0)x.rotate(Math.PI);x.font='bold 18px Arial';x.textAlign='center';x.textBaseline='middle';x.fillText(s>0?a.n1:a.n2,0,0);x.restore();}
 const t=new THREE.CanvasTexture(c);t.anisotropy=maxAniso;t.encoding=THREE.sRGBEncoding;return t;}
function buildAirport(a){
 const g=new THREE.Group();g.position.set(a.x,a.elev,a.z);g.rotation.y=-a.hdg*DEG;scene.add(g);
 const rw=new THREE.Mesh(new THREE.PlaneGeometry(a.wid,a.len),new THREE.MeshLambertMaterial({map:runwayTex(a),polygonOffset:true,polygonOffsetFactor:-4}));rw.rotation.x=-Math.PI/2;rw.position.y=0.15;rw.receiveShadow=true;g.add(rw);
 const asph=new THREE.MeshLambertMaterial({color:col(0x56595d),polygonOffset:true,polygonOffsetFactor:-2});
 const addPlane=(w,l,x,z)=>{const m=new THREE.Mesh(new THREE.PlaneGeometry(w,l),asph);m.rotation.x=-Math.PI/2;m.position.set(x,0.1,z);m.receiveShadow=true;g.add(m);};
 const tx=a.wid/2+140;addPlane(25,a.len,tx,0);for(const z of [-a.len/2+40,-a.len/4,0,a.len/4,a.len/2-40])addPlane(tx-a.wid/2+12,25,(tx+a.wid/2)/2,z);
 addPlane(260,a.big?800:360,tx+150,0);
 const bm=new THREE.MeshStandardMaterial({color:col(0xd8dde3),roughness:0.6,metalness:0.1}),gl=new THREE.MeshStandardMaterial({color:col(0x284a63),roughness:0.15,metalness:0.6});
 const box=(w,h,d,x,y,z,m)=>{const b=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);b.position.set(x,y,z);b.castShadow=true;b.receiveShadow=true;g.add(b);return b;};
 box(70,a.big?20:10,a.big?640:220,tx+320,a.big?10:5,0,bm);box(71,6,a.big?630:210,tx+320,a.big?11:5.5,0,gl);
 if(a.big)for(let i=-2;i<=2;i++){box(40,4,4,tx+270,6,i*120,bm);}
 const tw=new THREE.Mesh(new THREE.CylinderGeometry(4,6,a.big?48:24,12),bm);tw.position.set(tx+270,a.big?24:12,a.big?-460:-170);tw.castShadow=true;g.add(tw);
 const cab=new THREE.Mesh(new THREE.CylinderGeometry(9,7,7,12),gl);cab.position.set(tx+270,a.big?51:27,a.big?-460:-170);g.add(cab);
 a.tower=new V3(tx+270,a.big?53:29,a.big?-460:-170).applyAxisAngle(new V3(0,1,0),-a.hdg*DEG).add(new V3(a.x,a.elev,a.z));
 for(let i=0;i<(a.big?4:2);i++)box(70,24,80,tx+330,12,(a.big?440:170)+i*95,new THREE.MeshStandardMaterial({color:col(0x9ba4ae),roughness:0.7}));
 const pts=[],cols=[];const add=(x,z,r,gg,b)=>{pts.push(x,0.6,z);cols.push(r,gg,b);};
 for(let z=-a.len/2;z<=a.len/2;z+=60){add(-a.wid/2-1,z,1,1,.9);add(a.wid/2+1,z,1,1,.9);}
 for(let x=-a.wid/2;x<=a.wid/2;x+=4){add(x,a.len/2+1,0.2,1,0.3);add(x,-a.len/2-1,0.2,1,0.3);}
 for(const s of [1,-1]){for(let dd=30;dd<=900;dd+=30)for(let k=-2;k<=2;k++)add(k*1.5,s*(a.len/2+dd),1,1,1);for(let x=-15;x<=15;x+=1.5)add(x,s*(a.len/2+300),1,1,1);}
 for(let z=-a.len/2+30;z<a.len/2;z+=15)add(0,z,0.6,1,0.6);
 const pg=new THREE.BufferGeometry();pg.setAttribute('position',new THREE.Float32BufferAttribute(pts,3));pg.setAttribute('color',new THREE.Float32BufferAttribute(cols,3));
 const pm=new THREE.Points(pg,new THREE.PointsMaterial({size:3.5,sizeAttenuation:false,vertexColors:true,fog:false,toneMapped:false}));g.add(pm);lightPts.push(pm);
 for(const s of [1,-1]){const arr=[];for(let i=0;i<4;i++){const m=new THREE.Mesh(new THREE.BoxGeometry(2,1.2,1),new THREE.MeshBasicMaterial({color:0xffffff,fog:false,toneMapped:false}));
  m.position.set(s*(-a.wid/2-12-i*9),0.8,s*(a.len/2-300));g.add(m);arr.push(m);}
  papis.push({lights:arr,pos:new V3(s*(-a.wid/2-12),0.8,s*(a.len/2-300)).applyAxisAngle(new V3(0,1,0),-a.hdg*DEG).add(new V3(a.x,a.elev,a.z))});}
}
function facadeTex(emis){const c=document.createElement('canvas');c.width=64;c.height=128;const x=c.getContext('2d');x.fillStyle=emis?'#000':'#c9ccd0';x.fillRect(0,0,64,128);
 for(let j=0;j<12;j++)for(let i=0;i<5;i++){x.fillStyle=emis?(Math.random()<0.45?'#ffcf7a':'#000'):(Math.random()<0.5?'#3a4a5a':'#56697c');x.fillRect(4+i*12,4+j*10,8,6);}
 const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;return t;}
function buildCity(){const R=rng(7);const N=1400;const geo=new THREE.BoxGeometry(1,1,1);geo.translate(0,0.5,0);
 cityMat=new THREE.MeshLambertMaterial({color:0xffffff,map:facadeTex(false),emissiveMap:facadeTex(true),emissive:0xffffff,emissiveIntensity:0});
 const im=new THREE.InstancedMesh(geo,cityMat,N);const m=new THREE.Matrix4(),c=new THREE.Color();let n=0;
 for(let t=0;t<9000&&n<N;t++){const x=CITY.x0+R()*(CITY.x1-CITY.x0),z=CITY.z0+R()*(CITY.z1-CITY.z0),h=groundH(x,z);
  if(h<3||Math.abs(z-riverZ(x))<520)continue;const d=Math.hypot(x-CITY.cx,z-CITY.cz);
  const hh=(12+R()*30)*(1+5*Math.exp(-d*d/(1300*1300)))*(R()<0.08?1.8:1),w=14+R()*30,l=14+R()*30;
  m.compose(new V3(x,h-2,z),new QT(),new V3(w,hh+2,l));im.setMatrixAt(n,m);const v=0.6+R()*0.4;c.setRGB(v,v*(0.95+R()*0.08),v*(0.94+R()*0.1)).convertSRGBToLinear();im.setColorAt(n,c);
  BUILD.push({x,z,r:Math.max(w,l)*0.7,top:h+hh});n++;}
 im.count=n;im.castShadow=true;im.receiveShadow=true;im.frustumCulled=false;scene.add(im);
 for(const bx of [3800,6600]){const bz=riverZ(bx);const br=new THREE.Mesh(new THREE.BoxGeometry(22,3,1100),new THREE.MeshLambertMaterial({color:col(0x8a8f96)}));br.position.set(bx,14,bz);scene.add(br);BUILD.push({x:bx,z:bz,r:40,top:18,bridge:true});}
}
function mergeGeo(list){let n=0;const arr=list.map(g=>{const ng=g.index?g.toNonIndexed():g;n+=ng.attributes.position.count;return ng;});
 const pos=new Float32Array(n*3),nor=new Float32Array(n*3),cl=new Float32Array(n*3);let o=0;
 for(const g of arr){pos.set(g.attributes.position.array,o*3);nor.set(g.attributes.normal.array,o*3);const cc=g.userData.c||[1,1,1];for(let i=0;i<g.attributes.position.count;i++){const y=g.attributes.position.getY(i);const sh=g.userData.trunk?1:0.55+0.45*clamp((y-0.3)/0.7,0,1);cl.set([cc[0]*sh,cc[1]*sh,cc[2]*sh],(o+i)*3);}o+=g.attributes.position.count;}
 const r=new THREE.BufferGeometry();r.setAttribute('position',new THREE.BufferAttribute(pos,3));r.setAttribute('normal',new THREE.BufferAttribute(nor,3));r.setAttribute('color',new THREE.BufferAttribute(cl,3));return r;}
function lumpy(geo,amt,seed){const R=rng(seed);const p=geo.attributes.position;const map={};for(let i=0;i<p.count;i++){const k=p.getX(i).toFixed(3)+','+p.getY(i).toFixed(3)+','+p.getZ(i).toFixed(3);if(!(k in map))map[k]=1+(R()-0.5)*amt;const s=map[k];p.setXYZ(i,p.getX(i)*s,p.getY(i)*s,p.getZ(i)*s);}geo.computeVertexNormals();return geo;}
function buildTrees(){const R=rng(3);
 const trunk=()=>{const t=new THREE.CylinderGeometry(0.03,0.05,0.5,6).translate(0,0.25,0);t.userData={trunk:true,c:[0.45,0.32,0.2]};return t;};
 const blob=(r,x,y,z,sd)=>{const g=lumpy(new THREE.IcosahedronGeometry(r,1),0.38,sd);g.scale(1,1.05,1);g.translate(x,y,z);g.userData={c:[1,1,1]};return g;};
 const dec=mergeGeo([trunk(),blob(0.32,0,0.64,0,1),blob(0.22,0.14,0.74,0.06,2),blob(0.24,-0.12,0.56,-0.09,3),blob(0.2,0.02,0.82,-0.1,4)]);
 const cone=(r,h,y)=>{const g=new THREE.ConeGeometry(r,h,9).translate(0,y,0);lumpy(g,0.15,7);g.userData={c:[1,1,1]};return g;};
 const con=mergeGeo([trunk(),cone(0.26,0.42,0.42),cone(0.2,0.36,0.62),cone(0.13,0.3,0.82)]);
 const mat=new THREE.MeshLambertMaterial({vertexColors:true});
 const N=MOBILE?7000:13000;const dI=new THREE.InstancedMesh(dec,mat,N),cI=new THREE.InstancedMesh(con,mat,N);const m=new THREE.Matrix4(),c=new THREE.Color(),q=new QT();let nd=0,nc=0;
 for(let t=0;t<160000&&(nd<N||nc<N);t++){const x=(R()*2-1)*17000,z=(R()*2-1)*17000,h=groundH(x,z);const f=forestAt(x,z);
  let ok=f>0.5;if(!ok&&f<0.05&&h>4&&h<350&&R()<0.012&&!inCity(x,z)){let near=false;for(const a of AIRPORTS)if(Math.hypot(x-a.x,z-a.z)<a.len/2+900)near=true;ok=!near;}if(!ok)continue;
  const conifer=h>500?R()<0.85:R()<0.3;const hh=conifer?16+R()*14:12+R()*10,w=hh*(conifer?0.75:0.95)*(0.85+R()*0.3);
  q.setFromAxisAngle(new V3(0,1,0),R()*6.28);m.compose(new V3(x,h-0.5,z),q,new V3(w,hh,w));
  if(conifer&&nc<N){cI.setMatrixAt(nc,m);c.setRGB(0.07+R()*0.04,0.17+R()*0.06,0.08+R()*0.03).convertSRGBToLinear();cI.setColorAt(nc,c);nc++;}
  else if(!conifer&&nd<N){dI.setMatrixAt(nd,m);c.setRGB(0.16+R()*0.12,0.3+R()*0.12,0.1+R()*0.05).convertSRGBToLinear();dI.setColorAt(nd,c);nd++;}}
 dI.count=nd;cI.count=nc;for(const im of [dI,cI]){im.frustumCulled=false;scene.add(im);}}
function cloudTexture(){const c=document.createElement('canvas');c.width=c.height=128;const x=c.getContext('2d');const R=rng(5);
 for(let i=0;i<26;i++){const px=30+R()*68,py=40+R()*50,r=14+R()*26;const g=x.createRadialGradient(px,py,0,px,py,r);g.addColorStop(0,'rgba(255,255,255,.55)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,128,128);}
 x.globalCompositeOperation='source-atop';const gr=x.createLinearGradient(0,30,0,110);gr.addColorStop(0,'rgba(255,255,255,0)');gr.addColorStop(1,'rgba(120,130,150,.55)');x.fillStyle=gr;x.fillRect(0,0,128,128);
 const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;return t;}
function buildClouds(){cloudMat=new THREE.SpriteMaterial({map:cloudTexture(),transparent:true,opacity:0.9,depthWrite:false});clouds=new THREE.Group();scene.add(clouds);
 const R=rng(11);for(let i=0;i<90;i++){const cx=(R()*2-1)*26000,cz=(R()*2-1)*26000,cy=1500+R()*1500;
 for(let k=0;k<9;k++){const s=new THREE.Sprite(cloudMat);const sc=600+R()*900;s.scale.set(sc*1.7,sc,1);s.position.set(cx+(R()-.5)*1600,cy+(R()-.5)*200,cz+(R()-.5)*1600);clouds.add(s);}}}

/* ================= PARTICLES / RAIN ================= */
class Particles{constructor(max,add){this.max=max;this.i=0;this.p=new Float32Array(max*3);this.c=new Float32Array(max*4);this.s=new Float32Array(max);
 this.v=new Float32Array(max*3);this.l=new Float32Array(max);this.ml=new Float32Array(max);this.gr=new Float32Array(max);this.a0=new Float32Array(max);
 const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(this.p,3));g.setAttribute('col',new THREE.BufferAttribute(this.c,4));g.setAttribute('size',new THREE.BufferAttribute(this.s,1));
 this.g=g;const m=new THREE.ShaderMaterial({transparent:true,depthWrite:false,blending:add?THREE.AdditiveBlending:THREE.NormalBlending,
  vertexShader:'attribute float size;attribute vec4 col;varying vec4 vC;void main(){vC=col;vec4 mv=modelViewMatrix*vec4(position,1.0);gl_PointSize=min(size*(600.0/max(-mv.z,0.5)),400.0);gl_Position=projectionMatrix*mv;}',
  fragmentShader:'varying vec4 vC;void main(){vec2 d=gl_PointCoord-0.5;float r=length(d);if(r>0.5)discard;gl_FragColor=vec4(vC.rgb,vC.a*smoothstep(0.5,0.05,r));}'});
 this.o=new THREE.Points(g,m);this.o.frustumCulled=false;scene.add(this.o);}
 spawn(x,y,z,vx,vy,vz,life,size,grow,r,g,b,a){const i=this.i;this.i=(i+1)%this.max;this.p[i*3]=x;this.p[i*3+1]=y;this.p[i*3+2]=z;this.v[i*3]=vx;this.v[i*3+1]=vy;this.v[i*3+2]=vz;
  this.l[i]=life;this.ml[i]=life;this.s[i]=size;this.gr[i]=grow;this.c[i*4]=r;this.c[i*4+1]=g;this.c[i*4+2]=b;this.a0[i]=a;this.c[i*4+3]=a;}
 update(dt){for(let i=0;i<this.max;i++){if(this.l[i]<=0)continue;this.l[i]-=dt;if(this.l[i]<=0){this.c[i*4+3]=0;this.s[i]=0;continue;}
  this.p[i*3]+=this.v[i*3]*dt;this.p[i*3+1]+=this.v[i*3+1]*dt;this.p[i*3+2]+=this.v[i*3+2]*dt;this.s[i]+=this.gr[i]*dt;this.c[i*4+3]=this.a0[i]*(this.l[i]/this.ml[i]);}
  this.g.attributes.position.needsUpdate=true;this.g.attributes.col.needsUpdate=true;this.g.attributes.size.needsUpdate=true;}
 clear(){this.l.fill(0);this.c.fill(0);this.s.fill(0);}}
let FX,SMK,rain,rainGeo,rainPos,rainOff;const RAIN_N=1600;
function buildFX(){FX=new Particles(1500,true);SMK=new Particles(2000,false);
 rainGeo=new THREE.BufferGeometry();rainPos=new Float32Array(RAIN_N*6);rainGeo.setAttribute('position',new THREE.BufferAttribute(rainPos,3));
 rain=new THREE.LineSegments(rainGeo,new THREE.LineBasicMaterial({color:0xaabbd0,transparent:true,opacity:0.45,fog:false}));rain.frustumCulled=false;rain.visible=false;scene.add(rain);
 rainOff=new Float32Array(RAIN_N*3);for(let i=0;i<RAIN_N*3;i++)rainOff[i]=Math.random();}
function explosion(p,scale=1){for(let i=0;i<180;i++){const v=new V3(Math.random()-.5,Math.random()*0.8,Math.random()-.5).normalize().multiplyScalar((10+Math.random()*40)*scale);
 FX.spawn(p.x,p.y,p.z,v.x,v.y,v.z,0.8+Math.random()*1.5,(8+Math.random()*14)*scale,10*scale,1,0.5+Math.random()*0.3,0.1,1);}
 for(let i=0;i<140;i++){const v=new V3(Math.random()-.5,Math.random(),Math.random()-.5).multiplyScalar(20*scale);SMK.spawn(p.x,p.y,p.z,v.x,v.y+5,v.z,4+Math.random()*6,(15+Math.random()*20)*scale,12*scale,0.15,0.13,0.12,0.8);}}

/* ================= A380 SPEC & STATE ================= */
const SPEC={name:'Airbus A380-800',mfr:'Airbus',type:'jet',apu:true,mass:380000,fuel:60000,fuelMax:250000,thrust:340000,S:845,span:79.8,len:72.7,R:3.57,deck:1.18,
 CL0:0.28,CLa:4.6,flapCL:0.8,cd0:0.02,k:0.045,aStall:0.24,vr:82,vapp:72,vmo:175,cp:0.7,ca:3,dq:1.9,cr:0.38,dp:2.0,cy:0.32,cb:1.6,dr:1.3,gearH:5.8,tailStrike:11,ff:1.6};
const NOSEZ=-33,EYE=new V3(-0.55,1.62,-27.0);
const P={pos:new V3(),vel:new V3(),q:new QT(),rate:{p:0,q:0,r:0}};
const SYS={};const FAIL={rud:null,rudSel:20,rudCur:0,hydG:false,hydY:false,eha:false};
let ENG=[],ENGPOS=[];const ctrl={pitch:0,roll:0,yaw:0};const keys={};
const ADMIN={randFire:false,randEng:false,randStorm:false,invincible:false,infFuel:false,autotrim:true,time:'day',weather:'clear',wind:4,windDir:270,turb:0.15};
const WX={spd:4,dir:270,turb:0.15,storm:false,rain:false,fog:false,lightT:5};
let tornados=[],microburst=null,tsunami=null,cabinFire=null,unreliable=0,stabRun=null,scen=null,scenT=0,timers=[],watchers=[];
let running=false,paused=true,simT=0;
const FLAPS=[0,0.25,0.5,0.75,1],FLAPN=['0','1','2','3','FULL'];
const _f=new V3(),_u=new V3(),_r=new V3(),_va=new V3(),_F=new V3(),_vd=new V3(),_ld=new V3(),_t=new V3(),_t2=new V3(),_dq=new QT();

/* ================= A380 MODEL ================= */
let model,fusParts=[],surf={},gearLegs=[],fans=[],navL={},landLight,cockpit,PANELS=[],bodyMat;
function afY(t,th){t=clamp(t,0,1);return 5*th*(0.2969*Math.sqrt(t)-0.126*t-0.3516*t*t+0.2843*t*t*t-0.1036*t*t*t*t);}
function loft(secs,f0,f1,nT,map,rel){rel=rel||new V3();const pos=[],uv=[],idx=[];let M=0;
 secs.forEach((s,i)=>{const r=[];for(let k=0;k<=nT;k++){const t=f1-(f1-f0)*k/nT;r.push([t,afY(t,s.th)*1.15+0.012*Math.sin(Math.PI*t)]);}
  const k0=f0>0?0:1,k1=f1<1?nT:nT-1;for(let k=k0;k<=k1;k++){const t=f0+(f1-f0)*k/nT;r.push([t,-afY(t,s.th)*0.85+0.012*Math.sin(Math.PI*t)]);}
  M=r.length;for(const [t,yo] of r){const p=map(s,t,yo);pos.push(p[0]-rel.x,p[1]-rel.y,p[2]-rel.z);uv.push((t-f0)/(f1-f0),i/(secs.length-1));}});
 for(let i=0;i<secs.length-1;i++)for(let j=0;j<M;j++){const a=i*M+j,b=i*M+(j+1)%M,c=(i+1)*M+j,d=(i+1)*M+(j+1)%M;idx.push(a,c,b,b,c,d);}
 for(const i of [0,secs.length-1]){const base=pos.length/3;let cx=0,cy=0,cz=0;for(let j=0;j<M;j++){cx+=pos[(i*M+j)*3];cy+=pos[(i*M+j)*3+1];cz+=pos[(i*M+j)*3+2];}
  pos.push(cx/M,cy/M,cz/M);uv.push(0.5,0.5);for(let j=0;j<M;j++)idx.push(base,i*M+j,i*M+(j+1)%M);}
 const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));g.setIndex(idx);g.computeVertexNormals();return g;}
const TAN_LE=Math.tan(33.5*DEG);
function wingSec(x){const le=-6.5+x*TAN_LE;const te=x<12?11.2+x*(2.1/12):13.3+(x-12)*((23.9-13.3)/27.9);
 return {x,y:-2.35+x*0.098,le,c:te-le,th:x<12?lerp(0.14,0.105,x/12):lerp(0.105,0.085,(x-12)/27.9)};}
const mapW=(s,t,yo)=>[s.x,s.y+yo*s.c,s.le+t*s.c];
function stabSec(x){return {x,y:1.1+x*0.07,le:24.2+x*0.781,c:9.4-x*(6.4/15.2),th:0.11};}
function finSec(h){return {y:3.3+h,le:22.0+h*0.9,c:14.5-h*(10/14.5),th:0.11};}
const mapF=(s,t,yo)=>[yo*s.c,s.y,s.le+t*s.c];
function range(a,b,n){const r=[];for(let i=0;i<=n;i++)r.push(a+(b-a)*i/n);return r;}
function ctrlSurf(parent,secs,f0,f1,map,mat){const A=new V3(...map(secs[0],f0,0)),B=new V3(...map(secs[secs.length-1],f0,0));
 const m=new THREE.Mesh(loft(secs,f0,f1,5,map,A),mat);m.castShadow=true;const pv=new THREE.Group();pv.position.copy(A);pv.add(m);parent.add(pv);
 const axis=B.clone().sub(A).normalize();const aft=new V3(0,0,1);
 return {pv,axis,base:A,chord:secs[0].c,set(deg,ext){this.pv.quaternion.setFromAxisAngle(this.axis,deg*DEG);this.pv.position.copy(this.base);if(ext){this.pv.position.addScaledVector(aft,ext*this.chord*0.18);this.pv.position.y-=ext*this.chord*0.05;}}};}
function spoilerPanel(parent,x0,x1,mat){const s0=wingSec(x0),s1=wingSec(x1),t0=0.56,t1=0.71;const yo=t=>afY(t,1)*1.15+0.012*Math.sin(Math.PI*t);
 const A=new V3(x0,s0.y+(afY(t0,s0.th)*1.15+0.012*Math.sin(Math.PI*t0))*s0.c+0.03,s0.le+t0*s0.c),B=new V3(x1,s1.y+(afY(t0,s1.th)*1.15+0.012*Math.sin(Math.PI*t0))*s1.c+0.03,s1.le+t0*s1.c);
 const pos=[];for(const s of [s0,s1])for(const t of [t0,t1]){pos.push(s.x-A.x,s.y+(afY(t,s.th)*1.15+0.012*Math.sin(Math.PI*t))*s.c+0.03-A.y,s.le+t*s.c-A.z);}
 const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setIndex([0,2,1,1,2,3]);g.computeVertexNormals();
 const m=new THREE.Mesh(g,mat);const pv=new THREE.Group();pv.position.copy(A);pv.add(m);parent.add(pv);const axis=B.clone().sub(A).normalize();
 return {pv,axis,set(deg){this.pv.quaternion.setFromAxisAngle(this.axis,deg*DEG);}};}
function liveryTex(emis){const W=1024,H=4096,L=72.7,c=document.createElement('canvas');c.width=W;c.height=H;const x=c.getContext('2d');
 const U=phi=>phi/(2*Math.PI)*W,Y=len=>H*(1-len/L);
 x.fillStyle=emis?'#000':'#f3f5f8';x.fillRect(0,0,W,H);
 if(!emis){const g=x.createLinearGradient(0,0,U(0.45*Math.PI),0);g.addColorStop(0,'#b9c0c8');g.addColorStop(1,'#f3f5f8');x.fillStyle=g;x.fillRect(0,0,U(0.45*Math.PI),H);
  const g2=x.createLinearGradient(W,0,U(1.55*Math.PI),0);g2.addColorStop(0,'#b9c0c8');g2.addColorStop(1,'#f3f5f8');x.fillStyle=g2;x.fillRect(U(1.55*Math.PI),0,W-U(1.55*Math.PI),H);
  for(let len=42;len<L;len+=0.1){const f=(len-42)/(L-42);const pm=(0.28+0.72*Math.pow(f,0.8))*Math.PI;const y=Y(len);
   x.fillStyle='#0d3f86';x.fillRect(0,y-3,U(pm),4);x.fillRect(W-U(pm),y-3,U(pm),4);x.fillStyle='#d6a83a';x.fillRect(U(pm),y-3,8,4);x.fillRect(W-U(pm)-8,y-3,8,4);}
  x.fillStyle='#0d3f86';for(const sd of [1,-1]){const ph=sd>0?Math.PI/2-14*DEG:1.5*Math.PI+14*DEG;x.fillRect(U(ph)-3,Y(42),6,Y(6)-Y(42));}}
 const win=(len,e,side)=>{const ph=side>0?Math.PI/2+e*DEG:1.5*Math.PI-e*DEG;const cx=U(ph),cy=Y(len);x.fillStyle=emis?'#ffd99a':'#1d2733';rr(x,cx-9,cy-8,18,16,5);x.fill();
  if(!emis){x.fillStyle='rgba(255,255,255,.25)';x.fillRect(cx-6,cy-6,5,4);}};
 const door=(len,e,side,hgt)=>{const ph=side>0?Math.PI/2+e*DEG:1.5*Math.PI-e*DEG;const cx=U(ph),cy=Y(len);if(emis)return;x.strokeStyle='#9aa3ad';x.lineWidth=3;rr(x,cx-hgt/2,cy-30,hgt,60,10);x.stroke();
  x.fillStyle='#1d2733';rr(x,cx-6,cy-8,14,14,4);x.fill();};
 const mainDoors=[9.8,17.5,28.8,40.5,51.8],upDoors=[13.5,30.5,46.5];
 for(const sd of [1,-1]){for(let l=8.5;l<57;l+=0.53){if(mainDoors.some(d=>Math.abs(d-l)<0.9))continue;win(l,-3,sd);}
  for(let l=10.5;l<53;l+=0.53){if(upDoors.some(d=>Math.abs(d-l)<0.9))continue;win(l,27,sd);}
  mainDoors.forEach(d=>door(d,-3,sd,92));upDoors.forEach(d=>door(d,27,sd,84));}
 if(!emis){x.fillStyle='#10161d';const cw=[[0.06,0.33],[0.36,0.66],[0.69,1.05]];
  for(const sd of [1,-1])for(const [a,b] of cw){const p1=Math.PI+sd*a,p2=Math.PI+sd*b;x.beginPath();x.moveTo(U(p1),Y(3.25));x.lineTo(U(p2),Y(3.45+b*0.4));x.lineTo(U(p2),Y(4.35+b*0.25));x.lineTo(U(p1),Y(4.5));x.closePath();x.fill();}
  x.font='italic 900 58px Arial';x.textBaseline='middle';x.textAlign='center';
  for(const sd of [1,-1]){const ph=sd>0?Math.PI/2+48*DEG:1.5*Math.PI-48*DEG;x.save();x.translate(U(ph),Y(30));x.rotate(sd>0?Math.PI/2:-Math.PI/2);x.fillStyle='#0d3f86';x.fillText('SKYPILOT',0,0);
   x.font='italic 700 22px Arial';x.fillStyle='#d6a83a';x.fillText('A 3 8 0',0,40);x.restore();x.font='italic 900 58px Arial';
   x.save();x.translate(U(sd>0?Math.PI/2+8*DEG:1.5*Math.PI-8*DEG),Y(62));x.rotate(sd>0?Math.PI/2:-Math.PI/2);x.font='bold 22px Arial';x.fillStyle='#fff';x.fillText('D-ASKY',0,0);x.restore();}}
 const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;t.anisotropy=maxAniso;return t;}
function finTex(){const c=document.createElement('canvas');c.width=c.height=512;const x=c.getContext('2d');const g=x.createLinearGradient(0,512,512,0);g.addColorStop(0,'#0a2f66');g.addColorStop(1,'#1458b0');x.fillStyle=g;x.fillRect(0,0,512,512);
 x.strokeStyle='#d6a83a';x.lineWidth=18;x.beginPath();x.moveTo(60,420);x.quadraticCurveTo(260,330,450,120);x.stroke();x.strokeStyle='#fff';x.lineWidth=10;x.beginPath();x.moveTo(90,470);x.quadraticCurveTo(300,380,480,190);x.stroke();
 const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;return t;}
function glowTex(){const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');const g=x.createRadialGradient(32,32,0,32,32,32);g.addColorStop(0,'rgba(255,255,255,1)');g.addColorStop(0.25,'rgba(255,255,255,.6)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,64,64);return new THREE.CanvasTexture(c);}
function buildModel(){
 const G=new THREE.Group();const R=SPEC.R,YS=SPEC.deck,L=72.7;fusParts=[];
 bodyMat=new THREE.MeshPhysicalMaterial({map:liveryTex(false),emissiveMap:liveryTex(true),emissive:0xffffff,emissiveIntensity:0,metalness:0.1,roughness:0.36,clearcoat:1,clearcoatRoughness:0.06,envMapIntensity:1.3});
 const wingM=new THREE.MeshPhysicalMaterial({color:col(0xd6dbe1),metalness:0.55,roughness:0.3,clearcoat:0.6,clearcoatRoughness:0.1,side:THREE.DoubleSide});
 const wingDark=new THREE.MeshStandardMaterial({color:col(0xb9bfc7),metalness:0.5,roughness:0.45,side:THREE.DoubleSide});
 const finM=new THREE.MeshPhysicalMaterial({map:finTex(),metalness:0.15,roughness:0.35,clearcoat:1,clearcoatRoughness:0.06,side:THREE.DoubleSide});
 const metal=new THREE.MeshStandardMaterial({color:col(0xc8ccd2),metalness:1,roughness:0.22});
 const dark=new THREE.MeshStandardMaterial({color:col(0x1b1e23),metalness:0.6,roughness:0.4});
 const nacM=new THREE.MeshPhysicalMaterial({color:col(0xeef1f4),metalness:0.15,roughness:0.3,clearcoat:1,clearcoatRoughness:0.05});
 // fuselage
 const prof=[[0,0],[0.28,0.25],[0.45,0.7],[0.6,1.3],[0.72,2.0],[0.82,2.9],[0.9,3.9],[0.95,5.0],[0.985,6.5],[1,8],[1,20],[1,34],[1,46],[0.985,49],[0.95,52],[0.88,55.5],[0.78,59],[0.65,62.5],[0.5,66],[0.34,69],[0.2,71.3],[0.08,72.4],[0.001,72.7]];
 const lg=new THREE.LatheGeometry(prof.map(p=>new THREE.Vector2(Math.max(0.001,p[0]*R),p[1])),64);lg.rotateX(Math.PI/2);
 const lp=lg.attributes.position,luv=lg.attributes.uv;
 for(let i=0;i<lp.count;i++){const len=lp.getZ(i);const up=len>47?Math.pow((len-47)/25.7,1.7)*R*1.0:0;const nd=len<8?-Math.pow(1-len/8,2)*R*0.25:0;
  lp.setY(i,lp.getY(i)*YS+up+nd);lp.setZ(i,len+NOSEZ);luv.setY(i,len/L);}
 lg.computeVertexNormals();const fus=new THREE.Mesh(lg,bodyMat);fus.castShadow=true;fus.receiveShadow=true;G.add(fus);fusParts.push(fus);
 const fair=new THREE.Mesh(new THREE.SphereGeometry(1,32,16).scale(3.9,1.7,15),new THREE.MeshStandardMaterial({color:col(0xc4cad1),metalness:0.3,roughness:0.4}));fair.position.set(0,-3.55,3.5);fair.castShadow=true;G.add(fair);fusParts.push(fair);
 // wings
 const wst=[0,4,8,12,16,21,25,28.5,32,36,39.9].map(wingSec);
 const wingR=new THREE.Group(),wingLG=new THREE.Group();wingLG.scale.x=-1;G.add(wingR);G.add(wingLG);
 surf={flaps:[],spoilers:[],ail:[]};
 for(const [grp,side] of [[wingR,1],[wingLG,-1]]){
  const wm=new THREE.Mesh(loft(wst,0,0.72,14,mapW),wingM);wm.castShadow=true;wm.receiveShadow=true;grp.add(wm);
  const rootTE=new THREE.Mesh(loft([0,4].map(wingSec),0.72,1,5,mapW),wingM);grp.add(rootTE);
  for(const [a,b] of [[4,12],[12,21],[21,28.5]]){const cs=ctrlSurf(grp,range(a,b,3).map(wingSec),0.72,1,mapW,wingDark);cs.side=side;surf.flaps.push(cs);}
  const ai=ctrlSurf(grp,range(28.5,39.9,4).map(wingSec),0.72,1,mapW,wingDark);ai.side=side;surf.ail.push(ai);
  for(const [a,b] of [[8,13],[13,18],[18,23],[23,28]]){const sp=spoilerPanel(grp,a,b,wingDark);sp.side=side;surf.spoilers.push(sp);}
  const ws=wingSec(39.9);const fence=new THREE.Mesh(loft([{y:ws.y-1.0,le:ws.le+0.6,c:3.2,th:0.06},{y:ws.y+2.4,le:ws.le+2.4,c:1.2,th:0.06}],0,1,6,(s,t,yo)=>[39.92+yo*s.c,s.y,s.le+t*s.c]),finM);grp.add(fence);
 }
 // stab
 const stR=new THREE.Group(),stL=new THREE.Group();stL.scale.x=-1;G.add(stR);G.add(stL);surf.elev=[];
 for(const grp of [stR,stL]){const m=new THREE.Mesh(loft(range(0,15.2,5).map(stabSec),0,0.7,10,mapW),wingM);m.castShadow=true;grp.add(m);surf.elev.push(ctrlSurf(grp,range(1.2,15.2,4).map(stabSec),0.7,1,mapW,wingDark));}
 // fin
 const finm=new THREE.Mesh(loft(range(0,14.5,6).map(finSec),0,0.68,12,mapF),finM);finm.castShadow=true;G.add(finm);
 surf.rud=ctrlSurf(G,range(0.6,14.2,5).map(finSec),0.68,1,mapF,finM);
 // engines
 ENGPOS=[];fans=[];
 const nacProf=[[1.45,0],[1.58,0.12],[1.67,0.55],[1.7,1.8],[1.64,3.3],[1.5,4.4],[1.28,5.2],[1.06,5.65]].map(p=>new THREE.Vector2(p[0],p[1]));
 const coreProf=[[1.02,5.55],[0.92,6.15],[0.64,6.7],[0.2,7.1],[0.01,7.18]].map(p=>new THREE.Vector2(p[0],p[1]));
 for(const ex of [-25.7,-14.8,14.8,25.7]){const ax=Math.abs(ex),ws=wingSec(ax);const inner=ax<20;
  const front=ws.le-(inner?3.7:3.2),cy=ws.y-(inner?2.15:1.85);
  const eg=new THREE.Group();eg.position.set(ex,cy,front);G.add(eg);
  const nac=new THREE.Mesh(new THREE.LatheGeometry(nacProf,40).rotateX(Math.PI/2),nacM);nac.castShadow=true;eg.add(nac);
  const core=new THREE.Mesh(new THREE.LatheGeometry(coreProf,32).rotateX(Math.PI/2),metal);eg.add(core);
  const inl=new THREE.Mesh(new THREE.CylinderGeometry(1.43,1.43,1.3,32,1,true).rotateX(Math.PI/2),new THREE.MeshStandardMaterial({color:col(0x3a3f46),metalness:0.8,roughness:0.35,side:THREE.BackSide}));inl.position.z=0.65;eg.add(inl);
  const lip=new THREE.Mesh(new THREE.TorusGeometry(1.5,0.09,10,48),metal);eg.add(lip);
  const disc=new THREE.Mesh(new THREE.CircleGeometry(1.42,32).rotateY(Math.PI),new THREE.MeshStandardMaterial({color:col(0x14171b),roughness:0.8}));disc.position.z=1.3;eg.add(disc);
  const fan=new THREE.Group();fan.position.z=1.05;eg.add(fan);
  for(let k=0;k<22;k++){const h=new THREE.Group();h.rotation.z=k*Math.PI*2/22;const bl=new THREE.Mesh(new THREE.BoxGeometry(0.05,1.0,0.3),new THREE.MeshStandardMaterial({color:col(0x5b6068),metalness:0.9,roughness:0.3}));bl.position.y=0.92;bl.rotation.y=0.6;h.add(bl);fan.add(h);}
  const spin=new THREE.Mesh(new THREE.ConeGeometry(0.45,0.95,28).rotateX(-Math.PI/2),new THREE.MeshStandardMaterial({color:col(0xf2f4f6),metalness:0.4,roughness:0.3}));spin.position.z=0.55;fan.add(spin);
  fans.push(fan);
  const py=new THREE.Mesh(new THREE.BoxGeometry(0.5,1.7,6.5),nacM);py.position.set(0,1.75,3.6);py.rotation.x=-0.06;eg.add(py);
  ENGPOS.push(new V3(ex,cy,front+6.9));}
 // gear
 gearLegs=[];const gm=new THREE.MeshStandardMaterial({color:col(0xb0b5bb),metalness:0.8,roughness:0.35}),tm=new THREE.MeshStandardMaterial({color:col(0x141414),roughness:0.95}),hm=new THREE.MeshStandardMaterial({color:col(0xd0d3d6),metalness:0.9,roughness:0.3});
 const leg=(x,z,top,axles,wr,rot)=>{const pv=new THREE.Group();pv.position.set(x,top,z);G.add(pv);const bot=-SPEC.gearH+wr-top;
  const st=new THREE.Mesh(new THREE.CylinderGeometry(0.16,0.16,Math.abs(bot),10),gm);st.position.y=bot/2;st.castShadow=true;pv.add(st);
  const span=(axles-1)*1.5;if(axles>1){const bm=new THREE.Mesh(new THREE.BoxGeometry(0.25,0.25,span+0.5),gm);bm.position.y=bot;pv.add(bm);}
  for(let a=0;a<axles;a++)for(const sx of [-1,1]){const wz=-span/2+a*1.5;const w=new THREE.Mesh(new THREE.CylinderGeometry(wr,wr,0.5,20).rotateZ(Math.PI/2),tm);w.position.set(sx*0.55,bot,wz);w.castShadow=true;pv.add(w);
   const hb=new THREE.Mesh(new THREE.CylinderGeometry(wr*0.55,wr*0.55,0.52,16).rotateZ(Math.PI/2),hm);hb.position.copy(w.position);pv.add(hb);}
