 pb(c,p,'apuS',330,60,110,90,'START',SYS.apuN>=95?['AVAIL',CG]:null,SYS.apuStarting?['ON',CB]:null,()=>{if(SYS.apuMaster&&SYS.bat)SYS.apuStarting=true;else hint('Erst BAT und APU MASTER SW',3);});
 section(c,465,20,140,165,'AIR');pb(c,p,'apuB',480,60,110,90,'APU BLEED',null,onoff(SYS.apuBleed),()=>SYS.apuBleed=!SYS.apuBleed);
 section(c,615,20,395,165,'HYD');pb(c,p,'pumpG',630,60,110,90,'GREEN PUMPS',P.hydG||!anyRunning()||!SYS.pumpG?null:['FAULT',CA],SYS.pumpG?['AUTO',CB]:['OFF',CW],()=>SYS.pumpG=!SYS.pumpG);
 pb(c,p,'pumpY',750,60,110,90,'YELLOW PUMPS',P.hydY||!anyRunning()||!SYS.pumpY?null:['FAULT',CA],SYS.pumpY?['AUTO',CB]:['OFF',CW],()=>SYS.pumpY=!SYS.pumpY);
 c.font='bold 15px Arial';c.textAlign='left';[['G',P.hydG],['Y',P.hydY],['EHA',P.eha]].forEach(([l,ok],i)=>{c.fillStyle=ok?CG:CA;c.fillText(l+' '+(ok?'5000':'LO'),875,80+i*28);});
 section(c,15,205,995,185,'ENG FIRE');
 ENG.forEach((e,i)=>{const x=35+i*245;const lit=e.fire;c.fillStyle=lit?'#e01010':'#7a1010';if(lit){c.shadowColor='#f00';c.shadowBlur=25;}rr(c,x,e.fireCut?250:240,140,80,10);c.fill();c.shadowBlur=0;
  c.fillStyle='#fff';c.font='bold 18px Arial';c.textAlign='center';c.fillText('ENG '+(i+1),x+70,(e.fireCut?250:240)+32);c.font='bold 15px Arial';c.fillText(e.fireCut?'PUSHED':'FIRE PUSH',x+70,(e.fireCut?250:240)+58);
  hit(p,x,240,140,90,()=>{e.fireCut=true;e.master=false;e.state='off';});
  pb(c,p,'a'+i,x+150,250,80,70,'AGENT',e.fireCut&&e.agents>0?['SQUIB',CW]:null,e.agents<2?['DISCH',CA]:null,()=>{if(!e.fireCut){hint('Erst FIRE-Griff drücken',3);return;}if(e.agents>0){e.agents--;e.agentT=2.5;}});
  c.fillStyle='#ccc';c.font='12px Arial';c.fillText('Löschmittel: '+e.agents,x+70,360);});
 section(c,15,410,520,160,'FUEL');for(let i=0;i<4;i++)pb(c,p,'feed'+i,30+i*125,450,110,90,'FEED '+(i+1),P.fuel<=0?['LO',CA]:null,onoff(SYS.feed[i]),()=>SYS.feed[i]=!SYS.feed[i]);
 section(c,545,410,465,160,'F/CTL');pb(c,p,'stab',560,450,130,90,'PITCH TRIM',stabRun&&!SYS.stabCut?['FAULT',CA]:null,SYS.stabCut?['CUTOUT',CA]:['NORM',CB],()=>SYS.stabCut=!SYS.stabCut);
 c.fillStyle='#fff';c.font='bold 16px Arial';c.textAlign='left';c.fillText('RUDDER: '+(P.rudDeg>=0?'R ':'L ')+Math.abs(P.rudDeg).toFixed(0)+'°',710,485);c.fillStyle=FAIL.rud!==null?CA:CG;c.fillText(FAIL.rud!==null?'⚠ RUDDER JAM':'RUDDER OK',710,512);
 section(c,15,590,700,140,'EXT LT');[['beacon','BEACON'],['strobe','STROBE'],['nav','NAV'],['land','LAND'],['seat','SEAT BELTS']].forEach(([k,l],i)=>pb(c,p,k,30+i*135,625,115,80,l,null,onoff(SYS[k]),()=>SYS[k]=!SYS[k]));
 section(c,725,590,285,140,'SIGNS / INFO');c.fillStyle='#fff';c.font='bold 14px Arial';c.textAlign='left';c.fillText('APU N '+Math.round(SYS.apuN)+'%',745,640);c.fillText('PWR '+(P.power?'ON':'OFF'),745,665);c.fillText('FUEL '+Math.round(P.fuel)+' kg',745,690);}
