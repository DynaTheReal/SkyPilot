 c.fillStyle='#fff';c.font='bold 14px Arial';c.fillText('SPEED BRAKE',130,815);[['RET',0],['½',0.5],['FULL',1]].forEach(([l,v],i)=>{const y=845+i*40;const on=Math.abs(P.spoiler-v)<0.01;c.fillStyle=on?CG:'#ccd';c.fillText(l,90,y+5);c.fillStyle='#14181c';c.fillRect(150,y-3,20,6);if(i===0)c.fillRect(156,845,8,80);hit(p,50,y-18,180,36,()=>P.spoiler=v);});
