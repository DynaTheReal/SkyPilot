 landLight=new THREE.SpotLight(0xfff4e0,0,3000,0.32,0.5,1);landLight.position.set(0,-3,-12);const tgt=new THREE.Object3D();tgt.position.set(0,-40,-320);G.add(tgt);landLight.target=tgt;G.add(landLight);
