  if(NS==='m'+i){c.strokeStyle='#ffe04a';c.lineWidth=5;c.globalAlpha=0.55+0.45*Math.sin(simT*6);rr(c,x+14,568,64,94,8);c.stroke();c.globalAlpha=1;}hit(p,x+10,560,80,110,()=>e.master=!e.master);});
