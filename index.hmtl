 CK.knobs=[];for(const cx of [370,580,790]){const k=child(PANEL.fcu,Cy(0.019,0.022,0.022,24),M(0x2a2e33,0.5,0.3),cx,83,0.011,Math.PI/2);CK.knobs.push(k);child(PANEL.fcu,Cy(0.012,0.012,0.004,20),M(0x8a9096,0.4,0.6),cx,83,0.024,Math.PI/2);}
 for(const cx of [965,1065,1165])child(PANEL.fcu,rbox(0.1,0.055,0.012,0.006),M(0x2a2e33,0.6),cx,62,0.004);
 const lever=(w,c_)=>{const g=new THREE.Group();const st=new THREE.Mesh(B(0.012,0.012,0.07),metal);st.position.z=0.035;g.add(st);const hd=new THREE.Mesh(rbox(w,0.03,0.034,0.012),c_);hd.position.z=0.075;hd.castShadow=true;g.add(hd);PANEL.ped.mesh.add(g);return g;};
 CK.thr=[];for(let i=0;i<4;i++){const lv=lever(0.075,blk);const band=new THREE.Mesh(B(0.077,0.008,0.036),white);band.position.set(0,0.004,0.075);lv.add(band);CK.thr.push(lv);}
 CK.flap=lever(0.07,M(0xd9dcdf,0.4));CK.sb=lever(0.065,M(0x3a3f45,0.5));
 CK.park=child(PANEL.ped,Cy(0.024,0.024,0.025,20),M(0x9b1c1c,0.5),230,970,0.0125,Math.PI/2);{const bar=new THREE.Mesh(B(0.05,0.012,0.012),blk);bar.position.y=0.018;CK.park.add(bar);}
 CK.mst=[];for(let i=0;i<4;i++){const g=new THREE.Group();const b=new THREE.Mesh(rbox(0.04,0.024,0.024,0.008),M(0xc9ced4,0.4,0.4));b.position.z=0.022;g.add(b);const st=new THREE.Mesh(B(0.01,0.01,0.02),metal);st.position.z=0.01;g.add(st);PANEL.ped.mesh.add(g);CK.mst.push(g);}
 CK.ign=child(PANEL.ped,Cy(0.028,0.032,0.02,20),M(0x2a2e33,0.5,0.3),256,750,0.01,Math.PI/2);{const pt=new THREE.Mesh(B(0.008,0.006,0.03),white);pt.position.set(0,0.012,-0.012);CK.ign.add(pt);}
 const L=(name,p,fov)=>{const d=p.clone().sub(EYE);LOOKS[name]={yaw:Math.atan2(-d.x,-d.z),pitch:Math.atan2(d.y,Math.hypot(d.x,d.z)),fov};};
 L('front',new V3(-0.55,1.45,-60),72);L('panel',PANEL.main.mesh.position.clone().add(new V3(-0.42,0,0)),46);L('over',PANEL.over.mesh.position.clone().add(new V3(0,0.05,0.18)),84);
 L('ped',PANEL.ped.mesh.position.clone().add(new V3(0,0,0.05)),60);L('efb',PANEL.efb.mesh.position.clone().add(new V3(0,-0.02,0)),18);
 cockpit.visible=false;
}
function updateCockpit3D(){if(!CK.thr)return;const pl=CK.pl,pd=PANEL.ped;
 const ty=P.rev?462:430-P.throttle*360;CK.thr.forEach((g,i)=>{const [x,y]=pl(pd,155+i*85,ty);g.position.set(x,y,0);});
 {const [x,y]=pl(pd,430,840+P.flapIdx*34);CK.flap.position.set(x,y,0);}
 {const k=P.spoiler<0.01?0:P.spoiler<0.99?1:2;const [x,y]=pl(pd,160,845+k*40);CK.sb.position.set(x,y,0);}
 CK.park.rotation.y=SYS.park?Math.PI/2:0;
 ENG.forEach((e,i)=>{const [x,y]=pl(pd,86+i*112,e.master?597:637);CK.mst[i].position.set(x,y,0);});
 CK.ign.rotation.y=SYS.ign?-0.9:0.9;
 {const [x,y]=pl(PANEL.main,1000,P.gearDown?235:125);CK.gear.position.set(x,y,0);}
 CK.knobs.forEach((k,i)=>{k.rotation.y=(i===0?(SYS.apSpd||0)*0.3:i===1?(SYS.apHdg||0)*DEG*3:(SYS.apAlt||0)*0.003);});
 CK.sticks.forEach(s=>s.rotation.set(-ctrl.pitch*0.3,0,-ctrl.roll*0.3));}
const PANEL={};

/* ================= SETUP ================= */
function resetState(){
 Object.assign(P,{rate:{p:0,q:0,r:0},onGround:true,airborne:false,crashed:false,landed:false,done:false,trim:0,throttle:0,flapIdx:0,flaps:0,gearDown:true,gearPos:1,gearStuck:false,
  spoiler:0,brakes:false,rev:false,hydFail:false,dmg:0,stall:false,tailStruck:false,surfType:'',fuel:SPEC.fuel,gammaPrev:0,gammaRate:0,rud:0,alpha:0,beta:0,V:0,qd:0,mass:0,
  agl:0,vs:0,gs:0,ias:0,power:false,rho:1.225,rudDeg:0,auth:1,hydG:false,hydY:false,eha:false,autobrake:false,apGS:false,apFlare:false,tdVS:0,el:0,ai:0});
 Object.assign(SYS,{bat:false,apuMaster:false,apuStarting:false,apuN:0,apuBleed:false,feed:[false,false,false,false],ign:false,beacon:false,nav:false,strobe:false,land:false,park:true,
  stabCut:false,ap:false,athr:false,appr:false,apAlt:0,apHdg:0,apSpd:0,seat:false,pumpG:true,pumpY:true});
 Object.assign(FAIL,{rud:null,rudCur:0,hydG:false,hydY:false,eha:false});
 ENG=ENGPOS.map((p,i)=>({i,x:p.x,pos:p,n1:0,n2:0,egt:20,state:'off',master:false,fire:false,fireT:0,fireCut:false,agents:2,agentT:0,destroyed:false,blocked:false,ash:false,thrust:0,failMsg:''}));
 tornados.forEach(t=>scene.remove(t.g));tornados=[];microburst=null;if(tsunami){scene.remove(tsunami.mesh);scene.remove(tsunami.flood);}tsunami=null;
 cabinFire=null;unreliable=0;stabRun=null;timers=[];watchers=[];scenT=0;lastCall=99999;calledV1=false;calledRot=false;
 FX.clear();SMK.clear();model.visible=true;$('smoke').style.opacity=0;hideResult();
}
function setHeadingQ(hdg,pitch){P.q.setFromAxisAngle(new V3(0,1,0),-hdg*DEG);if(pitch){_dq.setFromAxisAngle(new V3(1,0,0),pitch);P.q.multiply(_dq);}}
function runwayStart(ai,ready){const a=AIRPORTS[ai];const p=new V3(a.x,0,a.z).addScaledVector(a.dir,-(a.len/2-90));
 P.pos.set(p.x,a.elev+SPEC.gearH,p.z);P.vel.set(0,0,0);setHeadingQ(a.hdg,0);P.onGround=true;
 if(ready){enginesRunning(19.5);P.flapIdx=2;P.flaps=FLAPS[2];SYS.park=false;SYS.land=true;SYS.strobe=true;}}
function enginesRunning(n1){Object.assign(SYS,{bat:true,beacon:true,nav:true,seat:true,park:false});SYS.feed=[true,true,true,true];
 ENG.forEach(e=>{e.state='run';e.master=true;e.n1=n1;e.n2=58+(n1-19.5)*0.52;e.egt=420+n1*4.5;});P.throttle=clamp((n1-19.5)/80.5,0,1);}
function airStart(o){const s=SPEC;o=Object.assign({},o);{const rf=Math.sqrt(Math.exp(-o.alt/8500));o.spd=clamp(o.spd,s.vapp*1.05/rf,s.vmo*0.88/rf);}
 P.onGround=false;P.airborne=true;P.gearDown=!!o.gear;P.gearPos=o.gear?1:0;P.flapIdx=o.flaps||0;P.flaps=FLAPS[P.flapIdx];
 const alt=o.alt;P.pos.set(o.x,alt,o.z);const gamma=(o.gamma||0)*DEG;const rho=1.225*Math.exp(-alt/8500),q=0.5*rho*o.spd*o.spd,mass=s.mass+P.fuel;
 const CL=mass*9.81*Math.cos(gamma)/(q*s.S);const alpha=(CL-s.CL0-P.flaps*s.flapCL)/s.CLa;P.trim=clamp((alpha-0.02)*s.ca/s.cp,-1,1);
 setHeadingQ(o.hdg,alpha+gamma);const h=o.hdg*DEG;P.vel.set(Math.sin(h)*Math.cos(gamma),Math.sin(gamma),-Math.cos(h)*Math.cos(gamma)).multiplyScalar(o.spd);
 const CD=s.cd0+s.k*CL*CL+P.gearPos*0.016+P.flaps*0.045;const D=q*s.S*CD+mass*9.81*Math.sin(gamma);
 const lapse=Math.pow(rho/1.225,0.75)*(1-0.0012*o.spd);const Te=Math.max(0,D/4/(s.thrust*lapse));
 enginesRunning(clamp(Math.sqrt(Te)*100,19.5,100));SYS.strobe=true;SYS.land=alt<3000;P.gammaPrev=gamma;}
function approachStart(ai,dist,extra){const a=AIRPORTS[ai];const aim=new V3(a.x,0,a.z).addScaledVector(a.dir,-(a.len/2-300)).addScaledVector(a.dir,-dist);
 airStart(Object.assign({x:aim.x,z:aim.z,alt:a.elev+dist*Math.tan(3*DEG)+12,hdg:a.hdg,spd:SPEC.vapp*1.08,gear:true,flaps:4,gamma:-3},extra||{}));}
function bearing(fx,fz,tx,tz){return (Math.atan2(tx-fx,-(tz-fz))/DEG+360)%360;}
function later(t,fn){timers.push({t:scenT+t,fn});}
function watch(cond,fn){watchers.push({cond,fn});}

const SCEN=[
 {id:'cold',name:'Cold & Dark',desc:'Alles aus – Checkliste abarbeiten',setup(){runwayStart(0,false);}},
 {id:'ready',name:'Startbereit',desc:'Triebwerke laufen, Bahn 36',setup(){runwayStart(0,true);hint('Schub auf TOGA, bei '+Math.round(SPEC.vr*KT)+' kt ziehen',6);}},
 {id:'app',name:'Anflug SkyPort 36',desc:'10 km ILS-Endanflug',setup(){approachStart(0,10000);hint('FCU: APPR drücken = automatische Landung, oder selbst fliegen',7);}},
 {id:'brg',name:'Anflug Bergfeld 09',desc:'Gebirgsflughafen',setup(){approachStart(1,9000);}},
 {id:'cruise',name:'Reiseflug FL330',desc:'10 km Höhe, Autopilot an',setup(){airStart({x:15000,z:15000,alt:10000,hdg:315,spd:240});SYS.ap=true;SYS.athr=true;SYS.apAlt=10000;SYS.apHdg=315;SYS.apSpd=P.vel.length();}},
 {id:'night',name:'Nachtlandung',desc:'Nur Lichter',setup(){setEnv('night','clear');approachStart(0,12000);}},
 {id:'fog',name:'Nebel CAT III',desc:'Sicht < 300 m',setup(){setEnv('day','fog');approachStart(0,9000);}},
 {id:'xwind',name:'Seitenwind-Gewitter',desc:'25 kt von links',setup(){setEnv('day','storm');ADMIN.wind=13;ADMIN.windDir=280;ADMIN.turb=0.6;applyWind();approachStart(0,9000);}},
 {id:'hudson',name:'Vogelschlag alle TW',desc:'US Airways 1549',setup(){airStart({x:300,z:-900,alt:900,hdg:352,spd:105,flaps:1,gamma:3});later(3,()=>{ENG.forEach(e=>killEngine(e,'BIRD STRIKE',true));birds();say('Birds!');hint('Alle Triebwerke weg! Fluss im Norden oder zurück zur Bahn 18.',9);});}},
 {id:'qf32',name:'TW 2 explodiert',desc:'Qantas 32',setup(){airStart({x:-6000,z:12000,alt:2400,hdg:bearing(-6000,12000,0,4000),spd:140});later(4,()=>explodeEngine(ENG[1]));}},
 {id:'engfire',name:'TW-Brand bei V1',desc:'Start fortsetzen',setup(){runwayStart(0,true);watch(()=>P.ias>SPEC.vr*KT*0.97,()=>engineFire(ENG[0],true));}},
 {id:'rudder',name:'Seitenruder-Hardover',desc:'Ruder klemmt bei 25°',setup(){approachStart(0,14000,{gear:false,flaps:2});later(4,()=>{FAIL.rud=25;say('Rudder');hint('Seitenruder klemmt bei 25°! Mit Joystick gegenrollen.',7);});}},
 {id:'ua232',name:'Totaler Hydraulikausfall',desc:'United 232',setup(){airStart({x:2000,z:24000,alt:2200,hdg:bearing(2000,24000,0,1900),spd:120});later(3,()=>{FAIL.hydG=FAIL.hydY=FAIL.eha=true;boom(0.6,1);say('Hydraulic failure');hint('Keine Ruder! Lenken nur über Schub.',8);});}},
 {id:'gimli',name:'Kein Treibstoff',desc:'Gimli Glider',setup(){airStart({x:-9000,z:-14000,alt:6000,hdg:bearing(-9000,-14000,0,0),spd:150});P.fuel=60;}},
 {id:'ba9',name:'Vulkanasche',desc:'British Airways 9',setup(){setEnv('night','cloudy');airStart({x:12000,z:15000,alt:10000,hdg:bearing(12000,15000,0,0),spd:230});later(3,()=>{ENG.forEach(e=>{killEngine(e,'FLAMEOUT',false);e.ash=true;});say('Engine failure');hint('Unter 4000 m: ENG MODE IGN, MASTER aus/ein',10);});}},
 {id:'af447',name:'Staurohre vereist',desc:'Air France 447',setup(){setEnv('night','storm');airStart({x:15000,z:10000,alt:9500,hdg:300,spd:225});SYS.ap=true;SYS.athr=true;SYS.apAlt=9500;SYS.apHdg=300;SYS.apSpd=P.vel.length();later(6,()=>{unreliable=70;SYS.ap=false;SYS.athr=false;apOff();});}},
 {id:'dl191',name:'Microburst',desc:'Delta 191',setup(){setEnv('day','storm');approachStart(0,9000);const a=AIRPORTS[0];microburst={x:a.x,z:a.z+a.len/2+3200,R:900,S:22};}},
 {id:'sr111',name:'Rauch an Bord',desc:'Swissair 111',setup(){airStart({x:9000,z:16000,alt:3300,hdg:bearing(9000,16000,0,0),spd:150});later(4,()=>startCabinFire());}},
 {id:'gear',name:'Fahrwerk klemmt',desc:'Bauchlandung',setup(){approachStart(0,11000,{gear:false});P.gearStuck=true;}},
 {id:'tornado',name:'Tornado-Alarm',desc:'2 Tornados im Anflug',setup(){setEnv('day','storm');approachStart(0,13000);spawnTornado(1200,7000,-6,-3);spawnTornado(-1500,4800,5,-2);}},
 {id:'hurricane',name:'Hurrikan',desc:'Orkanböen',setup(){setEnv('day','storm');ADMIN.wind=30;ADMIN.windDir=100;ADMIN.turb=1;applyWind();approachStart(0,12000);}},
 {id:'tsunami',name:'Tsunami',desc:'Sofort starten!',setup(){runwayStart(0,true);spawnTsunami();hint('TSUNAMI! Welle in ca. 3 Minuten – sofort starten!',8);}}
];

/* ================= EVENTS ================= */
function killEngine(e,msg,permanent){if(!e)return;e.state='off';e.failMsg=msg;if(permanent)e.blocked=true;}
function engineFire(e,fail){if(!e||e.fire)return;e.fire=true;e.fireT=0;if(fail)killEngine(e,'ENG FIRE',true);else e.blocked=true;say('Engine fire');}
function explodeEngine(e){if(!e)return;e.destroyed=true;killEngine(e,'ENG DESTROYED',true);engineFire(e,true);const w=localToWorld(e.pos);explosion(w,0.5);boom(1,1.5);
 for(let i=0;i<70;i++)SMK.spawn(w.x,w.y,w.z,P.vel.x*0.5+(Math.random()-.5)*30,(Math.random()-.5)*20,P.vel.z*0.5+(Math.random()-.5)*30,3,1.5,0,0.2,0.2,0.2,1);
 P.dmg=Math.min(1,P.dmg+0.2);P.rate.r+=(e.x<0?1:-1)*0.04;flash(0.4);if(fans[e.i])fans[e.i].visible=false;}
function startCabinFire(){if(cabinFire)return;cabinFire={t:0};say('Smoke, smoke');hint('RAUCH AN BORD! Sofort landen – ca. 8 Minuten.',8);}
function birds(){ENG.forEach(e=>{const w=localToWorld(e.pos);for(let i=0;i<25;i++)FX.spawn(w.x,w.y,w.z,(Math.random()-.5)*15,(Math.random()-.5)*15,(Math.random()-.5)*15,0.6,4,3,1,0.6,0.2,1);});boom(0.8,1);}
function spawnTornado(x,z,vx,vz){const g=new THREE.Group();
 const m1=new THREE.MeshLambertMaterial({color:col(0x4d5258),transparent:true,opacity:0.6,side:THREE.DoubleSide,depthWrite:false}),m2=new THREE.MeshLambertMaterial({color:col(0x6a7078),transparent:true,opacity:0.25,side:THREE.DoubleSide,depthWrite:false});
 const f1=new THREE.Mesh(new THREE.CylinderGeometry(260,30,1700,28,10,true).translate(0,850,0),m1);g.add(f1);const f2=new THREE.Mesh(new THREE.CylinderGeometry(420,90,1750,28,6,true).translate(0,875,0),m2);g.add(f2);
 const cap=new THREE.Mesh(new THREE.CylinderGeometry(2200,1400,260,28),new THREE.MeshLambertMaterial({color:col(0x34383d),transparent:true,opacity:0.85,depthWrite:false}));cap.position.y=1780;g.add(cap);
 g.position.set(x,groundH(x,z),z);scene.add(g);tornados.push({g,f1,f2,x,z,vx,vz,r:110,vmax:85,life:600});}
const TS_NZ=230,TS_PROF=[[0,-30],[0,0],[-8,0.35],[0,0.68],[20,0.95],[50,1.04],[95,1.0],[170,0.8],[320,0.5],[600,0.22],[900,0]];
const TS_COL=[[-8,0.35],[0,0.7],[20,0.95],[50,1.04],[95,1],[170,0.8],[320,0.5],[600,0.22],[900,0]];
function spawnTsunami(){const NP=TS_PROF.length,N=(TS_NZ+1)*NP;const pos=new Float32Array(N*3),idx=[];
 for(let j=0;j<TS_NZ;j++)for(let k=0;k<NP-1;k++){const a=j*NP+k,b=a+1,c=a+NP,d=c+1;idx.push(a,c,b,b,c,d);}
 const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(pos,3));g.setIndex(idx);
 const mesh=new THREE.Mesh(g,new THREE.MeshStandardMaterial({color:col(0x2f7590),metalness:0.1,roughness:0.15,side:THREE.DoubleSide}));mesh.frustumCulled=false;
 const fg=new THREE.PlaneGeometry(19000,18000,95,90);fg.rotateX(-Math.PI/2);fg.translate(4500,-50,0);
 const flood=new THREE.Mesh(fg,new THREE.MeshStandardMaterial({color:col(0x4f6b60),roughness:0.3,transparent:true,opacity:0.92,side:THREE.DoubleSide}));flood.frustumCulled=false;
 scene.add(mesh);scene.add(flood);tsunami={x:coastX(0)+2500,H:48,mesh,flood,spd:72,scale:1,ft:0};updateTsunamiGeo();updateFlood();}
function updateTsunamiGeo(){const t=tsunami,g=t.mesh.geometry,pos=g.attributes.position.array,NP=TS_PROF.length;
 for(let j=0;j<=TS_NZ;j++){const z=-23000+j*46000/TS_NZ,base=Math.max(0,groundH(t.x+40,z));for(let k=0;k<NP;k++){const i=(j*NP+k)*3,pr=TS_PROF[k];pos[i]=t.x+pr[0];pos[i+1]=k===0?base+pr[1]:base+pr[1]*t.H*t.scale;pos[i+2]=z;}}
 g.attributes.position.needsUpdate=true;g.computeVertexNormals();}
function updateFlood(){const t=tsunami,g=t.flood.geometry,p=g.attributes.position;for(let i=0;i<p.count;i++){const x=p.getX(i),z=p.getZ(i),gh=groundH(x,z);p.setY(i,x>t.x+150?Math.max(0,gh)+6*t.scale:Math.min(gh,0)-10);}p.needsUpdate=true;g.computeVertexNormals();}
function tsunamiProfile(dx){if(dx<-8||dx>900)return -999;for(let k=1;k<TS_COL.length;k++){const a=TS_COL[k-1],b=TS_COL[k];if(dx<=b[0])return lerp(a[1],b[1],(dx-a[0])/(b[0]-a[0]))*tsunami.H*tsunami.scale;}return 0;}
function floodAt(x,z){if(!tsunami||x<tsunami.x+150)return 0;return Math.max(0,groundH(x,z))+6*tsunami.scale;}

/* ================= WIND ================= */
function applyWind(){WX.spd=ADMIN.wind;WX.dir=ADMIN.windDir;WX.turb=ADMIN.turb;}
const _w=new V3();
function getWind(p){const d=WX.dir*DEG;_w.set(-Math.sin(d),0,Math.cos(d)).multiplyScalar(WX.spd);
 const agl=Math.max(1,p.y-Math.max(0,groundH(p.x,p.z)));_w.multiplyScalar(clamp(0.45+0.55*Math.log(agl/2)/Math.log(300),0.3,1.1));
 const t=simT,tb=WX.turb*(3+WX.spd*0.35);
 if(tb>0){_w.x+=tb*(Math.sin(t*1.7+p.x*0.004)*0.6+Math.sin(t*3.1+p.z*0.007)*0.4);_w.y+=tb*0.7*(Math.sin(t*2.3+p.z*0.005)*0.6+Math.sin(t*4.7+p.x*0.006)*0.4);_w.z+=tb*(Math.sin(t*2.1+p.z*0.003)*0.6+Math.sin(t*3.7)*0.4);}
 for(const T of tornados){const dx=p.x-T.x,dz=p.z-T.z,dd=Math.hypot(dx,dz);if(dd>3500)continue;if(p.y>T.g.position.y+2000)continue;
  const vt=dd<T.r?T.vmax*dd/T.r:T.vmax*Math.pow(T.r/dd,0.75);const ix=dd>1?dx/dd:0,iz=dd>1?dz/dd:0;_w.x+=iz*vt-ix*vt*0.25;_w.z+=-ix*vt-iz*vt*0.25;_w.y+=38*Math.exp(-Math.pow(dd/(T.r*1.8),2));}
 if(microburst){const M=microburst,dx=p.x-M.x,dz=p.z-M.z,dd=Math.hypot(dx,dz),r=dd/M.R;if(r<3){const low=clamp(1-agl/900,0.15,1);
  _w.y-=M.S*Math.exp(-r*r)*clamp(agl/150,0.2,1);const out=M.S*1.5*r*Math.exp(-r*r)*low;if(dd>1){_w.x+=dx/dd*out;_w.z+=dz/dd*out;}}}
 return _w;}

/* ================= SYSTEMS ================= */
function anyRunning(){return ENG.some(e=>e.state==='run');}
function allRunning(){return ENG.every(e=>e.state==='run'||e.blocked||e.destroyed);}
function updateSystems(h){const s=SPEC;
 if(SYS.apuMaster&&SYS.bat&&P.fuel>0){if(SYS.apuStarting||SYS.apuN>0)SYS.apuN=Math.min(100,SYS.apuN+(SYS.apuN<95?8:20)*h);}else{SYS.apuN=Math.max(0,SYS.apuN-12*h);SYS.apuStarting=false;}if(SYS.apuN>=95)SYS.apuStarting=false;
 P.power=SYS.bat||SYS.apuN>=95||anyRunning();
 const run=i=>ENG[i].state==='run';
 P.hydG=SYS.pumpG&&!FAIL.hydG&&(run(0)||run(1));P.hydY=SYS.pumpY&&!FAIL.hydY&&(run(2)||run(3));P.eha=P.power&&!FAIL.eha;
 P.auth=(P.hydG&&P.hydY)?1:(P.hydG||P.hydY)?0.8:P.eha?0.5:0;P.hydFail=P.auth===0&&!P.onGround;
 const bleed=(SYS.apuN>=95&&SYS.apuBleed)||anyRunning();const rho=P.rho;let fuelUse=0;
 for(const e of ENG){const fuelOK=P.fuel>0&&SYS.feed[e.i];
  if(e.destroyed){e.n1=Math.max(0,e.n1-25*h);e.n2=Math.max(0,e.n2-25*h);e.egt=e.fire?900:Math.max(20,e.egt-30*h);e.thrust=0;e.state='off';continue;}
  const master=e.master&&!e.fireCut;
  if(e.state==='run'&&(!master||!fuelOK)){e.state='off';if(!fuelOK&&master)e.failMsg='FLAMEOUT';}
  if(e.state==='off'&&master&&SYS.ign&&fuelOK&&!e.blocked){if(e.ash&&P.pos.y<4000)e.ash=false;if(!e.ash&&(bleed||P.V>110)){e.state='start';e.failMsg='';}}
  if(e.state==='start'){if(!master||!fuelOK||!SYS.ign&&e.n2<50)e.state='off';
   else{if(e.n2<22){if(bleed||P.V>110)e.n2+=2.8*h;else e.state='off';}else{e.n2+=3.2*h;e.egt=Math.min(e.egt+70*h,720);if(e.n2>=58)e.state='run';}e.n1=e.n2*0.33;}}
  if(e.state==='run'){let thr=P.throttle;if(P.hydFail)thr=clamp(P.throttle+(e.x<0?1:-1)*ctrl.roll*0.55+ctrl.pitch*0.35,0,1);
   const tgt=19.5+thr*80.5;e.n1+=(tgt-e.n1)*Math.min(1,h*0.42);e.n2=58+(e.n1-19.5)*0.52;e.egt+=((420+e.n1*4.5+(e.fire?500:0))-e.egt)*h*0.8;
   let th=s.thrust*Math.pow(e.n1/100,2)*Math.pow(rho/1.225,0.75)*(1-0.0012*P.V);if(P.rev&&P.onGround&&(e.i===1||e.i===2))th*=-0.5;else if(P.rev&&P.onGround)th*=0.15;
   e.thrust=th;fuelUse+=s.ff*(0.25+0.75*Math.pow(e.n1/100,2));}
  else if(e.state!=='start'){const wm=Math.min(P.V*0.12,25);e.n2+=(wm-e.n2)*h*0.3;e.n1+=(wm*0.6-e.n1)*h*0.3;e.egt+=((e.fire?850:40)-e.egt)*h*0.15;e.thrust=0;}else e.thrust=0;
  if(e.fire){e.fireT+=h;if(e.agentT>0){e.agentT-=h;if(e.agentT<=0&&Math.random()<0.8){e.fire=false;hint('Feuer Triebwerk '+(e.i+1)+' gelöscht ✔',4);}}if(e.fireT>150&&!ADMIN.invincible)crash('Das Feuer hat den Flügel zerstört');}}
 if(SYS.apuN>0)fuelUse+=0.05;if(!ADMIN.infFuel)P.fuel=Math.max(0,P.fuel-fuelUse*h);}

/* ================= PHYSICS ================= */
const GEARPTS=[[0,-5.8,-26.8],[-6,-5.8,4],[6,-5.8,4],[-2.1,-5.8,7.6],[2.1,-5.8,7.6]].map(a=>new V3(...a)),BELLY=[[0,-4.15,-20],[0,-4.3,0],[0,-4.0,18],[0,-1.9,27]].map(a=>new V3(...a)),TAILPT=new V3(0,-1.9,27),
 EXTPTS=[[-14.8,-4.75,-4],[14.8,-4.75,-4],[-25.7,-3.4,4],[25.7,-3.4,4],[-39.9,1.5,21],[39.9,1.5,21]].map(a=>new V3(...a)),_t3=new V3();
function supportOff(){let mn=1e9;for(const p of (P.gearPos>0.95?GEARPTS:BELLY)){_t3.copy(p).applyQuaternion(P.q);if(_t3.y<mn)mn=_t3.y;}return -mn;}
function joyCurve(v){return Math.sign(v)*Math.pow(Math.abs(v),1.35);}
function pitchAng(){_f.set(0,0,-1).applyQuaternion(P.q);return Math.asin(clamp(_f.y,-1,1));}
function bankAng(){_r.set(1,0,0).applyQuaternion(P.q);_u.set(0,1,0).applyQuaternion(P.q);return Math.atan2(-_r.y,_u.y);}
function heading(){_f.set(0,0,-1).applyQuaternion(P.q);return (Math.atan2(_f.x,-_f.z)/DEG+360)%360;}
function localToWorld(v){return v.clone().applyQuaternion(P.q).add(P.pos);}
const qHold={};
function step(h){const s=SPEC;simT+=h;
 let ip=joyCurve(joyV.y),ir=joyCurve(joyV.x),iy=P.rud;
 if(keys.KeyS||keys.ArrowDown)ip+=1;if(keys.KeyW||keys.ArrowUp)ip-=1;if(keys.KeyA||keys.ArrowLeft)ir-=1;if(keys.KeyD||keys.ArrowRight)ir+=1;if(keys.KeyQ)iy-=1;if(keys.KeyE)iy+=1;
 if(keys.ShiftLeft||keys.ShiftRight)P.throttle=Math.min(1,P.throttle+0.4*h);if(keys.ControlLeft||keys.ControlRight)P.throttle=Math.max(0,P.throttle-0.4*h);
 if(keys.KeyT||qHold.trimUp)trimMove(1,h);if(keys.KeyY||qHold.trimDn)trimMove(-1,h);
 ip=clamp(ip,-1,1);ir=clamp(ir,-1,1);iy=clamp(iy,-1,1);
 ctrl.pitch+=(ip-ctrl.pitch)*Math.min(1,h*7);ctrl.roll+=(ir-ctrl.roll)*Math.min(1,h*7);ctrl.yaw+=(iy-ctrl.yaw)*Math.min(1,h*5);
 if(P.crashed)return;updateSystems(h);
 const fwd=_f.set(0,0,-1).applyQuaternion(P.q),up=_u.set(0,1,0).applyQuaternion(P.q),right=_r.set(1,0,0).applyQuaternion(P.q);
 const wind=getWind(P.pos);const va=_va.copy(P.vel).sub(wind);const V=va.length();P.V=V;
 const u=va.dot(fwd),wv=va.dot(up),sv=va.dot(right);
 const alpha=V>3?Math.atan2(-wv,Math.max(u,0.5)):0,beta=V>3?Math.asin(clamp(sv/V,-1,1)):0;P.alpha=alpha;P.beta=beta;
 const rho=1.225*Math.exp(-Math.max(P.pos.y,0)/8500);P.rho=rho;const qd=0.5*rho*V*V;P.qd=qd;P.mass=s.mass+P.fuel;const mass=P.mass;
 const nh=(P.hydG?1:0)+(P.hydY?1:0);P.flaps+=clamp(FLAPS[P.flapIdx]-P.flaps,-0.06*h*Math.max(0.35,nh/2),0.06*h*Math.max(0.35,nh/2));
 const gt=P.gearDown&&!P.gearStuck?1:0;if(!(P.onGround&&gt===0)){const gr=gt>P.gearPos?(P.hydG?1/8:1/14):(P.hydG?1/9:0);P.gearPos+=clamp(gt-P.gearPos,-gr*h,gr*h);}
 const aSt=s.aStall+P.flaps*0.02;
 let CL=alpha<aSt?s.CL0+s.CLa*alpha+P.flaps*s.flapCL:s.CL0+s.CLa*aSt+P.flaps*s.flapCL-(alpha-aSt)*3.5;CL=clamp(CL,-1.2,3);if(alpha>0.5)CL=Math.max(0.25,CL);
 P.stall=alpha>aSt&&!P.onGround&&V>10;CL*=1-0.45*P.spoiler;CL*=1-0.15*P.dmg;
 const CD=s.cd0+s.k*CL*CL+P.gearPos*0.016+P.flaps*0.045+P.spoiler*0.075+Math.abs(beta)*0.25+P.dmg*0.02+ENG.filter(e=>e.destroyed).length*0.004+Math.abs(P.rudDeg)*0.0004;
 const F=_F.set(0,-mass*9.81,0);
 P.lw=qd*s.S*CL/(mass*9.81);
 if(V>0.5){const vd=_vd.copy(va).divideScalar(V);const ld=_ld.crossVectors(right,vd).normalize();F.addScaledVector(ld,qd*s.S*CL);F.addScaledVector(vd,-qd*s.S*CD);F.addScaledVector(right,-qd*s.S*0.5*beta);}
 let T=0,Td=0;for(const e of ENG){T+=e.thrust;Td+=e.thrust*e.x;}F.addScaledVector(fwd,T);
 const qref=0.5*1.225*s.vr*s.vr,eff=Math.min(qd/qref,2.2),de=0.3+0.7*Math.min(eff,1);const Iz=mass*Math.pow(0.2*(s.span+s.len)/2,2);
 let el=ctrl.pitch,ai=ctrl.roll;
 if(SYS.ap&&(Math.abs(ip)>0.45||Math.abs(ir)>0.45||P.onGround||P.auth<0.5||unreliable>0)){SYS.ap=false;SYS.appr=false;apOff();}
 if(SYS.ap&&!P.onGround){const ap=autopilot(h);el=ap[0];ai=ap[1];}
 if(SYS.athr&&!P.onGround)P.throttle=clamp(P.throttle+(SYS.apSpd-P.V)*0.02*h,0,1);
 // rudder
 let ruCmd=ctrl.yaw;if(ADMIN.autotrim&&FAIL.rud===null&&eff>0.05&&Td!==0)ruCmd+=clamp(Td/(Iz*s.cy*Math.max(eff,0.3)),-1,1);
 if(FAIL.rud!==null){FAIL.rudCur+=clamp(FAIL.rud-FAIL.rudCur,-14*h,14*h);P.rudDeg=FAIL.rudCur;}else{const tgt=clamp(ruCmd,-1,1)*30*(P.auth>0?1:0);P.rudDeg+=clamp(tgt-P.rudDeg,-40*h,40*h);FAIL.rudCur=P.rudDeg;}
 const ru=P.rudDeg/30;
 el*=P.auth;ai*=P.auth;P.el=el;P.ai=ai;
 const gamma=Math.asin(clamp(P.vel.y/Math.max(P.vel.length(),1),-1,1));P.gammaRate=(gamma-P.gammaPrev)/h;P.gammaPrev=gamma;
 if(ADMIN.autotrim&&P.auth>0&&!SYS.stabCut&&!stabRun&&!P.onGround&&!SYS.ap&&eff>0.15){if(alpha>aSt-0.035)P.trim=Math.max(-1,P.trim-0.5*h);else if(Math.abs(ctrl.pitch)<0.06)P.trim=clamp(P.trim+(P.gammaRate*-0.9-P.rate.q*0.6)*h*clamp(3/Math.max(eff,0.3),1,4),-1,1);}
 if(stabRun&&!SYS.stabCut){stabRun.t+=h;if(stabRun.t%10<5.5)P.trim=Math.max(-1,P.trim-0.07*h);}
 const r=P.rate;const turb=WX.turb*(1+WX.spd*0.05);
 let qa=eff*(s.cp*(el+P.trim)-s.ca*(P.onGround?0.5:1)*(alpha-0.02))-s.dq*r.q*de+0.04*T/(mass*9.81);
 if(P.onGround&&pitchAng()>-0.01)qa-=1.15*(1-clamp(P.lw,0,1));
 let pa=eff*(s.cr*ai-0.4*s.cr*beta)-s.dp*r.p*de;
 if(ADMIN.autotrim&&!P.onGround&&Math.abs(ctrl.roll)<0.05&&!SYS.ap&&FAIL.rud===null&&!P.hydFail){const bk=bankAng();if(Math.abs(bk)<6*DEG)pa-=bk*0.8*eff*s.cr;}
 let ya=eff*(s.cy*ru+s.cb*beta)-s.dr*r.r*de-Td/Iz;
 if(P.stall){pa+=(Math.sin(simT*2.7)+Math.sin(simT*1.3))*0.6*eff;qa-=0.3*eff;}
 if(turb>0&&!P.onGround){pa+=turb*eff*1.2*Math.sin(simT*5.3+P.pos.x*0.01)*(s.cr*1.5);qa+=turb*eff*0.5*Math.sin(simT*4.1)*s.cp;}
 if(P.dmg>0)pa+=P.dmg*0.08*eff;
 r.q+=qa*h;r.p+=pa*h;r.r+=ya*h;
 const gH=groundH(P.pos.x,P.pos.z),wl=Math.max(0,floodAt(P.pos.x,P.pos.z));const surf=Math.max(gH,wl),onWater=gH<wl;
 let off=supportOff();
 if(P.onGround){const steer=(ctrl.yaw+(Math.abs(ctrl.roll)>0.05?ctrl.roll:0))*clamp(V/6,0,1)*clamp(25/Math.max(V,1),0.12,1)*0.3+(V>30?ru*0.04:0);
  r.r=onWater||P.gearPos<0.95?r.r*0.9:steer;const ph=pitchAng(),bk=bankAng();r.p=-bk*4;if(ph<0&&r.q<0)r.q=-ph*3;}
 const rv=_t.set(r.q,-r.r,-r.p).multiplyScalar(h);const ang=rv.length();if(ang>0){_dq.setFromAxisAngle(rv.divideScalar(ang),ang);P.q.multiply(_dq).normalize();}
 off=supportOff();P.vel.addScaledVector(F,h/mass);P.pos.addScaledVector(P.vel,h);
 const nb=P.pos.y-off;
 if(nb<=surf){if(!P.onGround){contact(-P.vel.y,onWater,gH);if(P.crashed)return;}
  P.onGround=true;P.pos.y=surf+off;if(P.vel.y<0)P.vel.y=0;
  const hf=_t2.set(fwd.x,0,fwd.z).normalize();const hrx=-hf.z,hrz=hf.x;let vf=P.vel.x*hf.x+P.vel.z*hf.z,vl=P.vel.x*hrx+P.vel.z*hrz;let mu,lat;
  if(onWater){mu=0.45;lat=1.5;}else if(P.gearPos<0.95){mu=0.55;lat=1.2;}else{mu=0.018+((P.brakes||SYS.park)?0.42:0);lat=7;}
  vl*=Math.exp(-lat*h);const dec=mu*9.81*h;vf=Math.abs(vf)<=dec?0:vf-Math.sign(vf)*dec;P.vel.x=hf.x*vf+hrx*vl;P.vel.z=hf.z*vf+hrz*vl;groundChecks(onWater,gH);}
 else if(nb>surf+0.4){if(P.onGround&&V>5)P.onGround=false;}
 _t3.copy(TAILPT).applyQuaternion(P.q);const tyy=P.pos.y+_t3.y;
 if(P.gearPos>0.95&&tyy<surf+0.02){if(!P.tailStruck){P.tailStruck=true;say('Tail strike');hint('Heckaufsetzer! Nicht so stark ziehen',3);}if(-P.vel.y>3.5&&!ADMIN.invincible)return crash('Heck aufgeschlagen');P.pos.y+=surf+0.02-tyy;if(r.q>0)r.q=0;if(P.vel.y<0)P.vel.y=0;}
 for(const ep of EXTPTS){_t3.copy(ep).applyQuaternion(P.q).add(P.pos);const gh0=groundH(_t3.x,_t3.z);if(gh0<0&&Math.abs(ep.x)<30)continue;const gh=Math.max(gh0,floodAt(_t3.x,_t3.z),0);
  if(_t3.y<gh){if(P.V>12&&!ADMIN.invincible)return crash(Math.abs(ep.x)>30?'Flügelspitze hat den Boden berührt':'Triebwerk hat den Boden berührt');P.pos.y+=gh-_t3.y;}}
 const agl=P.pos.y-off-surf;P.agl=agl;if(!P.airborne&&agl>8)P.airborne=true;
 P.vs=P.vel.y;P.gs=Math.hypot(P.vel.x,P.vel.z);P.ias=V*Math.sqrt(rho/1.225)*KT;
 if(P.pos.y<surf+s.R*0.3&&!P.onGround&&!ADMIN.invincible)crash('Aufprall auf Gelände');
 if(inCity(P.pos.x,P.pos.z)&&agl<300)for(const b of BUILD){if(P.pos.y<b.top&&Math.hypot(P.pos.x-b.x,P.pos.z-b.z)<b.r+s.span*0.35){if(!ADMIN.invincible)crash(b.bridge?'Kollision mit einer Brücke':'Kollision mit einem Gebäude');break;}}
 for(const Tn of tornados){const dd=Math.hypot(P.pos.x-Tn.x,P.pos.z-Tn.z);if(dd<Tn.r*1.4&&P.pos.y<Tn.g.position.y+1800){P.dmg=Math.min(1.2,P.dmg+h*0.35);if(P.dmg>=1.1&&!ADMIN.invincible)crash('Der Tornado hat das Flugzeug zerrissen');}}
 if(tsunami){const dx=P.pos.x-tsunami.x,ph=tsunamiProfile(dx);if(ph>-900&&P.pos.y-off<Math.max(0,groundH(tsunami.x+40,P.pos.z))+ph+2&&!ADMIN.invincible)crash('Vom Tsunami erfasst');}
 if(cabinFire&&P.airborne&&!P.landed&&cabinFire.t>480&&!ADMIN.invincible)crash('Feuer an Bord – Kontrollverlust');
 if(V*Math.sqrt(rho/1.225)>s.vmo*1.4&&!P.onGround&&!ADMIN.invincible)crash('Strukturversagen durch zu hohe Geschwindigkeit');}
function trimMove(d,h){let rate=0.25;if(SYS.stabCut&&P.V>120)rate=0.05;P.trim=clamp(P.trim+d*rate*h,-1,1);}
function autopilot(h){let tHdg=SYS.apHdg,tvs=clamp((SYS.apAlt-P.pos.y)*0.08,-12,10);
 if(SYS.appr){const il=ilsDev();if(il&&il.dist<22000){tHdg=(il.hdg+clamp(il.loc*6,-30,30)+360)%360;if(il.gs<0.25)P.apGS=true;
  if(P.apGS){tvs=-P.gs*Math.tan(3*DEG)-il.gs*P.gs*0.03;if(P.agl<20)P.apFlare=true;}}}
 if(P.apFlare){tvs=-clamp(P.agl*0.11,0.7,3);SYS.athr=false;if(P.agl<10)P.throttle=Math.max(0,P.throttle-0.4*h);{}}
 const el=clamp((tvs-P.vel.y)*0.05-P.rate.q*0.8,-0.4,0.5);const err=((tHdg-heading()+540)%360)-180;const tb=clamp(err*1.4*DEG,-25*DEG,25*DEG);
 return [el,clamp((tb-bankAng())*1.6-P.rate.p*0.9,-0.6,0.6)];}
function contact(vs,onWater){const gearOK=P.gearPos>0.95,bk=bankAng(),pt=pitchAng(),gs=Math.hypot(P.vel.x,P.vel.z);tdSmoke();
 if(!P.airborne){if(vs>4.5&&!ADMIN.invincible)crash('Zu harter Aufprall');return;}if(P.autobrake)P.brakes=true;P.spoiler=1;
 if(ADMIN.invincible){P.tdVS=vs;P.landed=true;P.surfType=onWater?'water':surfaceType();return;}
 if(onWater){if(vs<3.5&&gs<88&&Math.abs(bk)<12*DEG&&pt>-3*DEG&&pt<16*DEG){P.landed=true;P.tdVS=vs;P.surfType='water';splash(2);say('Brace brace');}else crash('Aufprall auf dem Wasser – Flugzeug zerbrochen');return;}
 if(vs>(gearOK?4.5:2.8))return crash('Zu harter Aufprall ('+vs.toFixed(1)+' m/s Sinkrate)');
 if(Math.abs(bk)>9*DEG)return crash('Triebwerk/Flügel hat den Boden berührt');
 if(pt<-3*DEG&&vs>1.5)return crash('Mit der Nase zuerst aufgeschlagen');
 if(slopeAt(P.pos.x,P.pos.z)>0.15)return crash('Gelände zu steil – Aufprall');
 if(pt>SPEC.tailStrike*DEG&&gearOK){P.tailStruck=true;say('Tail strike');}
 P.landed=true;P.tdVS=vs;P.surfType=surfaceType();}
function surfaceType(){for(const a of AIRPORTS){const l=apLocal(a,P.pos.x,P.pos.z);if(Math.abs(l[0])<a.len/2+60&&Math.abs(l[1])<a.wid/2+4)return 'runway';if(Math.abs(l[0])<a.len/2+400&&Math.abs(l[1])<600)return 'airport';}return inCity(P.pos.x,P.pos.z)?'city':'field';}
function groundChecks(onWater,gH){const gs=P.gs;
 if(P.gearPos<0.95&&gs>5){const w=localToWorld(new V3(0,-SPEC.R*SPEC.deck,0));for(let i=0;i<3;i++)FX.spawn(w.x+(Math.random()-.5)*6,w.y,w.z+(Math.random()-.5)*6,(Math.random()-.5)*8,Math.random()*4,(Math.random()-.5)*8,0.4,1.4,0,1,0.6,0.2,1);SMK.spawn(w.x,w.y,w.z,0,2,0,3,5,5,0.5,0.45,0.4,0.4);}
 if(onWater&&gs>3)splash(0.3);
 if(ADMIN.invincible||!P.airborne&&!P.landed&&P.surfType==='')return;
 if(!onWater){const st=surfaceType();if(st!=='runway'&&st!=='airport'&&gs>12){if(forestAt(P.pos.x,P.pos.z)>0.5)return crash('In den Wald gerast');if(st==='city')return crash('In die Stadt gerast');if(slopeAt(P.pos.x,P.pos.z)>0.22&&gs>20)return crash('Unebenes Gelände – Fahrwerk gebrochen');}}
 if(tsunami&&floodAt(P.pos.x,P.pos.z)>gH+0.5)crash('Vom Tsunami erfasst');
 if(P.landed&&!P.done&&gs<1){P.done=true;landingResult();}}
function tdSmoke(){if(P.gearPos<0.95)return;for(const sx of [-6,-2,2,6]){const w=localToWorld(new V3(sx,-SPEC.gearH,5));for(let i=0;i<8;i++)SMK.spawn(w.x,w.y+0.5,w.z,(Math.random()-.5)*3,1+Math.random()*2,(Math.random()-.5)*3,2,3,3,0.85,0.85,0.85,0.6);}}
function splash(n){const w=P.pos;for(let i=0;i<40*n;i++)SMK.spawn(w.x+(Math.random()-.5)*40,0.5,w.z+(Math.random()-.5)*36,(Math.random()-.5)*12,5+Math.random()*15,(Math.random()-.5)*12,1.5,4,5,0.92,0.95,1,0.8);}

/* ================= OUTCOMES ================= */
function crash(reason){if(P.crashed)return;P.crashed=true;P.vel.set(0,0,0);explosion(P.pos,2);boom(1,2.5);flash(0.7);model.visible=false;setCam(4);orbit.dist=1.6;SYS.ap=false;setTimeout(()=>showResult('💥 Absturz',reason,[]),1800);}
function landingResult(){const vs=P.tdVS,st=P.surfType;let title,lines=[];const emergency=scen&&!['cold','ready','app','brg','cruise','night','fog','xwind'].includes(scen.id)||cabinFire||ENG.some(e=>e.blocked)||P.auth<1||FAIL.rud!==null;
 if(st==='water'){title='🌊 Notwasserung geschafft!';lines.push('Wie das „Wunder vom Hudson“ – alle evakuiert.');}
 else if(st==='runway'){title=P.gearPos<0.95?'🛬 Bauchlandung auf der Bahn!':emergency?'🏆 Notlandung geschafft!':'✅ Landung erfolgreich';lines.push('Bewertung: '+(vs<1?'Butterweich (A+)':vs<1.8?'Sanft (A)':vs<2.7?'Fest (B)':'Hart (C)'));}
 else if(st==='airport')title='✅ Gelandet (neben der Bahn)';else title=P.gearPos<0.95?'🛬 Bauchlandung überlebt':'🌾 Notlandung im Gelände überlebt';
 lines.unshift('Aufsetz-Sinkrate: '+(vs*196.85).toFixed(0)+' ft/min ('+vs.toFixed(2)+' m/s)');if(P.tailStruck)lines.push('⚠ Heckaufsetzer');showResult(title,'',lines);}
function showResult(title,reason,lines){const r=$('result');r.innerHTML=`<h3>${title}</h3>${reason?`<p>${reason}</p>`:''}${lines.map(l=>`<p>${l}</p>`).join('')}
 <div style="display:flex;gap:8px;justify-content:center;margin-top:12px"><button class="btn" id="rAgain">↻ Nochmal</button>${P.crashed?'':'<button class="btn" id="rCont">Weiterfliegen</button>'}<button class="btn" id="rMenu">☰ Menü</button></div>`;
 r.classList.remove('hidden');$('rAgain').onclick=()=>startScenario(scen.id);$('rMenu').onclick=()=>openMenu();if($('rCont'))$('rCont').onclick=()=>{hideResult();P.landed=false;P.airborne=false;P.done=false;};}
function hideResult(){$('result').classList.add('hidden');}

/* ================= ENVIRONMENT ================= */
function setEnv(time,weather){ADMIN.time=time;ADMIN.weather=weather;applyEnv();}
function applyEnv(){const t=ADMIN.time,w=ADMIN.weather;
 let top=col(0x2a6fd6),hor=col(0xc4dcf2),hi=0.55,si=2.6,sc=new THREE.Color(1,0.94,0.84),near=7000,far=42000,cloudC=0xffffff,deep=col(0x0b3550),sd=new V3(0.45,0.62,0.35),exp=0.95,sunGlow=new THREE.Color(1,0.93,0.8);
 let hc=new THREE.Color(0xcfe6ff),hg=new THREE.Color(0x6b6a50),gref=new THREE.Color(0.055,0.065,0.035);
 if(t==='sunset'){top=col(0x1c2a62);hor=new THREE.Color(1.0,0.45,0.17);hi=0.42;si=3.6;sc=new THREE.Color(1,0.5,0.2);sd.set(-0.86,0.075,0.3);cloudC=0xffa070;deep=col(0x16253a);sunGlow=new THREE.Color(1.8,0.8,0.3);hc=new THREE.Color(1,0.6,0.42);hg=new THREE.Color(0.3,0.16,0.08);gref=new THREE.Color(0.14,0.07,0.03);exp=1.08;near=5000;far=34000;}
 if(t==='night'){gref=new THREE.Color(0.003,0.004,0.006);hc=new THREE.Color(0x8090c0);top=col(0x01030a);hor=col(0x0b1428);hi=0.08;si=0.18;sc=new THREE.Color(0.6,0.7,1);sd.set(0.3,0.5,-0.4);cloudC=0x252a38;deep=col(0x020810);near=3000;far=26000;sunGlow=new THREE.Color(0.08,0.09,0.12);exp=1.1;}
 WX.rain=false;WX.storm=false;WX.fog=false;
 if(w==='cloudy'){top.lerp(col(0x6a7684),0.7);hor.lerp(col(0xa7b0b8),0.7);hi*=0.9;si*=0.45;far=26000;sunGlow.multiplyScalar(0.2);}
 if(w==='rain'||w==='storm'){const k=w==='storm'?0.92:0.78;top.lerp(col(0x30363c),k);hor.lerp(col(0x5d666f),k);hi*=0.75;si*=0.2;cloudC=t==='night'?0x1c1f24:0x5a6068;near=1200;far=w==='storm'?8000:12000;WX.rain=true;WX.storm=w==='storm';deep.lerp(col(0x1b3442),0.6);sunGlow.multiplyScalar(0.05);}
 if(w==='fog'){top=col(t==='night'?0x101418:0xc8ccd0);hor=top.clone();near=20;far=650;WX.fog=true;si*=0.35;sunGlow.multiplyScalar(0.1);}
 skyU.top.value.copy(top);skyU.hor.value.copy(hor);skyU.gnd.value.copy(hor);skyU.sunDir.value.copy(sd.normalize());skyU.sunC.value.copy(sunGlow);
 envU.top.value.copy(top);envU.hor.value.copy(hor);envU.gnd.value.copy(gref);envU.sunC.value.copy(sunGlow);hemi.color.copy(hc);hemi.groundColor.copy(hg);
 scene.fog.color.copy(hor);scene.fog.near=near;scene.fog.far=far;baseHemi=hi;hemi.intensity=hi;sun.intensity=si;sun.color.copy(sc);renderer.toneMappingExposure=exp;
 cloudMat.color.set(cloudC);cloudMat.opacity=w==='clear'?0.8:0.95;clouds.visible=w!=='fog';
 waterMat.uniforms.deep.value.copy(deep);waterMat.uniforms.skyCol.value.copy(hor).lerp(top,0.3);waterMat.uniforms.sunCol.value.copy(sunGlow);
 if(CK.light){CK.light.intensity=t==='night'?1.4:t==='sunset'?0.25:0;CK.dome.forEach(d=>d.material.emissiveIntensity=t==='night'?1.2:0.15);}PANELS.forEach(p=>p.mesh.material.emissiveIntensity=p.em*(t==='night'?1.15:1));
 rain.visible=WX.rain;const dark=t!=='day'||w==='fog'||w==='storm';lightPts.forEach(l=>l.visible=dark);cityMat.emissiveIntensity=t==='night'?1.2:t==='sunset'?0.4:0;bodyMat.emissiveIntensity=t==='night'?0.9:0;
 if(w==='storm'&&ADMIN.turb<0.5){ADMIN.turb=0.5;ADMIN.wind=Math.max(ADMIN.wind,10);applyWind();}
 updateEnvMap();}

/* ================= CAMERA ================= */
const CAMS=['Cockpit','Verfolger','Seite','Tower','Orbit','Flügel'];let camMode=0;
const orbit={yaw:0.6,pitch:0.2,dist:1},look={yaw:0,pitch:0,fov:70,ty:0,tp:0,tf:70};const camPos=new V3();let camInit=false;
function setCam(m){camMode=m;$('camName').textContent=CAMS[m];camInit=false;const ck=m===0;$('look').classList.toggle('hidden',!ck);$('hud').classList.toggle('hidden',ck);$('mini').classList.toggle('hidden',ck);}
function lookAtPreset(n){const L=LOOKS[n];if(!L)return;look.ty=L.yaw;look.tp=L.pitch;look.tf=L.fov;}
function updateCamera(dt){const L=72;cockpit.visible=camMode===0&&!P.crashed;fusParts.forEach(f=>f.visible=!cockpit.visible);
 const fwd=_f.set(0,0,-1).applyQuaternion(P.q),right=_r.set(1,0,0).applyQuaternion(P.q);let fov=60;
 if(camMode===0&&!P.crashed){const k=1-Math.exp(-dt*6);look.yaw+=(look.ty-look.yaw)*k;look.pitch+=(look.tp-look.pitch)*k;look.fov+=(look.tf-look.fov)*k;
  camera.position.copy(EYE).applyQuaternion(P.q).add(P.pos);camera.quaternion.copy(P.q).multiply(new QT().setFromEuler(new THREE.Euler(look.pitch,look.yaw,0,'YXZ')));fov=look.fov;
  const sh=(WX.turb*0.003+(P.stall?0.01:0)+(P.onGround?P.gs*0.00004:0));camera.rotation.x+=(Math.random()-.5)*sh;camera.rotation.y+=(Math.random()-.5)*sh;camInit=false;}
 else if(camMode===5&&!P.crashed){camera.position.set(-4.6,1.3,-8).applyQuaternion(P.q).add(P.pos);camera.lookAt(localToWorld(new V3(-26,-2.5,10)));fov=62;}
 else{let des;
  if(camMode===1){const hf=_t.set(fwd.x,fwd.y*0.6,fwd.z).normalize();des=_t2.copy(P.pos).addScaledVector(hf,-(L*1.45+14)).add(new V3(0,L*0.3+4,0));}
  else if(camMode===2){des=_t2.copy(P.pos).addScaledVector(right,L*1.3+12).addScaledVector(fwd,-L*0.25).add(new V3(0,L*0.12+2,0));}
  else if(camMode===3){let best=AIRPORTS[0],bd=1e9;for(const a of AIRPORTS){const d=a.tower.distanceTo(P.pos);if(d<bd){bd=d;best=a;}}des=_t2.copy(best.tower);fov=clamp(2*Math.atan(L*1.6/Math.max(bd,1))/DEG,2,60);}
  else{const d=(L*1.7+25)*orbit.dist;des=_t2.set(Math.sin(orbit.yaw)*Math.cos(orbit.pitch),Math.sin(orbit.pitch),Math.cos(orbit.yaw)*Math.cos(orbit.pitch)).multiplyScalar(d).add(P.pos);}
  if(!camInit||camMode>=3){camPos.copy(des);camInit=true;}else camPos.lerp(des,1-Math.exp(-dt*6));
  const gh=Math.max(groundH(camPos.x,camPos.z),floodAt(camPos.x,camPos.z),0)+2;if(camPos.y<gh)camPos.y=gh;
  camera.position.copy(camPos);camera.lookAt(_t.copy(P.pos).addScaledVector(fwd,camMode===1?L*0.4:0));}
 if(Math.abs(camera.fov-fov)>0.01){camera.fov=fov;camera.near=camMode===0?0.05:0.5;camera.updateProjectionMatrix();}
 sky.position.copy(camera.position);
 const sd=skyU.sunDir.value;sun.position.copy(P.pos).addScaledVector(sd,400);sun.target.position.copy(P.pos);}

/* ================= WARNINGS / ECAM ================= */
let lastCall=99999,calledV1=false,calledRot=false,warnTimer=0,silenced=false,lastWarnKey='';
function say(t){try{if(muted||!window.speechSynthesis)return;const u=new SpeechSynthesisUtterance(t);u.lang='en-US';u.rate=1.05;speechSynthesis.speak(u);}catch(e){}}
function getWarnings(){const W=[];if(P.crashed)return W;
 if(P.stall&&P.airborne)W.push(['r','STALL']);if(P.ias>SPEC.vmo*KT*1.02&&!P.onGround)W.push(['r','OVERSPEED']);
 if(P.airborne&&!P.onGround&&P.agl<500&&P.vs<-Math.max(12,P.agl*0.07)&&!(P.gearPos>0.9&&P.vs>-8))W.push(['r','PULL UP']);
 if(P.airborne&&!P.onGround&&P.agl<230&&P.gearPos<0.5&&P.vs<0&&!P.gearStuck)W.push(['r','TOO LOW GEAR']);
 if(P.airborne&&!P.onGround&&Math.abs(bankAng())>35*DEG)W.push(['a','BANK ANGLE']);
 ENG.forEach(e=>{if(e.fire)W.push(['r','ENG '+(e.i+1)+' FIRE']);else if(e.failMsg&&e.state!=='run')W.push(['a','ENG '+(e.i+1)+' '+e.failMsg]);});
 if(ENG.every(e=>e.state!=='run')&&P.airborne)W.push(['r','ALL ENG FAIL']);
 if(FAIL.rud!==null)W.push(['a','RUDDER JAM '+Math.round(FAIL.rudCur)+'°']);
 if(P.airborne&&P.auth<1)W.push([P.auth<=0.5?'r':'a',P.auth===0?'F/CTL NO CONTROL':P.auth===0.5?'HYD G+Y LO PR':'HYD '+(P.hydG?'Y':'G')+' LO PR']);
 if(cabinFire)W.push(['r','SMOKE '+fmtT(Math.max(0,480-cabinFire.t))]);if(unreliable>0)W.push(['a','UNRELIABLE SPD']);
 if(stabRun&&!SYS.stabCut)W.push(['a','PITCH TRIM RUNAWAY']);if(P.gearStuck&&P.gearDown)W.push(['a','L/G NOT DOWN']);if(P.fuel<SPEC.fuelMax*0.03)W.push(['a','FUEL LOW']);
 if(microburst&&!P.onGround){const dd=Math.hypot(P.pos.x-microburst.x,P.pos.z-microburst.z);if(dd<microburst.R*2.2&&P.agl<700)W.push(['r','WINDSHEAR']);}
 if(tsunami&&tsunami.x>-2000)W.push(['r','TSUNAMI '+fmtT(Math.max(0,(tsunami.x-P.pos.x)/tsunami.spd))]);
 if(tornados.some(t=>Math.hypot(P.pos.x-t.x,P.pos.z-t.z)<3000))W.push(['r','TORNADO']);if(P.dmg>0.3)W.push(['a','STRUCT DAMAGE']);
 if(SYS.park&&P.throttle>0.5&&P.onGround)W.push(['a','PARK BRK ON']);if(SYS.ap)W.push(['i',SYS.appr?'AP APPR':'AP ON']);return W;}
function ecam(){const L=[],C='#3fb6ff',R='#ff3b3b',A='#ffae1a',G='#3dff7a';
 ENG.forEach((e,i)=>{const n=i+1;if(e.fire){L.push([R,'ENG '+n+' FIRE']);L.push([P.throttle<0.05?G:C,' - THR LEVERS ......... IDLE']);L.push([!e.master?G:C,' - ENG MASTER '+n+' ....... OFF']);L.push([e.fireCut?G:C,' - ENG '+n+' FIRE P/B ..... PUSH']);L.push([e.agentT>0||e.agents<2?G:C,' - AGENT '+n+' ............ DISCH']);}
  else if(e.blocked||e.destroyed){L.push([A,'ENG '+n+(e.destroyed?' SEVERE DAMAGE':' FAIL')]);L.push([!e.master?G:C,' - ENG MASTER '+n+' ....... OFF']);}
  else if(e.failMsg&&e.state!=='run'){L.push([A,'ENG '+n+' '+e.failMsg]);L.push([C,' - ENG MODE ...... IGN/START']);L.push([C,' - ENG MASTER '+n+' .. OFF → ON']);}});
 if(ENG.every(e=>e.state!=='run')&&P.airborne){L.unshift([R,'ENG ALL ENGINES FAILURE']);L.splice(1,0,[C,' - OPT RELIGHT SPD ... 280 KT'],[C,' - APU START (unter FL200)']);}
 if(FAIL.rud!==null){L.push([A,'F/CTL RUDDER JAM '+Math.round(FAIL.rudCur)+'°']);L.push([C,' - MIT QUERRUDER GEGENROLLEN']);L.push([C,' - ASYM SCHUB NUTZEN']);L.push([C,' - LDG: FLAPS 3, VAPP +10']);}
 if(P.auth<1&&(ENG.some(e=>e.state==='run')||P.airborne)){if(P.auth===0){L.push([R,'F/CTL NO HYD / NO BACKUP']);L.push([C,' - LENKEN NUR MIT SCHUB']);}
  else{if(!P.hydG)L.push([A,'HYD G SYS LO PR']);if(!P.hydY)L.push([A,'HYD Y SYS LO PR']);if(!P.hydG&&!P.hydY)L.push([A,'F/CTL BACKUP (EHA) AKTIV']);if(!P.hydG)L.push([C,' - L/G GRAVITY EXTN']);L.push([C,' - VAPP +10 KT']);}}
 if(cabinFire){L.push([R,'CAB SMOKE']);L.push([C,' - LAND ASAP']);}
 if(unreliable>0){L.push([A,'NAV IAS DISAGREE']);L.push([C,' - AP / ATHR ........ OFF']);L.push([C,' - PITCH 5° / THR CLB']);}
 if(stabRun&&!SYS.stabCut){L.push([A,'F/CTL PITCH TRIM RUNAWAY']);L.push([C,' - PITCH TRIM ...... CUTOUT']);}
 if(P.gearStuck){L.push([A,'L/G GEAR NOT DOWNLOCKED']);L.push([C,' - BAUCHLANDUNG VORBEREITEN']);}
 if(P.fuel<SPEC.fuelMax*0.03)L.push([A,'FUEL LO LEVEL']);
 if(!L.length){if(P.onGround){L.push([G,'T.O MEMO']);L.push([SYS.seat?G:C,' SIGNS ON']);L.push([P.flapIdx>0?G:C,' FLAPS ...... T.O']);L.push([C,' T.O CONFIG ... TEST']);}else{L.push([G,P.agl<600&&P.vs<0?'LDG MEMO':'']);if(P.agl<600&&P.vs<0){L.push([P.gearPos>0.99?G:C,' LDG GEAR ..... DN']);L.push([P.flapIdx>=3?G:C,' FLAPS ....... FULL']);L.push([P.spoiler>0?G:C,' SPLRS ........ ARM']);}}}
 if(SYS.apuN>=95)L.push([G,'APU AVAIL']);if(SYS.park)L.push([G,'PARK BRK']);if(SYS.seat&&!P.onGround)L.push([G,'SEAT BELTS']);return L;}
function fmtT(s){s=Math.round(s);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0');}
function callouts(){if(!P.airborne||P.onGround||P.crashed){if(P.onGround&&!P.airborne){const v=P.ias;if(!calledV1&&v>SPEC.vr*KT-8){calledV1=true;say('V one');}if(!calledRot&&v>SPEC.vr*KT){calledRot=true;say('Rotate');}}return;}
 if(P.vs>0)return;const ft=P.agl*FT;for(const m of [2500,1000,500,100,50,40,30,20,10]){if(ft<=m&&lastCall>m){lastCall=m;if(P.gearPos>0.5||m>=500)say(m===20&&P.throttle>0.05?'Retard':String(m));break;}}if(ft>2600)lastCall=99999;}

/* ================= DISPLAYS ================= */
function ilsDev(){let best=null;for(const a of AIRPORTS)for(const s of [1,-1]){const dir=a.dir.clone().multiplyScalar(s);const thr=new V3(a.x,0,a.z).addScaledVector(dir,-a.len/2);
 const aim=thr.clone().addScaledVector(dir,300);const dx=P.pos.x-aim.x,dz=P.pos.z-aim.z;const along=-(dx*dir.x+dz*dir.z);if(along<0||along>25000)continue;
 const hd=s>0?a.hdg:(a.hdg+180)%360;if(Math.abs(((heading()-hd+540)%360)-180)>70)continue;
 const lat=dx*dir.z+dz*(-dir.x);const loc=Math.atan2(lat,along+a.len)/DEG;const gsA=Math.atan2(P.pos.y-a.elev,along)/DEG;if(Math.abs(loc)>10)continue;
 const d={loc,gs:gsA-3,dist:along,hdg:hd,name:a.code+' '+(s>0?a.n1:a.n2)};if(!best||along<best.dist)best=d;}return best;}
function tape(c,x,y,w,hh,val,ppu,step,lab,right,disp){c.save();c.fillStyle='#1a2230';c.fillRect(x,y,w,hh);c.beginPath();c.rect(x,y,w,hh);c.clip();
 const cy=y+hh/2;c.strokeStyle='#ccd';c.fillStyle='#e8eef5';c.font='10px sans-serif';c.textAlign=right?'left':'right';const range=hh/2/ppu;const st=Math.floor((val-range)/step)*step;
 for(let v=st;v<=val+range;v+=step){const yy=cy-(v-val)*ppu;c.beginPath();if(right){c.moveTo(x,yy);c.lineTo(x+6,yy);}else{c.moveTo(x+w-6,yy);c.lineTo(x+w,yy);}c.stroke();if(v%lab===0&&(v>=0||right))c.fillText(String(v),right?x+8:x+w-8,yy+3.5);}
 if(disp)disp(c,cy);c.restore();c.fillStyle='#000';c.strokeStyle='#ffd400';c.lineWidth=1.2;c.fillRect(x,cy-9,w,18);c.strokeRect(x,cy-9,w,18);c.fillStyle='#fff';c.font='bold 12px sans-serif';c.textAlign='center';c.fillText(String(Math.round(val)),x+w/2,cy+4.5);}
function drawPFDcore(c){const cx=145,cy=110,AW=170,AH=160;const pitch=pitchAng(),bank=bankAng();
 c.save();c.beginPath();c.rect(cx-AW/2,cy-AH/2,AW,AH);c.clip();c.translate(cx,cy);c.rotate(-bank);c.translate(0,pitch/DEG*3.2);
 c.fillStyle='#2f78c8';c.fillRect(-300,-700,600,700);c.fillStyle='#8a5a2b';c.fillRect(-300,0,600,700);c.strokeStyle='#fff';c.lineWidth=1.5;c.beginPath();c.moveTo(-300,0);c.lineTo(300,0);c.stroke();
 c.font='9px sans-serif';c.fillStyle='#fff';c.textAlign='left';c.lineWidth=1;for(let a=-40;a<=40;a+=5){if(!a)continue;const y=-a*3.2,w=a%10===0?34:16;c.beginPath();c.moveTo(-w/2,y);c.lineTo(w/2,y);c.stroke();if(a%10===0)c.fillText(Math.abs(a),w/2+3,y+3);}c.restore();
 c.strokeStyle='#fff';c.lineWidth=1;c.beginPath();c.arc(cx,cy,68,-135*DEG,-45*DEG);c.stroke();for(const a of [-45,-30,-20,-10,0,10,20,30,45]){const r2=a%30===0?76:72,an=(-90+a)*DEG;c.beginPath();c.moveTo(cx+Math.cos(an)*68,cy+Math.sin(an)*68);c.lineTo(cx+Math.cos(an)*r2,cy+Math.sin(an)*r2);c.stroke();}
 const ban=(-90-bank/DEG)*DEG;c.fillStyle='#ffd400';c.beginPath();c.moveTo(cx+Math.cos(ban)*67,cy+Math.sin(ban)*67);c.lineTo(cx+Math.cos(ban-0.06)*58,cy+Math.sin(ban-0.06)*58);c.lineTo(cx+Math.cos(ban+0.06)*58,cy+Math.sin(ban+0.06)*58);c.fill();
 if(P.gs>20){const gam=Math.asin(clamp(P.vel.y/P.vel.length(),-1,1));const dy=(pitch-gam)/DEG*3.2;const vh=Math.atan2(P.vel.x,-P.vel.z)/DEG,dr=((vh-heading()+540)%360-180)*3.2;
  const fx=cx+clamp(dr,-70,70),fy=cy+clamp(dy,-70,70);c.strokeStyle='#3fff7a';c.lineWidth=1.5;c.beginPath();c.arc(fx,fy,5,0,7);c.moveTo(fx-12,fy);c.lineTo(fx-5,fy);c.moveTo(fx+5,fy);c.lineTo(fx+12,fy);c.moveTo(fx,fy-5);c.lineTo(fx,fy-10);c.stroke();}
 c.strokeStyle='#ffd400';c.lineWidth=3;c.beginPath();c.moveTo(cx-48,cy);c.lineTo(cx-16,cy);c.lineTo(cx-16,cy+7);c.moveTo(cx+48,cy);c.lineTo(cx+16,cy);c.lineTo(cx+16,cy+7);c.stroke();c.fillStyle='#ffd400';c.fillRect(cx-3,cy-3,6,6);
 const ils=ilsDev();if(ils){c.fillStyle='#ff3fd2';c.strokeStyle='#fff';c.lineWidth=1;for(let i=-2;i<=2;i++){if(!i)continue;c.beginPath();c.arc(cx+AW/2-8,cy+i*16,2,0,7);c.stroke();c.beginPath();c.arc(cx+i*16,cy+AH/2-8,2,0,7);c.stroke();}
  const gy=cy+clamp(ils.gs*16/0.35,-38,38),lx=cx+clamp(ils.loc*16,-38,38);c.beginPath();c.moveTo(cx+AW/2-8,gy-6);c.lineTo(cx+AW/2-3,gy);c.lineTo(cx+AW/2-8,gy+6);c.lineTo(cx+AW/2-13,gy);c.fill();
  c.beginPath();c.moveTo(lx-6,cy+AH/2-8);c.lineTo(lx,cy+AH/2-3);c.lineTo(lx+6,cy+AH/2-8);c.lineTo(lx,cy+AH/2-13);c.fill();c.font='bold 9px sans-serif';c.textAlign='left';c.fillText('ILS '+ils.name+'  '+(ils.dist/1852).toFixed(1)+' NM',cx-AW/2+3,cy-AH/2+10);}
 let ias=P.ias;if(unreliable>0)ias=Math.max(40,60+40*Math.sin(simT*0.7)+20*Math.sin(simT*2.3));
 const s=SPEC,vsw=Math.sqrt(2*Math.max(P.mass,1)*9.81/(P.rho*s.S*(s.CL0+s.CLa*s.aStall+P.flaps*s.flapCL)))*Math.sqrt(P.rho/1.225)*KT;
 tape(c,4,30,50,160,ias,1.1,10,20,false,(c,cy)=>{c.fillStyle='#e0202a';c.fillRect(48,cy-(vsw-ias)*1.1,6,400);c.fillRect(48,cy-(s.vmo*KT-ias)*1.1-400,6,400);});
 c.fillStyle='#5be393';c.font='bold 10px sans-serif';c.textAlign='center';c.fillText('GS '+Math.round(P.gs*KT),29,203);
 const altft=P.pos.y*FT;tape(c,236,30,50,160,altft,0.11,100,500,true);
 c.fillStyle=Math.abs(P.vs)>10?'#ffb020':'#5be393';c.font='bold 10px sans-serif';c.fillText((P.vs>0?'+':'')+Math.round(P.vs*196.85),261,203);
 if(P.agl*FT<2500&&!P.onGround){c.fillStyle=P.agl*FT<500?'#ffb020':'#5be393';c.font='bold 13px sans-serif';c.fillText(Math.round(P.agl*FT),cx,cy+AH/2+12);}
 const hd=heading();c.save();c.fillStyle='#1a2230';c.fillRect(60,208,170,18);c.beginPath();c.rect(60,208,170,18);c.clip();c.fillStyle='#fff';c.strokeStyle='#ccd';c.font='9px sans-serif';c.textAlign='center';
