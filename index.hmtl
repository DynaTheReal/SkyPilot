 ENG.forEach((e,i)=>{const x=40+i*112;c.fillStyle=e.fire?CR:'#3a1010';rr(c,x+16,520,60,22,4);c.fill();c.fillStyle=e.fire?'#fff':'#a55';c.font='bold 12px Arial';c.fillText('FIRE',x+46,536);
