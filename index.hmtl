 for(let i=0;i<4;i++){const x=130+i*85;c.fillStyle='#0d1013';c.fillRect(x+18,60,14,410);c.fillStyle='#fff';c.font='bold 14px Arial';c.textAlign='center';c.fillText(String(i+1),x+25,52);}
