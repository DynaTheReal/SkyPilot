 const px_=(P.pos.x+HALF)*320/(2*HALF),pz=(P.pos.z+HALF)*320/(2*HALF);c.fillStyle='#19466e';c.fillRect(0,0,240,240);c.translate(120,120);c.scale(zoom,zoom);c.translate(-px_,-pz);c.drawImage(mapImg,0,0);c.setTransform(1,0,0,1,0,0);
 for(const t of tornados){c.fillStyle='rgba(255,40,40,.9)';c.beginPath();c.arc(120+(t.x-P.pos.x)*s,120+(t.z-P.pos.z)*s,6,0,7);c.fill();}c.restore();
