 for(const t of tornados){c.fillStyle='rgba(255,40,40,.9)';c.beginPath();c.arc((t.x-P.pos.x)*sc,(t.z-P.pos.z)*sc,6,0,7);c.fill();}
 if(tsunami){c.strokeStyle='#4ff';c.lineWidth=3;c.beginPath();c.moveTo((tsunami.x-P.pos.x)*sc,-400);c.lineTo((tsunami.x-P.pos.x)*sc,400);c.stroke();}c.restore();
 c.strokeStyle='#fff';c.lineWidth=1.5;c.beginPath();c.arc(cx,cy,R,-150*DEG,-30*DEG);c.stroke();c.setLineDash([4,6]);c.beginPath();c.arc(cx,cy,R/2,-150*DEG,-30*DEG);c.stroke();c.setLineDash([]);
 c.font='bold 13px sans-serif';c.textAlign='center';c.fillStyle='#fff';for(let a=0;a<360;a+=10){const rel=((a-hd+540)%360)-180;if(Math.abs(rel)>58)continue;const an=(-90+rel)*DEG;c.beginPath();c.moveTo(cx+Math.cos(an)*R,cy+Math.sin(an)*R);c.lineTo(cx+Math.cos(an)*(R-(a%30?6:12)),cy+Math.sin(an)*(R-(a%30?6:12)));c.stroke();if(a%30===0)c.fillText(String(a/10),cx+Math.cos(an)*(R-24),cy+Math.sin(an)*(R-24)+4);}
 c.fillStyle='#ffd400';c.beginPath();c.moveTo(cx,cy-14);c.lineTo(cx+12,cy+8);c.lineTo(cx,cy+2);c.lineTo(cx-12,cy+8);c.fill();c.fillRect(cx-1,cy-R-6,2,12);
 c.font='bold 14px sans-serif';c.textAlign='left';c.fillStyle='#fff';c.fillText('GS '+Math.round(P.gs*KT)+'  TAS '+Math.round(P.V*KT),10,22);c.fillStyle='#3dff7a';c.fillText(Math.round(WX.dir)+'°/'+Math.round(WX.spd*KT)+' kt',10,42);
 let best=null,bd=1e9;for(const a of AIRPORTS){const d=Math.hypot(a.x-P.pos.x,a.z-P.pos.z);if(d<bd){bd=d;best=a;}}c.textAlign='right';c.fillStyle='#ff3fd2';c.fillText(best.code+' '+(bd/1852).toFixed(1)+' NM',W-10,22);c.fillStyle='#fff';c.fillText(String(Math.round(bearing(P.pos.x,P.pos.z,best.x,best.z))).padStart(3,'0')+'°',W-10,42);c.fillStyle='#3fb6ff';c.fillText(Math.round(rng/1852/2)+' NM',cx+R/2+40,cy-6);}
