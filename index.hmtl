 drawPFDcore(c);ENG.forEach((e,i)=>{const x=12+i*50,y=252;c.fillStyle='#223';c.fillRect(x,y,40,8);c.fillStyle=e.fire?'#ff3030':e.state==='run'?'#3dff7a':'#ffb020';c.fillRect(x,y,40*clamp(e.n1/100,0,1),8);c.fillStyle='#fff';c.font='bold 10px sans-serif';c.textAlign='center';c.fillText(e.n1.toFixed(0),x+20,y+21);});
 c.textAlign='left';c.fillStyle='#cfe';c.font='bold 10px sans-serif';c.fillText('FLAPS '+FLAPN[P.flapIdx],214,258);c.fillStyle=P.gearPos>0.99?'#3dff7a':P.gearPos<0.01?'#9ab':'#ffb020';c.fillText('GEAR '+(P.gearPos>0.99?'DN':P.gearPos<0.01?'UP':'TR'),214,272);}
