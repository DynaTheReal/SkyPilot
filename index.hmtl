function fcuWin(c,p,x,lbl,val,dec,inc){c.fillStyle='#050607';rr(c,x+20,8,140,40,4);c.fill();c.fillStyle='#ccd';c.font='bold 11px Arial';c.textAlign='left';c.fillText(lbl,x+26,20);c.fillStyle='#ffb347';c.font='bold 22px monospace';c.textAlign='center';c.fillText(val,x+98,42);
 c.fillStyle='#14171a';c.beginPath();c.arc(x+90,83,30,0,7);c.fill();c.fillStyle='#20262c';rr(c,x,58,46,50,7);c.fill();rr(c,x+134,58,46,50,7);c.fill();c.fillStyle='#fff';c.font='bold 26px Arial';c.fillText('−',x+23,92);c.fillText('+',x+157,92);hit(p,x-5,52,58,64,dec);hit(p,x+128,52,58,64,inc);}
function fcuBtn(c,p,x,lbl,on,act){c.fillStyle='#fff';c.font='bold 14px Arial';c.textAlign='center';c.fillText(lbl,x+45,24);c.fillStyle=on?CG:'#333';c.fillRect(x+25,86,40,6);hit(p,x,10,90,100,act);}
function drawFCU(c,p){c.fillStyle='#3d4750';c.fillRect(0,0,1440,120);c.fillStyle='rgba(255,255,255,.08)';c.fillRect(0,0,1440,3);const W_=getWarnings(),red=W_.some(w=>w[0]==='r'),amb=W_.some(w=>w[0]==='a');const bl=Math.sin(simT*8)>0;
 c.fillStyle=red&&!silenced&&bl?'#ff2020':'#401010';rr(c,10,15,110,90,8);c.fill();c.fillStyle='#fff';c.font='bold 15px Arial';c.textAlign='center';c.fillText('MASTER',65,55);c.fillText('WARN',65,75);hit(p,10,15,110,90,()=>silenced=true);
 c.fillStyle=amb?'#ffae1a':'#40300a';rr(c,130,15,110,90,8);c.fill();c.fillStyle=amb?'#000':'#aaa';c.fillText('MASTER',185,55);c.fillText('CAUT',185,75);hit(p,130,15,110,90,()=>silenced=true);
 fcuWin(c,p,280,'SPD',String(Math.round((SYS.apSpd||P.V)*KT)),()=>{SYS.apSpd=(SYS.apSpd||P.V)-5.14;},()=>{SYS.apSpd=(SYS.apSpd||P.V)+5.14;});
 fcuWin(c,p,490,'HDG',String(Math.round(SYS.apHdg||heading())).padStart(3,'0'),()=>{SYS.apHdg=((SYS.apHdg||heading())+355)%360;},()=>{SYS.apHdg=((SYS.apHdg||heading())+5)%360;});
 fcuWin(c,p,700,'ALT',String(Math.round((SYS.apAlt||P.pos.y)*FT/100)*100),()=>{SYS.apAlt=Math.max(150,(SYS.apAlt||P.pos.y)-152.4);},()=>{SYS.apAlt=(SYS.apAlt||P.pos.y)+152.4;});
 fcuBtn(c,p,920,'AP1',SYS.ap,()=>toggleAP());fcuBtn(c,p,1020,'A/THR',SYS.athr,()=>{SYS.athr=!SYS.athr;SYS.apSpd=SYS.apSpd||P.V;});
 fcuBtn(c,p,1120,'APPR',SYS.appr,()=>{if(!SYS.ap)toggleAP();if(SYS.ap){SYS.appr=!SYS.appr;P.apGS=false;if(SYS.appr){SYS.apSpd=SPEC.vapp*1.05;SYS.athr=true;P.autobrake=true;hint('APPR: Autopilot fliegt den ILS bis zur Landung',4);}}});
 c.fillStyle=red&&!silenced&&bl?'#ff2020':'#401010';rr(c,1240,15,190,90,8);c.fill();c.fillStyle='#fff';c.font='bold 15px Arial';c.fillText(red?(W_.find(w=>w[0]==='r')||['',''])[1]:'NO WARN',1335,66);hit(p,1240,15,190,90,()=>silenced=true);}
let efbTab='fail';
function eb(c,p,x,y,w,h,lbl,state,act,sub){const on=state===true,warn=state==='warn';c.fillStyle=warn?'#7a1a1a':on?'#1d6e38':'#1c2532';rr(c,x,y,w,h,9);c.fill();c.strokeStyle=warn?'#ff6b6b':on?'#5be393':'#3a4a60';c.lineWidth=2;c.stroke();
 c.fillStyle='#fff';c.font='bold 21px Arial';c.textAlign='center';c.textBaseline='middle';c.fillText(lbl,x+w/2,sub?y+h/2-9:y+h/2);if(sub){c.font='15px Arial';c.fillStyle='#9fb3c8';c.fillText(sub,x+w/2,y+h/2+13);}c.textBaseline='alphabetic';hit(p,x,y,w,h,act);}
function drawEFB(c,p){c.fillStyle='#0d1219';c.fillRect(0,0,1024,720);c.fillStyle='#151d29';c.fillRect(0,0,1024,64);
 [['fail','⚠ Ausfälle'],['scen','✈ Szenarien'],['wx','⛈ Wetter'],['admin','⚙ Admin']].forEach(([k,l],i)=>{c.fillStyle=efbTab===k?'#2b6cc4':'#1c2532';rr(c,10+i*253,8,243,48,10);c.fill();c.fillStyle='#fff';c.font='bold 22px Arial';c.textAlign='center';c.fillText(l,10+i*253+121,40);hit(p,10+i*253,8,243,48,()=>{efbTab=k;});});
 c.textAlign='left';const H2=(t,y)=>{c.fillStyle='#7fa6d6';c.font='bold 17px Arial';c.textAlign='left';c.fillText(t,16,y);};
 if(efbTab==='fail'){H2('TRIEBWERKE (1 = links außen … 4 = rechts außen)',90);
  ENG.forEach((e,i)=>{const x=14+i*252;c.fillStyle=e.state==='run'?CG:e.fire?CR:CA;c.font='bold 18px Arial';c.textAlign='center';c.fillText('ENG '+(i+1)+': '+(e.fire?'FEUER':e.destroyed?'ZERSTÖRT':e.state==='run'?'LÄUFT':e.state==='start'?'START':'AUS'),x+118,116);
   eb(c,p,x,126,236,46,'Ausfall',e.blocked&&!e.fire&&!e.destroyed?'warn':false,()=>{killEngine(e,'ENG FAIL',true);say('Engine failure');});
   eb(c,p,x,178,236,46,'Feuer',e.fire?'warn':false,()=>engineFire(e,true));eb(c,p,x,230,236,46,'Explosion',e.destroyed?'warn':false,()=>explodeEngine(e));});
  eb(c,p,14,284,488,46,'ALLE Triebwerke aus',ENG.every(e=>e.state!=='run')&&P.airborne?'warn':false,()=>{ENG.forEach(e=>killEngine(e,'FLAMEOUT',false));say('Engine failure');});
  eb(c,p,518,284,488,46,'Vogelschlag (TW 1+2)',false,()=>{birds();killEngine(ENG[0],'BIRD STRIKE',true);killEngine(ENG[1],'BIRD STRIKE',true);});
  H2('SEITENRUDER KLEMMT (Hardover)',362);
  eb(c,p,14,372,90,52,'−5°',false,()=>FAIL.rudSel=clamp(FAIL.rudSel-5,-30,30));c.fillStyle='#000';c.fillRect(112,372,170,52);c.fillStyle='#ffb347';c.font='bold 28px monospace';c.textAlign='center';c.fillText((FAIL.rudSel>0?'R ':FAIL.rudSel<0?'L ':'')+Math.abs(FAIL.rudSel)+'°',197,408);
  eb(c,p,290,372,90,52,'+5°',false,()=>FAIL.rudSel=clamp(FAIL.rudSel+5,-30,30));
  eb(c,p,392,372,300,52,FAIL.rud!==null?'Ruder klemmt bei '+FAIL.rud+'°':'Ruder ausschlagen lassen',FAIL.rud!==null?'warn':false,()=>{FAIL.rud=FAIL.rud!==null&&FAIL.rud===FAIL.rudSel?null:FAIL.rudSel;if(FAIL.rud!==null)say('Rudder');});
  eb(c,p,704,372,302,52,'Ruder lösen',false,()=>FAIL.rud=null);
  H2('HYDRAULIK (Grün = TW 1+2, Gelb = TW 3+4, Backup = elektrisch)',458);
  [['GRÜN','hydG'],['GELB','hydY'],['BACKUP (EHA)','eha']].forEach(([l,k],i)=>eb(c,p,14+i*200,468,190,50,l,FAIL[k]?'warn':false,()=>FAIL[k]=!FAIL[k]));
  eb(c,p,614,468,392,50,'Totalausfall (alles)',FAIL.hydG&&FAIL.hydY&&FAIL.eha?'warn':false,()=>{const v=!(FAIL.hydG&&FAIL.hydY&&FAIL.eha);FAIL.hydG=FAIL.hydY=FAIL.eha=v;if(v)say('Hydraulic failure');});
  H2('WEITERE',552);
  eb(c,p,14,562,240,48,'Fahrwerk klemmt',P.gearStuck?'warn':false,()=>{P.gearStuck=!P.gearStuck;});eb(c,p,264,562,240,48,'Staurohre vereist',unreliable>0?'warn':false,()=>{unreliable=60;SYS.ap=false;SYS.athr=false;apOff();});
  eb(c,p,514,562,240,48,'Trimm-Runaway',stabRun?'warn':false,()=>{stabRun=stabRun?null:{t:0};});eb(c,p,764,562,242,48,'Rauch an Bord',cabinFire?'warn':false,()=>startCabinFire());
  eb(c,p,14,620,240,48,'Treibstoff leer',false,()=>P.fuel=Math.min(P.fuel,200));eb(c,p,264,620,742,48,'✔ ALLES REPARIEREN',false,()=>adminEvent('clear'));}
 else if(efbTab==='scen'){H2('Antippen = Szenario sofort starten',90);SCEN.forEach((s,i)=>{const col_=i%3,row=Math.floor(i/3);eb(c,p,14+col_*337,100+row*76,327,68,s.name,scen&&scen.id===s.id,()=>startScenario(s.id),s.desc);});}
 else if(efbTab==='wx'){H2('TAGESZEIT',90);[['day','Tag'],['sunset','Abend'],['night','Nacht']].forEach(([k,l],i)=>eb(c,p,14+i*200,100,190,48,l,ADMIN.time===k,()=>{ADMIN.time=k;applyEnv();}));
  H2('WETTER',180);[['clear','Klar'],['cloudy','Bewölkt'],['rain','Regen'],['storm','Gewitter'],['fog','Nebel']].forEach(([k,l],i)=>eb(c,p,14+i*200,190,190,48,l,ADMIN.weather===k,()=>{ADMIN.weather=k;applyEnv();}));
  H2('WIND',270);eb(c,p,14,280,70,48,'−',false,()=>{ADMIN.wind=Math.max(0,ADMIN.wind-2.5);applyWind();});c.fillStyle='#fff';c.font='bold 22px Arial';c.textAlign='center';c.fillText(Math.round(ADMIN.wind*KT)+' kt',150,312);eb(c,p,216,280,70,48,'+',false,()=>{ADMIN.wind=Math.min(40,ADMIN.wind+2.5);applyWind();});
  eb(c,p,320,280,70,48,'−',false,()=>{ADMIN.windDir=(ADMIN.windDir+350)%360;applyWind();});c.fillStyle='#fff';c.fillText('aus '+ADMIN.windDir+'°',470,312);eb(c,p,550,280,70,48,'+',false,()=>{ADMIN.windDir=(ADMIN.windDir+10)%360;applyWind();});
  eb(c,p,650,280,70,48,'−',false,()=>{ADMIN.turb=Math.max(0,ADMIN.turb-0.1);applyWind();});c.fillStyle='#fff';c.fillText('Turb '+Math.round(ADMIN.turb*10),800,312);eb(c,p,880,280,70,48,'+',false,()=>{ADMIN.turb=Math.min(1,ADMIN.turb+0.1);applyWind();});
  H2('KATASTROPHEN',370);eb(c,p,14,380,240,56,'🌪 Tornado',tornados.length>0,()=>adminEvent('tornado'));eb(c,p,264,380,240,56,'🌀 Hurrikan',ADMIN.wind>=25,()=>adminEvent('hurricane'));
  eb(c,p,514,380,240,56,'🌊 Tsunami',!!tsunami,()=>adminEvent('tsunami'));eb(c,p,764,380,242,56,'⬇ Microburst',!!microburst,()=>adminEvent('burst'));eb(c,p,14,450,992,56,'☀ Wetter beruhigen',false,()=>adminEvent('calm'));}
 else{H2('ZUFALLS-EREIGNISSE',90);[['randFire','Brand an Bord (sehr selten)'],['randEng','Zufällige TW-Ausfälle'],['randStorm','Zufällige Unwetter']].forEach(([k,l],i)=>eb(c,p,14+i*337,100,327,56,l,ADMIN[k],()=>ADMIN[k]=!ADMIN[k]));
  H2('HILFEN / CHEATS',190);[['autotrim','Fly-by-Wire-Hilfe'],['invincible','Unzerstörbar'],['infFuel','Unendlich Treibstoff']].forEach(([k,l],i)=>eb(c,p,14+i*337,200,327,56,l,ADMIN[k],()=>ADMIN[k]=!ADMIN[k]));
  eb(c,p,14,280,327,56,'⛽ Volltanken',false,()=>adminEvent('refuel'));eb(c,p,351,280,327,56,'⚡ Schnellstart TW',false,()=>adminEvent('quickstart'));eb(c,p,688,280,318,56,'🎥 Kamera wechseln',false,()=>setCam((camMode+1)%CAMS.length));
  c.fillStyle='#9fb3c8';c.font='18px Arial';c.textAlign='left';['Cold & Dark: Overhead → BAT, APU MASTER, APU START, APU BLEED, FEED 1-4, BEACON,','dann Pedestal → ENG MODE IGN, ENG MASTER 1-4 nacheinander, danach ENG MODE NORM.','Das gelb blinkende Feld zeigt immer den nächsten Schritt.'].forEach((t,i)=>c.fillText(t,16,390+i*28));}}
function nextStep(){
 if(!SYS.bat)return['bat','Overhead: BAT einschalten'];
 if(!allRunning()){if(!SYS.apuMaster)return['apuM','Overhead: APU MASTER SW'];if(SYS.apuN<95&&!SYS.apuStarting)return['apuS','Overhead: APU START'];if(SYS.apuN<95)return[null,'Warte auf APU AVAIL … '+Math.round(SYS.apuN)+' %'];if(!SYS.apuBleed)return['apuB','Overhead: APU BLEED'];}
 for(let i=0;i<4;i++)if(!SYS.feed[i])return['feed'+i,'Overhead: FEED '+(i+1)];
 if(!SYS.beacon)return['beacon','Overhead: BEACON (Triebwerksstart)'];
 if(!allRunning()){if(!SYS.ign)return['ign','Pedestal: ENG MODE → IGN/START'];const e=ENG.find(e=>e.state!=='run'&&!e.blocked&&!e.destroyed);if(e){if(!e.master)return['m'+e.i,'Pedestal: ENG MASTER '+(e.i+1)+' ON'];return[null,'Triebwerk '+(e.i+1)+' startet … N2 '+Math.round(e.n2)+' %'];}}
 if(SYS.ign&&P.onGround)return['ign','Pedestal: ENG MODE → NORM'];if(SYS.apuBleed&&P.onGround)return['apuB','Overhead: APU BLEED aus'];
 if(!SYS.nav)return['nav','Overhead: NAV Lichter'];if(!SYS.strobe&&P.onGround)return['strobe','Overhead: STROBE'];if(!SYS.land&&P.onGround)return['land','Overhead: LAND Lichter'];
 if(P.onGround&&P.flapIdx<2)return['flap1','Pedestal: Klappen auf 2'];if(P.onGround&&SYS.park)return['park','Pedestal: PARK BRK lösen'];
 if(P.onGround&&P.gs<5)return[null,'✔ Bereit! Schub auf TOGA, bei '+Math.round(SPEC.vr*KT)+' kt ziehen'];return[null,''];}

/* ================= ACTIONS ================= */
function toggleGear(){if(P.onGround&&P.gearDown){hint('Fahrwerk am Boden nicht einfahrbar',3);return;}if(P.gearDown&&!P.hydG&&!P.onGround){hint('Kein Hydraulikdruck (Grün) – Fahrwerk kann nicht einfahren',3);return;}P.gearDown=!P.gearDown;}
function setFlaps(d){P.flapIdx=clamp(P.flapIdx+d,0,4);hint('Klappen '+FLAPN[P.flapIdx],1.5);}
function toggleAP(){if(SYS.ap){SYS.ap=false;SYS.appr=false;apOff();return;}if(P.onGround||P.auth<0.5||unreliable>0){hint('Autopilot nicht verfügbar',3);return;}SYS.ap=true;SYS.apAlt=Math.round(P.pos.y/30.48)*30.48;SYS.apHdg=Math.round(heading());SYS.apSpd=P.V;SYS.athr=true;}
function apOff(){beep(500,0.15,0.05,'triangle');setTimeout(()=>beep(400,0.15,0.05,'triangle'),180);}
function quick(q){initAudio();switch(q){case'gear':toggleGear();break;case'flapUp':setFlaps(1);break;case'flapDn':setFlaps(-1);break;case'brk':P.brakes=!P.brakes;break;
 case'rev':P.rev=!P.rev;if(P.rev&&!P.onGround){P.rev=false;hint('Umkehrschub nur am Boden',2);}break;case'splr':P.spoiler=P.spoiler>0?0:1;break;}updateQuick();}
function updateQuick(){document.querySelectorAll('[data-q]').forEach(b=>{const q=b.dataset.q;let on=false;if(q==='gear'){b.textContent=P.gearDown?'GEAR ⬇':'GEAR ⬆';on=P.gearDown;}
 if(q==='brk')on=P.brakes;if(q==='rev')on=P.rev;if(q==='splr')on=P.spoiler>0;if(q==='rudL')on=P.rud<0;if(q==='rudR')on=P.rud>0;b.classList.toggle('on',on);});}
document.querySelectorAll('[data-q]').forEach(b=>{const q=b.dataset.q;
 if(['trimUp','trimDn','rudL','rudR'].includes(q)){const on=e=>{e.preventDefault();initAudio();qHold[q]=true;if(q==='rudL')P.rud=-1;if(q==='rudR')P.rud=1;updateQuick();};
  const off=()=>{qHold[q]=false;if(q==='rudL'||q==='rudR')P.rud=0;updateQuick();};b.addEventListener('pointerdown',on);b.addEventListener('pointerup',off);b.addEventListener('pointerleave',off);b.addEventListener('pointercancel',off);}
 else b.addEventListener('click',()=>quick(q));});
document.querySelectorAll('[data-look]').forEach(b=>b.addEventListener('click',()=>lookAtPreset(b.dataset.look)));
function adminEvent(ev){initAudio();const fwd=new V3(0,0,-1).applyQuaternion(P.q);fwd.y=0;fwd.normalize();
 switch(ev){case'tornado':{const p=P.pos.clone().addScaledVector(fwd,4500);spawnTornado(p.x,p.z,(Math.random()-.5)*14,(Math.random()-.5)*14);hint('Tornado 4,5 km voraus!',4);break;}
 case'hurricane':ADMIN.weather='storm';ADMIN.wind=30;ADMIN.turb=1;applyWind();applyEnv();hint('Hurrikan zieht auf!',4);break;case'tsunami':if(!tsunami)spawnTsunami();break;
 case'burst':{const p=P.pos.clone().addScaledVector(fwd,2500);microburst={x:p.x,z:p.z,R:900,S:22};hint('Microburst 2,5 km voraus',4);break;}
 case'clear':ENG.forEach(e=>Object.assign(e,{fire:false,destroyed:false,blocked:false,ash:false,fireCut:false,failMsg:'',agents:2}));fans.forEach(f=>f.visible=true);Object.assign(FAIL,{rud:null,hydG:false,hydY:false,eha:false});cabinFire=null;unreliable=0;stabRun=null;P.gearStuck=false;P.dmg=0;$('smoke').style.opacity=0;hint('Alles repariert',2);break;
 case'calm':tornados.forEach(t=>scene.remove(t.g));tornados=[];microburst=null;ADMIN.weather='clear';ADMIN.wind=4;ADMIN.turb=0.15;applyWind();applyEnv();break;
 case'refuel':P.fuel=SPEC.fuelMax*0.6;break;case'quickstart':enginesRunning(Math.max(19.5,ENG[0].n1));SYS.park=false;break;}}

/* ================= AUDIO ================= */
let AC=null,engGain,engLP,whineOsc,whineGain,windGain,muted=false;
function initAudio(){if(AC)return;try{AC=new(window.AudioContext||window.webkitAudioContext)();const buf=AC.createBuffer(1,AC.sampleRate*2,AC.sampleRate),d=buf.getChannelData(0);let l=0;
 for(let i=0;i<d.length;i++){const w=Math.random()*2-1;l=(l+0.02*w)/1.02;d[i]=l*3.5;}const n1=AC.createBufferSource();n1.buffer=buf;n1.loop=true;engLP=AC.createBiquadFilter();engLP.type='lowpass';engLP.frequency.value=500;engGain=AC.createGain();engGain.gain.value=0;n1.connect(engLP).connect(engGain).connect(AC.destination);n1.start();
 const wb=AC.createBuffer(1,AC.sampleRate*2,AC.sampleRate),wd=wb.getChannelData(0);for(let i=0;i<wd.length;i++)wd[i]=Math.random()*2-1;const n2=AC.createBufferSource();n2.buffer=wb;n2.loop=true;const hp=AC.createBiquadFilter();hp.type='bandpass';hp.frequency.value=900;windGain=AC.createGain();windGain.gain.value=0;n2.connect(hp).connect(windGain).connect(AC.destination);n2.start();
 whineOsc=AC.createOscillator();whineOsc.type='sawtooth';whineGain=AC.createGain();whineGain.gain.value=0;const bp=AC.createBiquadFilter();bp.type='bandpass';bp.frequency.value=2500;bp.Q.value=3;whineOsc.connect(bp).connect(whineGain).connect(AC.destination);whineOsc.start();}catch(e){AC=null;}}
function beep(f,d,vol=0.06,type='square'){if(!AC||muted)return;const o=AC.createOscillator(),g=AC.createGain();o.type=type;o.frequency.value=f;o.connect(g).connect(AC.destination);const t=AC.currentTime;g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.001,t+d);o.start(t);o.stop(t+d+0.05);}
function boom(vol,dur){if(!AC||muted)return;const len=AC.sampleRate*dur,b=AC.createBuffer(1,len,AC.sampleRate),d=b.getChannelData(0);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,2.5);
 const s=AC.createBufferSource();s.buffer=b;const f=AC.createBiquadFilter();f.type='lowpass';f.frequency.value=380;const g=AC.createGain();g.gain.value=vol;s.connect(f).connect(g).connect(AC.destination);s.start();}
function updateAudio(){if(!AC)return;const m=muted||paused?0:1;const t=AC.currentTime;let n=0;ENG.forEach(e=>n=Math.max(n,e.n1));const inside=camMode===0?0.45:1;
 engGain.gain.setTargetAtTime(m*inside*clamp(n/100,0,1)*0.4,t,0.1);engLP.frequency.setTargetAtTime(250+n*12,t,0.1);whineGain.gain.setTargetAtTime(m*inside*0.012*clamp(n/60,0,1),t,0.1);whineOsc.frequency.setTargetAtTime(800+n*28,t,0.1);
 windGain.gain.setTargetAtTime(m*clamp(P.V/250,0,1)*0.06+(WX.rain?0.03:0)*m,t,0.2);}
let flashV=0;function flash(v){flashV=Math.max(flashV,v);}
let hintT=0;function hint(t,dur=5){const e=$('info');e.textContent=t;e.style.opacity=1;hintT=dur;}

/* ================= MENU / START ================= */
function openMenu(){paused=true;$('menu').classList.remove('hidden');$('resumeBtn').classList.toggle('hidden',!running||P.crashed);hideResult();}
function closeMenu(){$('menu').classList.add('hidden');paused=false;}
function startScenario(id){initAudio();ADMIN.time='day';ADMIN.weather='clear';ADMIN.wind=4;ADMIN.windDir=270;ADMIN.turb=0.15;applyWind();
 resetState();applyEnv();scen=SCEN.find(s=>s.id===id)||SCEN[0];scen.setup();if(P.onGround)P.airborne=false;fans.forEach(f=>f.visible=true);
 running=true;camInit=false;closeMenu();updateQuick();PANELS.forEach(p=>p.render());
 if(id==='cold'){setCam(0);lookAtPreset('over');hint('Cold & Dark: Overhead über dir – das gelb blinkende Feld antippen',7);}else{if(camMode===4)setCam(1);hint(scen.name,3);}}
document.querySelectorAll('[data-start]').forEach(b=>b.onclick=()=>{if(b.dataset.start==='gold'){startScenario('ready');setEnv('sunset','clear');setCam(1);}else startScenario(b.dataset.start);});
$('resumeBtn').onclick=closeMenu;$('bMenu').onclick=openMenu;$('bCam').onclick=()=>setCam((camMode+1)%CAMS.length);
$('bSound').onclick=()=>{initAudio();muted=!muted;$('bSound').textContent=muted?'🔇':'🔊';};$('warn').onclick=()=>{silenced=true;};

/* ================= INPUT ================= */
const joy=$('joy'),knob=$('knob');let joyId=null;const joyV={x:0,y:0};
function joyMove(e){const r=joy.getBoundingClientRect();let x=(e.clientX-r.left-r.width/2)/(r.width/2),y=(e.clientY-r.top-r.height/2)/(r.height/2);const l=Math.hypot(x,y);if(l>1){x/=l;y/=l;}joyV.x=x;joyV.y=y;knob.style.transform=`translate(${x*38}px,${y*38}px)`;}
joy.addEventListener('pointerdown',e=>{e.preventDefault();initAudio();joyId=e.pointerId;joy.setPointerCapture(e.pointerId);joyMove(e);});joy.addEventListener('pointermove',e=>{if(e.pointerId===joyId)joyMove(e);});
const joyEnd=e=>{if(e.pointerId===joyId){joyId=null;joyV.x=joyV.y=0;knob.style.transform='';}};joy.addEventListener('pointerup',joyEnd);joy.addEventListener('pointercancel',joyEnd);
const thr=$('thr');let thrId=null;
function thrMove(e){const r=thr.getBoundingClientRect();let v=clamp(1-(e.clientY-r.top)/r.height,0,1);for(const d of [0,0.75,0.88,1])if(Math.abs(v-d)<0.025)v=d;P.throttle=v;P.rev=false;if(SYS.athr&&!P.onGround)SYS.athr=false;}
thr.addEventListener('pointerdown',e=>{e.preventDefault();initAudio();thrId=e.pointerId;thr.setPointerCapture(e.pointerId);thrMove(e);});thr.addEventListener('pointermove',e=>{if(e.pointerId===thrId)thrMove(e);});
thr.addEventListener('pointerup',()=>thrId=null);thr.addEventListener('pointercancel',()=>thrId=null);
let dragId=null,dragX=0,dragY=0,dragMoved=0,downX=0,downY=0;const ray=new THREE.Raycaster(),ndc=new THREE.Vector2();
canvas.addEventListener('pointerdown',e=>{dragId=e.pointerId;dragX=downX=e.clientX;dragY=downY=e.clientY;dragMoved=0;initAudio();});
canvas.addEventListener('pointermove',e=>{if(e.pointerId!==dragId)return;dragMoved=Math.max(dragMoved,Math.hypot(e.clientX-downX,e.clientY-downY));if(dragMoved<8)return;
 const dx=(e.clientX-dragX)/innerWidth,dy=(e.clientY-dragY)/innerHeight;dragX=e.clientX;dragY=e.clientY;
 if(camMode===0){const k=look.fov/70;look.ty=look.yaw=clamp(look.yaw+dx*3*k,-2.7,2.7);look.tp=look.pitch=clamp(look.pitch+dy*2*k,-1.2,1.3);}else{if(camMode!==4)setCam(4);orbit.yaw-=dx*4;orbit.pitch=clamp(orbit.pitch+dy*3,-0.3,1.4);}});
canvas.addEventListener('pointerup',e=>{if(e.pointerId===dragId&&dragMoved<8&&camMode===0&&running&&!paused)cockpitClick(e.clientX,e.clientY);dragId=null;});
function cockpitClick(x,y){ndc.set(x/innerWidth*2-1,-(y/innerHeight)*2+1);camera.updateMatrixWorld();ray.setFromCamera(ndc,camera);const hits=ray.intersectObjects(PANELS.map(p=>p.mesh),false);
 if(hits.length&&hits[0].uv){hits[0].object.userData.panel.click(hits[0].uv.x,hits[0].uv.y);PANELS.forEach(p=>p.render());updateQuick();}}
canvas.addEventListener('wheel',e=>{if(camMode===0){look.tf=clamp(look.tf*(e.deltaY>0?1.1:0.9),20,80);}else orbit.dist=clamp(orbit.dist*(e.deltaY>0?1.1:0.9),0.3,6);});
addEventListener('keydown',e=>{keys[e.code]=true;initAudio();const k=e.code;if(k==='KeyG')quick('gear');if(k==='KeyF')setFlaps(1);if(k==='KeyV')setFlaps(-1);if(k==='KeyB')quick('brk');if(k==='KeyR')quick('rev');if(k==='Space'){quick('splr');e.preventDefault();}
 if(k==='KeyP')toggleAP();if(k==='KeyC')setCam((camMode+1)%CAMS.length);if(k==='Escape')openMenu();});
addEventListener('keyup',e=>{keys[e.code]=false;});addEventListener('contextmenu',e=>e.preventDefault());

/* ================= FRAME ================= */
let uiT=0,randT=0,lightT=0;
function frame(dt){scenT+=dt;
 for(let i=timers.length-1;i>=0;i--)if(scenT>=timers[i].t){const f=timers[i].fn;timers.splice(i,1);f();}
 for(let i=watchers.length-1;i>=0;i--)if(watchers[i].cond()){const f=watchers[i].fn;watchers.splice(i,1);f();}
 if(cabinFire&&!P.crashed){if(!P.done)cabinFire.t+=dt;$('smoke').style.opacity=Math.min(0.72,cabinFire.t/420)*(camMode===0?1:0.35);const w=localToWorld(new V3(0,3,0));if(Math.random()<0.6)SMK.spawn(w.x,w.y,w.z,0,1,0,6,4,6,0.3,0.3,0.3,0.6);}
 if(unreliable>0){unreliable-=dt;if(unreliable<=0)hint('Geschwindigkeitsanzeige wieder zuverlässig',3);}
 ENG.forEach(e=>{if(e.fire||e.destroyed){const w=localToWorld(e.pos);const wnd=getWind(w);
  if(e.fire)for(let i=0;i<3;i++)FX.spawn(w.x,w.y,w.z,wnd.x+(Math.random()-.5)*4,wnd.y+(Math.random()-.5)*4,wnd.z+(Math.random()-.5)*4,0.6+Math.random()*0.5,3.5,3.5,1,0.45+Math.random()*0.3,0.1,0.9);
  SMK.spawn(w.x,w.y,w.z,wnd.x,wnd.y+1,wnd.z,6,3,7,0.12,0.12,0.12,e.fire?0.8:0.35);}});
 randT+=dt;if(randT>1&&P.airborne&&!P.crashed){randT=0;if(ADMIN.randFire&&!cabinFire&&Math.random()<1/7200)startCabinFire();
  if(ADMIN.randEng&&Math.random()<1/1500){const e=ENG[Math.floor(Math.random()*4)];if(Math.random()<0.25)explodeEngine(e);else{killEngine(e,'ENG FAIL',false);say('Engine failure');}}
  if(ADMIN.randStorm&&Math.random()<1/240){if(Math.random()<0.5){const f=new V3(0,0,-1).applyQuaternion(P.q);spawnTornado(P.pos.x+f.x*6000,P.pos.z+f.z*6000,(Math.random()-.5)*12,(Math.random()-.5)*12);hint('Tornado gesichtet!',4);}else{ADMIN.weather='storm';applyEnv();}}}
 for(let i=tornados.length-1;i>=0;i--){const t=tornados[i];t.life-=dt;t.vx+=(Math.random()-.5)*0.4*dt;t.vz+=(Math.random()-.5)*0.4*dt;t.x+=t.vx*dt;t.z+=t.vz*dt;t.g.position.set(t.x,Math.max(0,groundH(t.x,t.z)),t.z);t.f1.rotation.y+=dt*2.5;t.f2.rotation.y+=dt*1.6;
  for(let k=0;k<3;k++){const a=Math.random()*6.28,r=60+Math.random()*250;SMK.spawn(t.x+Math.cos(a)*r,t.g.position.y+Math.random()*30,t.z+Math.sin(a)*r,-Math.sin(a)*40,15+Math.random()*25,Math.cos(a)*40,4,25,15,0.35,0.3,0.25,0.6);}if(t.life<0){scene.remove(t.g);tornados.splice(i,1);}}
 if(tsunami){tsunami.x-=tsunami.spd*dt;if(tsunami.x<-3000)tsunami.scale=Math.max(0,tsunami.scale-dt*0.05);updateTsunamiGeo();tsunami.ft-=dt;if(tsunami.ft<0){tsunami.ft=0.3;updateFlood();}
  if(Math.random()<0.5){const z=P.pos.z+(Math.random()-.5)*3000;SMK.spawn(tsunami.x+30,Math.max(0,groundH(tsunami.x+40,z))+tsunami.H*tsunami.scale,z,-tsunami.spd*0.6,8,0,2.5,30,25,0.9,0.95,1,0.7);}
  if(tsunami.scale<=0){scene.remove(tsunami.mesh);scene.remove(tsunami.flood);tsunami=null;}}
 if(WX.storm){WX.lightT-=dt;if(WX.lightT<0){WX.lightT=3+Math.random()*9;flash(0.35);setTimeout(()=>boom(0.35,2),600+Math.random()*1500);}}
 if(flashV>0){$('flash').style.opacity=flashV;flashV=Math.max(0,flashV-dt*2.5);}else $('flash').style.opacity=0;hemi.intensity=baseHemi+flashV*2;
 // model
 model.position.copy(P.pos);model.quaternion.copy(P.q);
 const ga=(1-P.gearPos)*95*DEG;gearLegs.forEach(g=>{const r=g.rot;g.pv.quaternion.setFromAxisAngle(new V3(r[0],r[1],r[2]),ga*r[3]);g.pv.visible=P.gearPos>0.03;});
 surf.ail.forEach(a=>a.set(a.side*-P.ai*22));surf.elev.forEach(e=>e.set(-(P.el+P.trim*0.25)*25));surf.rud.set(P.rudDeg);
 surf.flaps.forEach(f=>f.set(P.flaps*32,P.flaps));const rs=clamp((Math.abs(P.ai)-0.3)*1.4,0,1);surf.spoilers.forEach(s=>s.set(-(P.spoiler*45+(Math.sign(P.ai)===s.side?rs*25:0))));
 ENG.forEach((e,i)=>{if(fans[i])fans[i].rotation.z-=dt*e.n1*0.6;});
 lightT+=dt;const pw=P.power;navL.red.visible=navL.green.visible=SYS.nav&&pw;navL.beacon.forEach(b=>b.visible=SYS.beacon&&pw&&(lightT%1)<0.15);
 navL.strobe.forEach(m=>m.visible=SYS.strobe&&pw&&((lightT%1.2)<0.06||((lightT%1.2)>0.14&&(lightT%1.2)<0.2)));navL.land.forEach(l=>l.visible=SYS.land&&pw&&P.gearPos>0.5);landLight.intensity=SYS.land&&pw?4:0;
 for(const pa of papis){const dx=P.pos.x-pa.pos.x,dz=P.pos.z-pa.pos.z,d=Math.hypot(dx,dz);const ang=Math.atan2(P.pos.y-pa.pos.y,d)/DEG;const wh=[2.5,2.83,3.17,3.5].filter(t=>ang>t).length;pa.lights.forEach((m,i)=>m.material.color.setHex(i<wh?0xffffff:0xff2020));}
 if(rain.visible){const cp=camera.position;const vx=-P.vel.x*0.02,vz=-P.vel.z*0.02;for(let i=0;i<RAIN_N;i++){rainOff[i*3+1]-=dt*0.8;if(rainOff[i*3+1]<0)rainOff[i*3+1]+=1;
  const x=cp.x+(rainOff[i*3]-0.5)*120,y=cp.y+(rainOff[i*3+1]-0.5)*80,z=cp.z+(rainOff[i*3+2]-0.5)*120;rainPos[i*6]=x;rainPos[i*6+1]=y;rainPos[i*6+2]=z;rainPos[i*6+3]=x+vx;rainPos[i*6+4]=y-1.8;rainPos[i*6+5]=z+vz;}rainGeo.attributes.position.needsUpdate=true;}
 waterMat.uniforms.time.value+=dt;FX.update(dt);SMK.update(dt);callouts();
 // cockpit panels
 if(camMode===0){updateCockpit3D();}
 if(camMode===0)for(const p of PANELS){p.t-=dt;if(p.t<=0){p.t=p.rate;p.render();}}
 warnTimer-=dt;uiT-=dt;if(uiT<0){uiT=0.15;const W=getWarnings();const key=W.map(w=>w[1]).join('|');$('warn').innerHTML=W.map(w=>`<span class="w ${w[0]}">${w[1]}</span>`).join('');
  if(key!==lastWarnKey){if(W.some(w=>w[0]==='r'&&!lastWarnKey.includes(w[1])))silenced=false;lastWarnKey=key;}
  const red=W.filter(w=>w[0]==='r');if(red.length&&!silenced&&warnTimer<0&&!P.crashed){warnTimer=1.4;beep(red.some(w=>w[1].includes('FIRE'))?650:1000,0.25);
   if(red.some(w=>w[1]==='STALL'))say('Stall');else if(red.some(w=>w[1]==='PULL UP'))say('Pull up');else if(red.some(w=>w[1]==='TOO LOW GEAR'))say('Too low, gear');else if(red.some(w=>w[1]==='WINDSHEAR'))say('Windshear');}
  updateQuick();$('thrFill').style.height=(P.throttle*100)+'%';$('thrLbl').textContent=P.rev?'REV':P.throttle>=0.99?'TOGA':P.throttle>=0.87?'FLX':P.throttle>=0.74?'CL':P.throttle<0.02?'IDLE':Math.round(P.throttle*100)+'%';
  if(camMode!==0)drawMini();
  if(scen&&scen.id==='cold'&&P.onGround&&!P.airborne){const ns=nextStep();if(ns[1]){$('info').textContent='Nächster Schritt: '+ns[1];$('info').style.opacity=1;hintT=0.5;}}}
 if(camMode!==0)drawHUD();
 if(hintT>0){hintT-=dt;if(hintT<=0)$('info').style.opacity=0;}updateAudio();}

/* ================= LOOP / INIT ================= */
let last=performance.now();
function loop(now){requestAnimationFrame(loop);const dt=Math.min(0.05,(now-last)/1000);last=now;
 if(running&&!paused){for(let i=0;i<4;i++)step(dt/4);frame(dt);updateCamera(dt);}
 else{if(!running){const t=now*0.00004;camera.position.set(P.pos.x+Math.sin(t)*95,P.pos.y+12,P.pos.z+Math.cos(t)*95);camera.lookAt(P.pos);sky.position.copy(camera.position);
  model.position.copy(P.pos);model.quaternion.copy(P.q);sun.position.copy(P.pos).addScaledVector(skyU.sunDir.value,400);sun.target.position.copy(P.pos);}waterMat.uniforms.time.value+=dt;}
 renderer.render(scene,camera);}
function init(){buildTerrain();buildWater();AIRPORTS.forEach(buildAirport);buildCity();buildTrees();buildClouds();buildFX();buildMapImg();buildModel();
 resetState();applyEnv();runwayStart(0,false);model.position.copy(P.pos);model.quaternion.copy(P.q);setCam(0);$('look').classList.add('hidden');
 $('load').classList.add('hidden');$('menu').classList.remove('hidden');requestAnimationFrame(loop);}
setTimeout(()=>{try{init();}catch(e){$('load').textContent='Fehler: '+e.message;console.error(e);}},60);
</script>
</body></html>
